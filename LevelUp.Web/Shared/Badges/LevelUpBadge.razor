<span class="@BadgeClasses">
    @ChildContent
</span>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public LevelUpBadgeVariant Variant { get; set; } =
        LevelUpBadgeVariant.Neutral;

    private string BadgeClasses =>
        $"levelup-badge levelup-badge--{Variant.ToString().ToLowerInvariant()}";
}

