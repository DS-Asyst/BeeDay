<div class="levelup-progress">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="levelup-progress__header">
            <span>@Label</span>
            <span>@FormattedValue</span>
        </div>
    }

    <div class="levelup-progress__track"
         role="progressbar"
         aria-label="@Label"
         aria-valuemin="0"
         aria-valuemax="@Maximum"
         aria-valuenow="@SafeValue">
        <div class="levelup-progress__value"
             style="width: @Percentage%">
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public decimal Value { get; set; }

    [Parameter]
    public decimal Maximum { get; set; } = 100;

    private decimal SafeMaximum => Maximum > 0 ? Maximum : 1;

    private decimal SafeValue =>
        Math.Clamp(Value, 0, SafeMaximum);

    private decimal Percentage =>
        Math.Round(SafeValue / SafeMaximum * 100, 2);

    private string FormattedValue =>
        $"{SafeValue:0.##} / {SafeMaximum:0.##}";
}
