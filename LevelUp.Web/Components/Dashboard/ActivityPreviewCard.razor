<article class="activity-card activity-card--@Variant">
    <button class="activity-card__action" type="button" aria-label="Complete @Title">
        @ActionSymbol
    </button>

    <div class="activity-card__body">
        <div class="activity-card__title-row">
            <h3>@Title</h3>
            @if (Featured)
            {
                <span class="activity-card__star" aria-label="Featured">★</span>
            }
        </div>

        <p>@Description</p>

        @if (!string.IsNullOrWhiteSpace(Meta))
        {
            <span class="activity-card__meta">@Meta</span>
        }
    </div>

    <button class="activity-card__menu" type="button" aria-label="More options">⋮</button>
</article>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter] public string Meta { get; set; } = string.Empty;
    [Parameter] public string Variant { get; set; } = "habit";
    [Parameter] public string ActionSymbol { get; set; } = "+";
    [Parameter] public bool Featured { get; set; }
}
