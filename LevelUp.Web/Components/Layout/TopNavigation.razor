<header class="top-navigation">
    <div class="top-navigation__inner">
        <NavLink class="top-navigation__brand" href="/" Match="NavLinkMatch.All">
            LEVELUP
        </NavLink>

        <nav class="top-navigation__links" aria-label="Primary navigation">
            <NavLink href="/character">Character</NavLink>
            <NavLink href="/journal">Journal</NavLink>
            <NavLink href="/inventory">Inventory</NavLink>
            <NavLink href="/settings">Settings</NavLink>
        </nav>

        <div class="top-navigation__gold" aria-label="Current gold balance">
            <span class="top-navigation__gold-icon" aria-hidden="true">●</span>
            <span>@Gold.ToString("N0") Gold</span>
        </div>
    </div>
</header>

@code {
    [Parameter]
    public decimal Gold { get; set; } = 12_540;
}
