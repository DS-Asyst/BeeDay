@inherits LayoutComponentBase

<div class="levelup-app">
    <header class="levelup-topbar">
        <div class="levelup-container levelup-topbar__content">
            <a class="levelup-brand" href="/">
                LEVELUP
            </a>

            <span class="levelup-foundation-label">
                Blazor Foundation
            </span>
        </div>
    </header>

    <main class="levelup-main">
        <div class="levelup-container">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
