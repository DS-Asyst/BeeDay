@page "/"
@inject LevelUpSession Session

<PageTitle>LevelUp</PageTitle>

<section class="foundation-page levelup-fade-in">
    <div class="foundation-card levelup-surface">
        <span class="foundation-card__eyebrow">
            Migration foundation
        </span>

        <h1>LevelUp Web</h1>

        <p>
            The Blazor application shell is ready to receive the LevelUp
            features incrementally.
        </p>

        <div class="foundation-status">
            <span class="foundation-status__indicator"></span>
            Application state initialized
        </div>
    </div>
</section>

@code {
    protected override Task OnInitializedAsync()
    {
        return Session.InitializeAsync();
    }
}
