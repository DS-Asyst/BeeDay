@using LevelUp.Web.ViewModels.Character

<section class="character-summary" aria-labelledby="character-summary-title">
    <div class="character-summary__profile">
        <div class="character-summary__avatar" aria-hidden="true">
            <span>TA</span>
        </div>

        <div class="character-summary__identity">
            <span class="character-summary__eyebrow">Character</span>
            <h1 id="character-summary-title" class="character-summary__name">@Character.Name</h1>
            <span class="character-summary__subtitle">Level @Character.Level adventurer</span>
        </div>
    </div>

    <div class="character-summary__progress">
        <div class="character-summary__progress-heading">
            <span>Experience</span>
            <strong>@Character.ExperienceLabel</strong>
        </div>

        <div class="character-summary__progress-track"
             role="progressbar"
             aria-label="Character experience"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-valuenow="@Character.ExperiencePercentage.ToString("0")">
            <div class="character-summary__progress-value"
                 style="width: @($"{Character.ExperiencePercentage:0.##}%")">
            </div>
        </div>

        <div class="character-summary__progress-footer">
            <span>Keep completing activities to reach the next level.</span>
            <span>@Character.ExperiencePercentage.ToString("0")%</span>
        </div>
    </div>

    <div class="character-summary__metrics" aria-label="Character metrics">
        <div class="character-summary__metric">
            <span class="character-summary__metric-label">Level</span>
            <strong>@Character.Level</strong>
        </div>

        <div class="character-summary__metric">
            <span class="character-summary__metric-label">Gold</span>
            <strong class="character-summary__gold">
                <span aria-hidden="true"></span>
                @Character.GoldLabel
            </strong>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public CharacterSummaryViewModel Character { get; set; } = default!;
}
