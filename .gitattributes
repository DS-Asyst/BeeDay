# Default text handling
* text=auto

# Source and configuration files
*.cs text eol=lf
*.razor text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.editorconfig text eol=lf

# Visual Studio solution files
*.sln text eol=crlf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.dll binary
*.exe binary
