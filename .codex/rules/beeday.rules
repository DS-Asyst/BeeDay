# BeeDay Codex escalation rules.
#
# Rules are technical gates. They do not grant authority. AGENTS.md defines
# whether the current task is authorized to perform the requested operation.
#
# `prompt` is intentional instead of `forbidden`: a specifically authorized
# Class D action must remain technically possible, but it must cross an approval
# boundary and be evaluated in the context of the current task.

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Git history mutation requires explicit Class C authority or active Sprint/Epic autonomy under AGENTS.md.",
    match = [
        "git commit -m test",
        "git commit --amend",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Remote Git mutation requires explicit Class C authority or active Sprint/Epic autonomy; force pushes remain Class D.",
    match = [
        "git push",
        "git push origin sprint/28.1-example",
        "git push --force origin sprint/28.1-example",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "prompt",
    justification = "Pull Request creation requires explicit Class C authority or active Sprint/Epic autonomy under AGENTS.md.",
    match = [
        "gh pr create --base hmg --title test",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "prompt",
    justification = "Pull Request merge is Class D and always requires explicit authorization for the specific merge.",
    match = [
        "gh pr merge 123",
        "gh pr merge 123 --squash",
    ],
)

prefix_rule(
    pattern = ["git", "merge"],
    decision = "prompt",
    justification = "Merge is Class D and requires explicit authorization for the specific operation.",
    match = [
        "git merge hmg",
        "git merge --no-ff sprint/28.1-example",
    ],
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "prompt",
    justification = "Rebase is Class D and requires explicit authorization for the specific operation.",
    match = [
        "git rebase hmg",
        "git rebase --onto main hmg sprint/28.1-example",
    ],
)

prefix_rule(
    pattern = ["git", "cherry-pick"],
    decision = "prompt",
    justification = "Cherry-pick is Class D and requires explicit authorization for the specific operation.",
    match = [
        "git cherry-pick abc1234",
    ],
)

prefix_rule(
    pattern = ["git", "reset"],
    decision = "prompt",
    justification = "Reset can discard or rewrite work and requires explicit Class D authorization.",
    match = [
        "git reset --hard HEAD~1",
        "git reset HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Git clean can delete untracked work and requires explicit Class D authorization.",
    match = [
        "git clean -fd",
        "git clean -fdx",
    ],
)

prefix_rule(
    pattern = ["git", "branch", ["-d", "-D"]],
    decision = "prompt",
    justification = "Local branch deletion requires explicit cleanup authorization; forced deletion is Class D.",
    match = [
        "git branch -d sprint/28.1-example",
        "git branch -D sprint/28.1-example",
    ],
    not_match = [
        "git branch --show-current",
        "git branch --list",
    ],
)

prefix_rule(
    pattern = ["git", "tag"],
    decision = "prompt",
    justification = "Tag creation/deletion mutates repository history metadata and requires explicit authorization.",
    match = [
        "git tag v1.0.0",
        "git tag -d v1.0.0",
    ],
)
