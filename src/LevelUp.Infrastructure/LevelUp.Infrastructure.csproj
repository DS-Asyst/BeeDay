<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../LevelUp.Application/LevelUp.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Infrastructure.Tests construct internal JSON adapters directly (e.g. JsonLevelUpRepository,
         JsonLevelUpDocumentStore) to validate the real adapter, per docs/testing/01-testing-strategy.md.
         Concrete adapter types stay internal to the rest of the solution — only the test assembly is a
         declared friend. -->
    <InternalsVisibleTo Include="LevelUp.Infrastructure.Tests" />
  </ItemGroup>
</Project>
