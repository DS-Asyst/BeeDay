<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../LevelUp.Application/LevelUp.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Infrastructure.Tests construct internal SQL Server adapters directly (e.g. Ef*Repository,
         EfDashboardReadService, EfWalletReadService) to validate the real adapter, per
         docs/testing/01-testing-strategy.md. Concrete adapter types stay internal to the rest of the
         solution — only these test assemblies are declared friends. Web.Tests/E2E.Tests need
         LevelUpDbContext specifically (internal) to apply/tear down each test's disposable LocalDB
         database from LevelUpWebApplicationFactory/E2EWebApplicationFactory. -->
    <InternalsVisibleTo Include="LevelUp.Infrastructure.Tests" />
    <InternalsVisibleTo Include="LevelUp.Web.Tests" />
    <InternalsVisibleTo Include="LevelUp.E2E.Tests" />
  </ItemGroup>
</Project>
