{
  "AllowedHosts": "",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Components.Server.Circuits": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "LevelUp.Infrastructure.Persistence.Json.JsonBackupService": "Information"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "LevelUp": {
    "Hosting": {
      "DataProtectionKeysDirectory": "C:\\Apps\\LevelUp-Data\\DataProtection-Keys",
      "ForwardedHeaders": {
        "Enabled": true,
        "ForwardLimit": 1,
        "KnownProxies": [
          "127.0.0.1",
          "::1"
        ],
        "KnownNetworks": []
      }
    },
    "Storage": {
      "Directory": "C:\\Apps\\LevelUp-Data\\Data",
      "FileName": "LevelUpBD.json",
      "BackupDirectory": "Backups",
      "BackupRetention": 20,
      "CreateBackupBeforeSave": true,
      "RecoverFromBackup": true,
      "WriteIndented": false
    },
    "IdentityEmail": {
      "PublicBaseUrl": "",
      "ConfirmationPath": "/account/confirm-email",
      "PasswordResetPath": "/account/reset-password"
    },
    "Email": {
      "Resend": {
        "Enabled": true,
        "ApiKey": "",
        "FromName": "LevelUp",
        "FromAddress": ""
      },
      "Development": {
        "Enabled": false,
        "Directory": "C:\\Apps\\LevelUp-Data\\Emails"
      }
    }
  }
}
