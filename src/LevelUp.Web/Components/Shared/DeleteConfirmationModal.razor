@if (IsOpen)
{
    <div class="delete-confirmation-backdrop"
         role="presentation"
         tabindex="-1"
         @onclick="Cancel"
         @onkeydown="HandleKeyDown"
         @onkeydown:stopPropagation="true">

        <section class="delete-confirmation"
                 role="alertdialog"
                 aria-modal="true"
                 aria-labelledby="delete-confirmation-title"
                 aria-describedby="delete-confirmation-description"
                 @onclick:stopPropagation>

            <div class="delete-confirmation__top-border" aria-hidden="true"></div>

            <div class="delete-confirmation__content">
                <div class="delete-confirmation__icon" aria-hidden="true">!</div>

                <h2 id="delete-confirmation-title">Delete @ItemType</h2>

                <p id="delete-confirmation-description"
                   class="delete-confirmation__question">
                    Are you sure you want to delete this @ItemType.ToLowerInvariant()?
                </p>

                @if (!string.IsNullOrWhiteSpace(ItemTitle))
                {
                    <p class="delete-confirmation__item-title">“@ItemTitle”</p>
                }

                <div class="delete-confirmation__warning">
                    <span class="delete-confirmation__warning-icon" aria-hidden="true">!</span>
                    <div>
                        <strong>This action cannot be undone.</strong>
                        <p>All @ItemType.ToLowerInvariant() information will be permanently removed.</p>
                    </div>
                </div>

                <button type="button"
                        class="delete-confirmation__delete-button"
                        @onclick="Confirm">
                    <span class="delete-confirmation__trash-icon" aria-hidden="true">⌫</span>
                    Delete @ItemType
                </button>

                <button type="button"
                        class="delete-confirmation__cancel-button"
                        @onclick="Cancel">
                    Cancel
                </button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter, EditorRequired]
    public string ItemType { get; set; } = string.Empty;

    [Parameter]
    public string? ItemTitle { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Task Confirm() => OnConfirm.InvokeAsync();

    private Task Cancel() => OnCancel.InvokeAsync();

    private Task HandleKeyDown(KeyboardEventArgs args)
        => args.Key == "Escape" ? Cancel() : Task.CompletedTask;
}
