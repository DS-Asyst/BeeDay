@using LevelUp.Web.Models

<div class="editor-modal-backdrop" @onclick="Cancel" @onkeydown="HandleKeyDown" tabindex="-1">
    <section class="editor-modal" role="dialog" aria-modal="true" aria-labelledby="activity-editor-title" @onclick:stopPropagation>
        <EditForm Model="Model" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <header class="editor-modal__header">
                <h2 id="activity-editor-title">@(IsEditing ? $"Edit {DisplayName}" : $"Create {DisplayName}")</h2>
                <div class="editor-modal__actions">
                    <button type="button" class="editor-modal__cancel" @onclick="Cancel">CANCEL</button>
                    <button type="submit" class="editor-modal__save">@(IsEditing ? "SAVE" : "CREATE")</button>
                </div>
            </header>
            <div class="editor-modal__hero">
                <label><span class="editor-modal__label-line"><strong>Title*</strong></span>
                    <InputText @bind-Value="Model.Title" placeholder="Add a title" autofocus maxlength="100" />
                </label>
                <ValidationMessage For="@(() => Model.Title)" />
                <label><span class="editor-modal__label-line"><strong>Notes</strong></span>
                    <InputTextArea @bind-Value="Model.Description" placeholder="Add notes" maxlength="500" />
                </label>
                <ValidationMessage For="@(() => Model.Description)" />
                <small class="editor-modal__counter">@Model.Description.Length / 500</small>
            </div>
            <div class="editor-modal__body">
                <div class="editor-modal__type-summary"><span class="editor-modal__type-icon" aria-hidden="true">@TypeIcon</span>
                    <div><strong>@DisplayName</strong><p>@TypeDescription</p></div>
                </div>
                @if (ActivityType == "task")
                {
                    <label class="editor-modal__field"><span>Repeat</span>
                        <InputSelect @bind-Value="Model.Repeat">
                            @foreach (var option in Enum.GetValues<TaskRepeat>()) { <option value="@option">@FormatEnum(option.ToString())</option> }
                        </InputSelect>
                    </label>
                }
                else if (ActivityType == "todo")
                {
                    <label class="editor-modal__field"><span>Due date</span><InputDate @bind-Value="Model.DueDate" /></label>
                }
                else
                {
                    <label class="editor-modal__field"><span>Project status</span>
                        <InputSelect @bind-Value="Model.ProjectStatus">
                            @foreach (var option in Enum.GetValues<ProjectStatus>()) { <option value="@option">@FormatEnum(option.ToString())</option> }
                        </InputSelect>
                    </label>
                }
            </div>
            @if (IsEditing)
            {
                <footer class="editor-modal__footer">
                    <button type="button" class="editor-modal__delete" @onclick="RequestDelete">DELETE</button>
                </footer>
            }
        </EditForm>
    </section>
</div>

<DeleteConfirmationModal IsOpen="showDeleteConfirmation"
                         ItemType="@DisplayName"
                         ItemTitle="@Model.Title"
                         OnConfirm="ConfirmDelete"
                         OnCancel="CloseDeleteConfirmation" />

@code {
    [Parameter, EditorRequired] public ActivityEditorModel Model { get; set; } = new();
    [Parameter, EditorRequired] public string ActivityType { get; set; } = "task";
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public EventCallback<ActivityEditorModel> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    private bool showDeleteConfirmation;
    private string DisplayName => ActivityType switch { "todo" => "To-Do", "project" => "Project", _ => "Task" };
    private string TypeIcon => ActivityType switch { "todo" => "✓", "project" => "▤", _ => "▦" };
    private string TypeDescription => ActivityType switch { "todo" => "A one-time action that does not depend on a project.", "project" => "A larger goal used to organize work.", _ => "A recurring or repeatable activity." };
    private Task Save() => OnSave.InvokeAsync(Model);
    private Task Cancel()
    {
        showDeleteConfirmation = false;
        return OnCancel.InvokeAsync();
    }

    private void RequestDelete() => showDeleteConfirmation = true;

    private void CloseDeleteConfirmation() => showDeleteConfirmation = false;

    private async Task ConfirmDelete()
    {
        showDeleteConfirmation = false;
        await OnDelete.InvokeAsync();
    }

    private Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape")
        {
            return Task.CompletedTask;
        }

        if (showDeleteConfirmation)
        {
            showDeleteConfirmation = false;
            return Task.CompletedTask;
        }

        return Cancel();
    }
    private static string FormatEnum(string value) => System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");
}
