@page "/"
@rendermode InteractiveServer
@inject LevelUpWebService Store
@inject NavigationManager Navigation

<PageTitle>Dashboard | LevelUp</PageTitle>

@if (data is null)
{
    <div class="loading-state">Loading LevelUp...</div>
}
else if (data.Profile is not null)
{
    <section class="dashboard-page levelup-fade-in">
        <ProfileSummaryCard Name="@data.Profile.Name" Nickname="@data.Profile.Nickname" Class="@data.Profile.Class" ActiveItems="@ActiveItems" CompletedItems="@CompletedItems" />
        <div class="dashboard-page__content">
            <FilterBar Value="@search" ValueChanged="@(value => search = value)" OnCreate="OpenCreate" />
            <div class="dashboard-grid">
                <DashboardColumn Title="Habits" EmptyLabel="habits" Count="@FilteredHabits.Count()">
                    @foreach (var item in FilteredHabits)
                    {
                        <HabitCard Title="@item.Title" Description="@item.Description" Direction="@item.Direction"
                                   PositiveCount="@item.PositiveCount" NegativeCount="@item.NegativeCount" Featured="@item.Featured"
                                   OnPositive="@(() => RegisterPositiveAsync(item.Id))" OnNegative="@(() => RegisterNegativeAsync(item.Id))"
                                   OnEdit="@(() => OpenHabitEditor(item))" OnDelete="@(() => RequestHabitDelete(item))" />
                    }
                </DashboardColumn>
                <DashboardColumn Title="Tasks" EmptyLabel="tasks" Count="@FilteredTasks.Count()">
                    @foreach (var item in FilteredTasks)
                    {
                        <ActivityPreviewCard Title="@item.Title" Description="@item.Description" Meta="@FormatRepeat(item.Repeat)" Variant="task"
                                             Completed="@item.Completed" Featured="@item.Featured" OnToggle="@(() => ToggleTaskAsync(item.Id))"
                                             OnEdit="@(() => OpenTaskEditor(item))" OnDelete="@(() => RequestTaskDelete(item))" />
                    }
                </DashboardColumn>
                <DashboardColumn Title="To-Dos" EmptyLabel="to-dos" Count="@FilteredTodos.Count()">
                    @foreach (var item in FilteredTodos)
                    {
                        <ActivityPreviewCard Title="@item.Title" Description="@item.Description" Meta="@FormatDueDate(item.DueDate)" Variant="todo"
                                             Completed="@item.Completed" Featured="@item.Featured" OnToggle="@(() => ToggleTodoAsync(item.Id))"
                                             OnEdit="@(() => OpenTodoEditor(item))" OnDelete="@(() => RequestTodoDelete(item))" />
                    }
                </DashboardColumn>
                <DashboardColumn Title="Projects" EmptyLabel="projects" Count="@FilteredProjects.Count()">
                    @foreach (var item in FilteredProjects)
                    {
                        <ActivityPreviewCard Title="@item.Title" Description="@item.Description" Meta="@FormatProjectStatus(item.Status)" Variant="project"
                                             Completed="@item.Completed" Featured="@item.Featured" OnToggle="@(() => ToggleProjectAsync(item.Id))"
                                             OnEdit="@(() => OpenProjectEditor(item))" OnDelete="@(() => RequestProjectDelete(item))" />
                    }
                </DashboardColumn>
            </div>
        </div>
    </section>

    @if (showHabitEditor)
    {
        <HabitEditorModal Model="habitForm" IsEditing="@(editingId is not null)" OnSave="SaveHabitAsync" OnCancel="CloseEditors" OnDelete="DeleteHabitAsync" />
    }
    @if (showActivityEditor)
    {
        <ActivityEditorModal Model="activityForm" ActivityType="@activityType" IsEditing="@(editingId is not null)" OnSave="SaveActivityAsync" OnCancel="CloseEditors" OnDelete="DeleteActivityAsync" />
    }
    <DeleteConfirmationModal IsOpen="showCardDeleteConfirmation"
                             ItemType="@DeleteItemDisplayName"
                             ItemTitle="@pendingDeleteTitle"
                             OnConfirm="ConfirmCardDeleteAsync"
                             OnCancel="CancelCardDelete" />
}

@code {
    private LevelUpData? data;
    private bool showHabitEditor;
    private bool showActivityEditor;
    private Guid? editingId;
    private HabitEditorModel habitForm = new();
    private ActivityEditorModel activityForm = new();
    private string activityType = "task";
    private string search = string.Empty;
    private bool showCardDeleteConfirmation;
    private Guid? pendingDeleteId;
    private string pendingDeleteType = string.Empty;
    private string pendingDeleteTitle = string.Empty;

    private string DeleteItemDisplayName => pendingDeleteType switch
    {
        "habit" => "Habit",
        "todo" => "To-Do",
        "project" => "Project",
        _ => "Task"
    };

    private int CompletedItems => data!.Tasks.Count(x => x.Completed) + data.Todos.Count(x => x.Completed) + data.Projects.Count(x => x.Completed);
    private int ActiveItems => data!.Habits.Count + data.Tasks.Count(x => !x.Completed) + data.Todos.Count(x => !x.Completed) + data.Projects.Count(x => !x.Completed);
    private IEnumerable<Habit> FilteredHabits => data!.Habits.Where(MatchesSearch);
    private IEnumerable<RecurringTask> FilteredTasks => data!.Tasks.Where(MatchesSearch);
    private IEnumerable<Todo> FilteredTodos => data!.Todos.Where(MatchesSearch);
    private IEnumerable<Project> FilteredProjects => data!.Projects.Where(MatchesSearch);

    protected override async Task OnInitializedAsync()
    {
        data = await Store.LoadAsync();
        if (data.Profile is null) Navigation.NavigateTo("/profile", replace: true);
    }

    private bool MatchesSearch(Activity item) => string.IsNullOrWhiteSpace(search) || item.Title.Contains(search, StringComparison.OrdinalIgnoreCase) || item.Description.Contains(search, StringComparison.OrdinalIgnoreCase);
    private async Task ReloadAsync() => data = await Store.LoadAsync();

    private void OpenCreate(string type)
    {
        editingId = null; activityType = type;
        if (type == "habit") { habitForm = new(); showHabitEditor = true; }
        else { activityForm = new(); showActivityEditor = true; }
    }
    private void OpenHabitEditor(Habit item) { editingId = item.Id; habitForm = new() { Title = item.Title, Description = item.Description, Direction = item.Direction, Difficulty = item.Difficulty, ResetCounter = item.ResetCounter }; showHabitEditor = true; }
    private void OpenTaskEditor(RecurringTask item) { editingId = item.Id; activityType = "task"; activityForm = new() { Title = item.Title, Description = item.Description, Repeat = item.Repeat }; showActivityEditor = true; }
    private void OpenTodoEditor(Todo item) { editingId = item.Id; activityType = "todo"; activityForm = new() { Title = item.Title, Description = item.Description, DueDate = item.DueDate?.ToDateTime(TimeOnly.MinValue) }; showActivityEditor = true; }
    private void OpenProjectEditor(Project item) { editingId = item.Id; activityType = "project"; activityForm = new() { Title = item.Title, Description = item.Description, ProjectStatus = item.Status }; showActivityEditor = true; }
    private void CloseEditors() { showHabitEditor = false; showActivityEditor = false; editingId = null; }

    private async Task SaveHabitAsync(HabitEditorModel model) { if (editingId is Guid id) await Store.UpdateHabitAsync(id, model); else await Store.AddHabitAsync(model); CloseEditors(); await ReloadAsync(); }
    private async Task SaveActivityAsync(ActivityEditorModel model)
    {
        if (activityType == "task") { if (editingId is Guid id) await Store.UpdateTaskAsync(id, model); else await Store.AddTaskAsync(model); }
        else if (activityType == "todo") { if (editingId is Guid id) await Store.UpdateTodoAsync(id, model); else await Store.AddTodoAsync(model); }
        else { if (editingId is Guid id) await Store.UpdateProjectAsync(id, model); else await Store.AddProjectAsync(model); }
        CloseEditors(); await ReloadAsync();
    }
    private async Task DeleteHabitAsync() { if (editingId is Guid id) await Store.DeleteHabitAsync(id); CloseEditors(); await ReloadAsync(); }
    private async Task DeleteActivityAsync() { if (editingId is not Guid id) return; if (activityType == "task") await Store.DeleteTaskAsync(id); else if (activityType == "todo") await Store.DeleteTodoAsync(id); else await Store.DeleteProjectAsync(id); CloseEditors(); await ReloadAsync(); }

    private void RequestHabitDelete(Habit item) => RequestCardDelete(item.Id, "habit", item.Title);
    private void RequestTaskDelete(RecurringTask item) => RequestCardDelete(item.Id, "task", item.Title);
    private void RequestTodoDelete(Todo item) => RequestCardDelete(item.Id, "todo", item.Title);
    private void RequestProjectDelete(Project item) => RequestCardDelete(item.Id, "project", item.Title);

    private void RequestCardDelete(Guid id, string type, string title)
    {
        pendingDeleteId = id;
        pendingDeleteType = type;
        pendingDeleteTitle = title;
        showCardDeleteConfirmation = true;
    }

    private void CancelCardDelete()
    {
        showCardDeleteConfirmation = false;
        pendingDeleteId = null;
        pendingDeleteType = string.Empty;
        pendingDeleteTitle = string.Empty;
    }

    private async Task ConfirmCardDeleteAsync()
    {
        if (pendingDeleteId is not Guid id)
        {
            CancelCardDelete();
            return;
        }

        if (pendingDeleteType == "habit") await Store.DeleteHabitAsync(id);
        else if (pendingDeleteType == "task") await Store.DeleteTaskAsync(id);
        else if (pendingDeleteType == "todo") await Store.DeleteTodoAsync(id);
        else if (pendingDeleteType == "project") await Store.DeleteProjectAsync(id);

        CancelCardDelete();
        await ReloadAsync();
    }
    private async Task RegisterPositiveAsync(Guid id) { await Store.RegisterHabitPositiveAsync(id); await ReloadAsync(); }
    private async Task RegisterNegativeAsync(Guid id) { await Store.RegisterHabitNegativeAsync(id); await ReloadAsync(); }
    private async Task ToggleTaskAsync(Guid id) { await Store.ToggleTaskAsync(id); await ReloadAsync(); }
    private async Task ToggleTodoAsync(Guid id) { await Store.ToggleTodoAsync(id); await ReloadAsync(); }
    private async Task ToggleProjectAsync(Guid id) { await Store.ToggleProjectAsync(id); await ReloadAsync(); }
    private static string FormatRepeat(TaskRepeat repeat) => repeat == TaskRepeat.None ? "No repeat" : repeat.ToString();
    private static string FormatDueDate(DateOnly? date) => date?.ToString("MMM dd, yyyy") ?? "No due date";
    private static string FormatProjectStatus(ProjectStatus status) => status switch { ProjectStatus.InProgress => "In progress", ProjectStatus.OnHold => "On hold", _ => status.ToString() };
}
