@using System.Linq.Expressions

<label class="@FieldCssClass" for="@Id">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="@LabelCssClass">
            @Label
            @if (Required)
            {
                <span aria-hidden="true">*</span>
            }
        </span>
    }
    <InputTextArea id="@Id"
                   class="@InputCssClass"
                   Value="@Value"
                   ValueChanged="ValueChanged"
                   ValueExpression="ValueExpression"
                   placeholder="@Placeholder"
                   maxlength="@MaxLength"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   @attributes="AdditionalAttributes" />
</label>
@if (ShowValidationMessage)
{
    <LevelUpValidationMessage For="ValueExpression" />
}
@if (ShowCounter && MaxLength is > 0)
{
    <small class="@CounterCssClass">@(Value?.Length ?? 0) / @MaxLength</small>
}
