@if (Attribute is not null)
{
    <span class="activity-attribute-badge activity-attribute-badge--@AttributeCssName" data-attribute="@Attribute" title="@Tooltip" aria-label="@Tooltip">
        <ActivityAttributeIcon Attribute="@Attribute" Size="PixelIconSize.Small" />
        <span>@Attribute</span>
    </span>
}
