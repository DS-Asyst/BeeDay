<button type="@Type"
        class="@CssClasses"
        disabled="@IsDisabled"
        aria-busy="@IsLoading.ToString().ToLowerInvariant()"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @if (IsLoading)
    {
        <span class="levelup-button__loader" aria-hidden="true"></span>
    }
    else if (Icon is not null)
    {
        <LevelUpIcon Name="@Icon.Value" Size="@IconSize" />
    }
    <span class="levelup-button__label">@ChildContent</span>
</button>
