@if (IsVisible)
{
    <div class="levelup-loading-overlay" role="status" aria-live="polite" aria-label="@Label">
        <PixelIcon Name="PixelIconName.Loading" Size="PixelIconSize.Small" Color="PixelIconColor.Primary" Class="levelup-loading-spinner" />
        <span class="levelup-loading-label">@Label</span>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Label { get; set; } = "Saving changes...";
}
