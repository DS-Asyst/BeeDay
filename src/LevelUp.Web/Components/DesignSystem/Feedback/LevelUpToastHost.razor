@implements IDisposable
@inject ToastService ToastService

<div class="levelup-toast-region"
     aria-live="polite"
     aria-label="Notifications">
    @foreach (var toast in ToastService.Messages)
    {
        <article class="levelup-toast levelup-toast--@VariantClass(toast.Variant)"
                 role="@RoleFor(toast.Variant)">
            <span class="levelup-toast__icon" aria-hidden="true">@IconFor(toast.Variant)</span>
            <div class="levelup-toast__content">
                <strong>@toast.Title</strong>
                <p>@toast.Message</p>
            </div>
            <button class="levelup-toast__close"
                    type="button"
                    aria-label="Dismiss notification"
                    @onclick="() => ToastService.Remove(toast.Id)">×</button>
        </article>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.Changed += HandleChanged;
    }

    public void Dispose()
    {
        ToastService.Changed -= HandleChanged;
    }

    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);

    private static string VariantClass(ToastVariant variant) => variant switch
    {
        ToastVariant.Success => "success",
        ToastVariant.Error => "error",
        _ => "info"
    };

    private static string IconFor(ToastVariant variant) => variant switch
    {
        ToastVariant.Success => "✓",
        ToastVariant.Error => "!",
        _ => "i"
    };

    private static string RoleFor(ToastVariant variant) =>
        variant == ToastVariant.Error ? "alert" : "status";
}
