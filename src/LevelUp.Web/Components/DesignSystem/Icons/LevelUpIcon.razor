<svg class="@CssClasses"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     xmlns="http://www.w3.org/2000/svg"
     aria-hidden="@(Decorative ? "true" : null)"
     role="@(!Decorative ? "img" : null)"
     focusable="false">
    @if (!Decorative && !string.IsNullOrWhiteSpace(Label))
    {
        <title>@Label</title>
    }
    <image href="@IconPath" width="24" height="24" preserveAspectRatio="xMidYMid meet" />
</svg>
