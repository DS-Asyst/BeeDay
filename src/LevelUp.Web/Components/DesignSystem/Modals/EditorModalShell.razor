<div class="editor-modal-backdrop" @onclick="Cancel" @onkeydown="HandleKeyDown" tabindex="-1">
    <section class="editor-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@TitleId"
             aria-busy="@IsBusy.ToString().ToLowerInvariant()"
             @onclick:stopPropagation>
        <EditForm Model="Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            <header class="editor-modal__header">
                <h2 id="@TitleId">@Title</h2>
                <LevelUpButton Type="submit"
                               Variant="LevelUpButtonVariant.Primary"
                               Icon="PixelIconName.Save"
                               Disabled="IsBusy"
                               IsLoading="IsBusy"
                               Class="editor-modal__submit-action editor-modal__header-save">@SubmitLabel</LevelUpButton>
            </header>

            <div class="editor-modal__content">
                @HeroContent
                @BodyContent
            </div>

            <footer class="editor-modal__footer">
                <div class="editor-modal__footer-danger">
                    @if (ShowDelete)
                    {
                        <LevelUpButton Variant="LevelUpButtonVariant.Danger"
                                       Icon="PixelIconName.Delete"
                                       Disabled="IsBusy"
                                       Compact="true"
                                       OnClick="OnDelete">DELETE</LevelUpButton>
                    }
                </div>

                <div class="editor-modal__footer-actions">
                    <LevelUpButton Variant="LevelUpButtonVariant.Back"
                                   Icon="PixelIconName.Cancel"
                                   Disabled="IsBusy"
                                   Class="editor-modal__cancel-action"
                                   OnClick="Cancel">CANCEL</LevelUpButton>
                </div>
            </footer>
        </EditForm>
    </section>
</div>
