<header class="@CssClass" @attributes="AdditionalAttributes">
    <div>
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="levelup-section-header__eyebrow">@Eyebrow</span>
        }
        <h2>@Title</h2>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p>@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="levelup-section-header__actions">@Actions</div>
    }
</header>
