<article class="activity-card activity-card--@Variant @(Completed ? "activity-card--completed" : string.Empty) @(showMenu ? "activity-card--menu-open" : string.Empty)">
    <div class="activity-card__rail">
        <button class="activity-card__checkbox"
                type="button"
                aria-label="@(Completed ? $"Mark {Title} as incomplete" : $"Complete {Title}")"
                @onclick="OnToggle">
            <span aria-hidden="true">✓</span>
        </button>
    </div>

    <div class="activity-card__body">
        <div class="activity-card__title-row">
            @if (Featured)
            {
                <span class="activity-card__star">★</span>
            }
            <h3>@Title</h3>
        </div>

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p>@Description</p>
        }

        @if (!string.IsNullOrWhiteSpace(Meta))
        {
            <span class="activity-card__meta">@Meta</span>
        }
    </div>

    <div class="card-action-menu activity-card__actions">
        <button class="activity-card__menu"
                type="button"
                title="@Title options"
                aria-label="Options for @Title"
                aria-expanded="@showMenu"
                @onclick="ToggleMenu"
                @onclick:stopPropagation>
            ⋮
        </button>

        @if (showMenu)
        {
            <button type="button"
                    class="card-action-menu__dismiss"
                    aria-label="Close options"
                    @onclick="CloseMenu"></button>

            <div class="card-action-menu__panel" role="menu">
                <button type="button"
                        class="card-action-menu__item"
                        role="menuitem"
                        @onclick="Edit">
                    <span aria-hidden="true">✎</span>
                    <span>EDIT</span>
                </button>

                <button type="button"
                        class="card-action-menu__item card-action-menu__item--delete"
                        role="menuitem"
                        @onclick="Delete">
                    <span aria-hidden="true">⌫</span>
                    <span>DELETE</span>
                </button>
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter] public string Meta { get; set; } = string.Empty;
    [Parameter] public string Variant { get; set; } = "task";
    [Parameter] public bool Featured { get; set; }
    [Parameter] public bool Completed { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private bool showMenu;

    private void ToggleMenu() => showMenu = !showMenu;
    private void CloseMenu() => showMenu = false;

    private async Task Edit()
    {
        showMenu = false;
        await OnEdit.InvokeAsync();
    }

    private async Task Delete()
    {
        showMenu = false;
        await OnDelete.InvokeAsync();
    }
}
