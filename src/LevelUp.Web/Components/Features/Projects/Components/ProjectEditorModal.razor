<EditorModalShell Model="Model"
                  Title="@(IsEditing ? "Edit Project" : "Create Project")"
                  TitleId="project-editor-title"
                  SubmitLabel="@(IsEditing ? "SAVE" : "CREATE")"
                  ShowDelete="IsEditing"
                  OnSubmit="Save"
                  OnCancel="Cancel"
                  OnDelete="RequestDelete">
    <HeroContent>
        <div class="editor-modal__hero">
            <LevelUpInput Id="project-title"
                          Label="Title"
                          Required="true"
                          @bind-Value="Model.Title"
                          Placeholder="Add a title"
                          MaxLength="100"
                          FieldCssClass="editor-modal__hero-field"
                          LabelCssClass="editor-modal__label-line"
                          autofocus />
            <LevelUpTextArea Id="project-notes"
                             Label="Notes"
                             @bind-Value="Model.Description"
                             Placeholder="Add notes"
                             MaxLength="500"
                             ShowCounter="true"
                             FieldCssClass="editor-modal__hero-field"
                             LabelCssClass="editor-modal__label-line"
                             CounterCssClass="editor-modal__counter" />
        </div>
    </HeroContent>
    <BodyContent>
        <div class="editor-modal__body">
            <div class="editor-modal__type-summary"><span class="editor-modal__type-icon" aria-hidden="true">▤</span><div><strong>Project</strong><p>A larger goal used to organize work.</p></div></div>
            <LevelUpInput Id="project-color"
                          Label="Color"
                          Required="true"
                          @bind-Value="Model.Color"
                          Placeholder="#7A4FCB"
                          MaxLength="7"
                          FieldCssClass="editor-modal__field" />
            <LevelUpDateInput TValue="DateTime?"
                              Id="project-expected-date"
                              Label="Expected date"
                              @bind-Value="Model.ExpectedDate"
                              FieldCssClass="editor-modal__field" />
        </div>
    </BodyContent>
</EditorModalShell>

<LevelUpConfirmDialog IsOpen="showDeleteConfirmation"
                      Title="Delete Project"
                      Message="Are you sure you want to delete this project?"
                      ItemTitle="@Model.Title"
                      Warning="This action cannot be undone."
                      WarningDetails="All information will be permanently removed."
                      ConfirmLabel="Delete Project"
                      OnConfirm="ConfirmDelete"
                      OnCancel="CloseDeleteConfirmation" />
