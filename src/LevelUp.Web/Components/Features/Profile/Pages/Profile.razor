@page "/profile"
@rendermode InteractiveServer
@inject LevelUp.Web.Components.Features.Profile.State.ProfileState State
@inject NavigationManager Navigation

<PageTitle>Create character | LevelUp</PageTitle>

<section class="character-page levelup-fade-in">
    <div class="character-panel character-panel--@State.CurrentStepClass">
        @if (State.Step == LevelUp.Web.Components.Features.Profile.State.CharacterCreationStep.Name)
        {
            <span class="character-panel__brand">LEVELUP</span>
            <h1>Create your character</h1>
            <p class="character-panel__intro">Choose a name and nickname to begin your journey.</p>

            <EditForm Model="State.Model" OnValidSubmit="State.ContinueToClasses">
                <DataAnnotationsValidator />

                <label class="character-field" for="character-name">
                    <span>Character name</span>
                    <input id="character-name"
                           class="character-field__input"
                           @bind="State.Model.Name"
                           @bind:event="oninput"
                           placeholder="Enter your character name"
                           maxlength="80"
                           autocomplete="off"
                           autofocus />
                </label>
                <ValidationMessage For="@(() => State.Model.Name)" />

                <label class="character-field" for="character-nickname">
                    <span>Nickname</span>
                    <div class="character-nickname-field">
                        <span class="character-nickname-field__prefix" aria-hidden="true">@@</span>
                        <input id="character-nickname"
                               class="character-field__input character-nickname-field__input"
                               @bind="State.Model.Nickname"
                               @bind:event="oninput"
                               placeholder="your.nickname"
                               maxlength="24"
                               autocomplete="off" />
                    </div>
                </label>
                <ValidationMessage For="@(() => State.Model.Nickname)" />

                <button class="character-primary-button"
                        type="submit"
                        disabled="@(!State.CanContinue)">
                    Create Character
                </button>
            </EditForm>
        }
        else
        {
            <div class="character-selection-header">
                <button class="character-back-button" type="button" @onclick="State.BackToName">
                    <span aria-hidden="true">←</span>
                    Back
                </button>

                <span class="character-panel__brand character-panel__brand--right">LEVELUP</span>
            </div>

            <h1>Choose your class</h1>
            <p class="character-panel__intro">Every class follows a different path. Choose carefully.</p>

            <div class="class-grid" role="list" aria-label="Available character classes">
                @foreach (var option in LevelUp.Web.Components.Features.Profile.State.ProfileState.ClassOptions)
                {
                    <button class="class-card"
                            type="button"
                            role="listitem"
                            aria-label="Choose @option.DisplayName"
                            @onclick="() => State.RequestClassConfirmation(option)">
                        <span class="class-card__image-frame">
                            <img src="@option.ImagePath" alt="" />
                        </span>
                        <strong>@option.DisplayName</strong>
                        <span>@option.Description</span>
                    </button>
                }
            </div>
        }
    </div>
</section>

@if (State.ShowConfirmation && State.SelectedClass is not null)
{
    <div class="class-confirmation-backdrop"
         tabindex="-1"
         @onclick="State.CloseConfirmation"
         @onkeydown="State.HandleConfirmationKeyDownAsync">
        <section class="class-confirmation"
                 role="alertdialog"
                 aria-modal="true"
                 aria-labelledby="class-confirmation-title"
                 @onclick:stopPropagation>
            <div class="class-confirmation__icon">
                <img src="@State.SelectedClass.ImagePath" alt="" />
            </div>

            <span class="character-panel__brand">CLASS SELECTION</span>
            <h2 id="class-confirmation-title">
                Are you sure you want to be a <strong>@State.SelectedClass.DisplayName</strong>?
            </h2>
            <p><strong>@State.Model.Name</strong> will be known as <strong>@($"@{State.NormalizedNickname}")</strong>.</p>

            <div class="class-confirmation__actions">
                <button class="class-confirmation__cancel" type="button" disabled="@State.IsBusy" @onclick="State.CloseConfirmation">
                    CANCEL
                </button>
                <button class="class-confirmation__confirm" type="button" disabled="@State.IsBusy" aria-busy="@State.IsBusy" @onclick="ConfirmClassAsync">
                    @(State.IsBusy ? "CREATING..." : $"YES, BECOME {State.SelectedClass.DisplayName.ToUpperInvariant()}")
                </button>
            </div>
        </section>
    </div>
}
