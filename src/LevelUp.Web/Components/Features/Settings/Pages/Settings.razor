@page "/settings"
@rendermode InteractiveServer
@inject LevelUp.Web.Services.LevelUpWebService Store
@inject LevelUp.Web.Services.ToastService Toast
@inject NavigationManager Navigation
@using LevelUp.Domain.Enums
<PageTitle>Settings | LevelUp</PageTitle><section class="settings-page"><h1>Settings</h1>@if(!_loaded){<p>Loading...</p>}else{<div class="settings-grid"><section><h2>Account</h2><label>Name<input @bind="_name" /></label><label>Email<input type="email" @bind="_email" /></label><label>Language<select @bind="_language"><option value="@UserLanguage.English">English</option><option value="@UserLanguage.Portuguese">Português</option></select></label><label>Theme<select @bind="_theme"><option value="@UserTheme.System">System</option><option value="@UserTheme.Light">Light</option><option value="@UserTheme.Dark">Dark</option></select></label><button @onclick="SaveAccountAsync">SAVE ACCOUNT</button></section><section><h2>Character</h2><label>Nickname<input value="@_nickname" readonly /></label><label>Avatar URL<input @bind="_avatar" /></label><label>Class<input value="@_class" disabled /></label><button @onclick="SaveCharacterAsync">SAVE CHARACTER</button></section></div>}</section>
@code{private bool _loaded;private string _name="",_email="",_nickname="",_avatar="",_class="";private UserLanguage _language;private UserTheme _theme;protected override async Task OnInitializedAsync(){var d=await Store.LoadAsync();if(d.CurrentCharacter is null){Navigation.NavigateTo("/character/create",true);return;}var u=d.CurrentUser!;var c=d.CurrentCharacter;_name=u.Name;_email=u.Email;_language=u.Language;_theme=u.Theme;_nickname=c.Nickname;_avatar=c.Avatar;_class=c.Class.ToString();_loaded=true;}private async Task SaveAccountAsync(){try{await Store.UpdateUserAsync(_name,_email);await Store.UpdatePreferencesAsync(_language,_theme);Toast.ShowSuccess("Account updated.");}catch(Exception ex){Toast.ShowError(ex.Message);}}private async Task SaveCharacterAsync(){try{await Store.UpdateCharacterAvatarAsync(_avatar);Toast.ShowSuccess("Character updated.");}catch(Exception ex){Toast.ShowError(ex.Message);}}}
