@using LevelUp.Domain.Enums
<EditorModalShell Model="Model"
                  Title="@(IsEditing ? "Edit Habit" : "Create Habit")"
                  TitleId="habit-editor-title"
                  SubmitLabel="@(IsEditing ? "SAVE" : "CREATE")"
                  ShowDelete="IsEditing"
                  OnSubmit="Save"
                  OnCancel="Cancel"
                  OnDelete="RequestDelete">
    <HeroContent>
        <div class="editor-modal__hero">
            <LevelUpInput Id="habit-title"
                          Label="Title"
                          Required="true"
                          @bind-Value="Model.Title"
                          Placeholder="Add a title"
                          MaxLength="100"
                          FieldCssClass="editor-modal__hero-field"
                          LabelCssClass="editor-modal__label-line"
                          autofocus />
            <LevelUpTextArea Id="habit-notes"
                             Label="Notes"
                             @bind-Value="Model.Description"
                             Placeholder="Add notes"
                             MaxLength="500"
                             ShowCounter="true"
                             FieldCssClass="editor-modal__hero-field"
                             LabelCssClass="editor-modal__label-line"
                             CounterCssClass="editor-modal__counter" />
        </div>
    </HeroContent>
    <BodyContent>
        <div class="editor-modal__body">
            <div class="habit-editor__direction" aria-label="Habit direction">
                <button type="button" class="habit-editor__direction-button @(AllowsPositive ? "active" : string.Empty)" @onclick="TogglePositive"><span>+</span><strong>Positive</strong></button>
                <button type="button" class="habit-editor__direction-button @(AllowsNegative ? "active" : string.Empty)" @onclick="ToggleNegative"><span>−</span><strong>Negative</strong></button>
            </div>
            <LevelUpSelect TValue="HabitDifficulty"
                           Id="habit-difficulty"
                           Label="Difficulty"
                           @bind-Value="Model.Difficulty"
                           FieldCssClass="editor-modal__field">
                @foreach (var option in Enum.GetValues<HabitDifficulty>())
                {
                    <option value="@option">@option</option>
                }
            </LevelUpSelect>
            <LevelUpSelect TValue="HabitResetCounter"
                           Id="habit-reset-counter"
                           Label="Reset counter"
                           @bind-Value="Model.ResetCounter"
                           FieldCssClass="editor-modal__field">
                @foreach (var option in Enum.GetValues<HabitResetCounter>())
                {
                    <option value="@option">@option</option>
                }
            </LevelUpSelect>
            <LevelUpSelect TValue="ActivityAttribute?"
                           Id="habit-attribute"
                           Label="Attribute"
                           @bind-Value="Model.Attribute"
                           FieldCssClass="editor-modal__field">
                <option value="">None</option>
                @foreach (var option in Enum.GetValues<ActivityAttribute>())
                {
                    <option value="@option">@option</option>
                }
            </LevelUpSelect>
        </div>
    </BodyContent>
</EditorModalShell>

<LevelUpConfirmDialog IsOpen="showDeleteConfirmation"
                      Title="Delete Habit"
                      Message="Are you sure you want to delete this habit?"
                      ItemTitle="@Model.Title"
                      Warning="This action cannot be undone."
                      WarningDetails="All information will be permanently removed."
                      ConfirmLabel="Delete Habit"
                      OnConfirm="ConfirmDelete"
                      OnCancel="CloseDeleteConfirmation" />
