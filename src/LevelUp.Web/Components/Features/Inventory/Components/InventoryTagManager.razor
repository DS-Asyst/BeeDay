@using LevelUp.Application.Features.Inventory.Responses

<section class="inventory-tags-panel levelup-card" aria-labelledby="inventory-tags-title" aria-busy="@IsBusy.ToString().ToLowerInvariant()">
    <header class="inventory-panel-header">
        <div><span class="inventory-eyebrow">Organization</span><h2 id="inventory-tags-title">Tags</h2></div>
        <LevelUpButton Variant="LevelUpButtonVariant.Primary" Compact="true" Disabled="IsBusy" Class="levelup-button--comic levelup-button--comic-magenta" OnClick="RaiseCreate">New tag</LevelUpButton>
    </header>

    @if (Tags.Count == 0)
    {
        <LevelUpEmptyState Title="No tags yet"
                           Description="Create one to organize your income and expenses."
                           Icon="PixelIconName.Tag" />
    }
    else
    {
        <div class="inventory-tag-list">
            @foreach (var tag in Tags)
            {
                <LevelUpCard Class="inventory-tag-item"
                             Interactive="true"
                             role="button"
                             tabindex="0"
                             aria-label="@($"Edit Tag: {tag.Name}")"
                             @onclick="() => RaiseEdit(tag)"
                             @onkeydown="args => HandleRowKeyDown(args, tag)">
                    <span class="inventory-tag-dot" style="background:@tag.Color"></span>
                    <div><strong>@tag.Name</strong><small>@tag.TransactionCount transaction@(tag.TransactionCount == 1 ? string.Empty : "s")</small></div>
                </LevelUpCard>
            }
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<InventoryTagResponse> Tags { get; set; } = [];
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback<InventoryTagResponse> OnEdit { get; set; }

    private Task RaiseCreate() => OnCreate.InvokeAsync();
    private Task RaiseEdit(InventoryTagResponse tag) => OnEdit.InvokeAsync(tag);
    private Task HandleRowKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args, InventoryTagResponse tag) =>
        args.Key is "Enter" or " " ? RaiseEdit(tag) : Task.CompletedTask;
}
