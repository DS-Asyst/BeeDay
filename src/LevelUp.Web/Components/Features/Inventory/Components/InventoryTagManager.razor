@using LevelUp.Application.Features.Inventory.Responses
@using LevelUp.Web.Components.Features.Inventory.Models

<section class="inventory-tags-panel" aria-labelledby="inventory-tags-title" aria-busy="@IsBusy.ToString().ToLowerInvariant()">
    <header class="inventory-panel-header">
        <div><span class="inventory-eyebrow">Organization</span><h2 id="inventory-tags-title">Tags</h2></div>
        <button type="button" class="inventory-button inventory-button--cta inventory-button--small" disabled="@IsBusy" @onclick="StartCreate">New tag</button>
    </header>

    @if (Tags.Count == 0)
    {
        <LevelUpEmptyState Title="No tags yet"
                           Description="Create one to organize your income and expenses."
                           Icon="PixelIconName.Tag" />
    }
    else
    {
        <div class="inventory-tag-list">
            @foreach (var tag in Tags)
            {
                <div class="inventory-tag-item">
                    <span class="inventory-tag-dot" style="background:@tag.Color"></span>
                    <div><strong>@tag.Name</strong><small>@tag.TransactionCount transaction@(tag.TransactionCount == 1 ? string.Empty : "s")</small></div>
                    <button type="button" class="inventory-tag-action inventory-tag-action--edit" disabled="@IsBusy" @onclick="() => StartEdit(tag)">Edit</button>
                    <button type="button" class="inventory-tag-action inventory-tag-action--delete" disabled="@IsBusy" @onclick="() => OnDelete.InvokeAsync(tag)">Delete</button>
                </div>
            }
        </div>
    }

    @if (IsEditorOpen)
    {
        <EditForm Model="Form" OnValidSubmit="SubmitAsync" class="inventory-tag-form">
            <DataAnnotationsValidator />
            <label class="inventory-field"><span>Name</span><InputText @bind-Value="Form.Name" maxlength="40" disabled="@IsBusy" autofocus /><ValidationMessage For="@(() => Form.Name)" /></label>
            <label class="inventory-field inventory-color-field"><span>Color</span><InputText @bind-Value="Form.Color" maxlength="7" disabled="@IsBusy" /><input type="color" @bind="Form.Color" disabled="@IsBusy" aria-label="Select tag color" /><ValidationMessage For="@(() => Form.Color)" /></label>
            <div class="inventory-tag-form__actions">
                <LevelUpButton Variant="LevelUpButtonVariant.ConfirmationCancel" Compact="true" Disabled="IsBusy" OnClick="Cancel">Cancel</LevelUpButton>
                <button type="submit" class="inventory-button inventory-button--cta inventory-button--small" disabled="@IsBusy">@(IsBusy ? "Saving..." : "Save tag")</button>
            </div>
        </EditForm>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<InventoryTagResponse> Tags { get; set; } = [];
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public Func<(Guid? Id, InventoryTagFormModel Form), Task<bool>>? OnSave { get; set; }
    [Parameter] public EventCallback<InventoryTagResponse> OnDelete { get; set; }
    private bool IsEditorOpen { get; set; }
    private Guid? EditingId { get; set; }
    private InventoryTagFormModel Form { get; set; } = new();
    private void StartCreate() { if (IsBusy) return; EditingId = null; Form = new(); IsEditorOpen = true; }
    private void StartEdit(InventoryTagResponse tag) { if (IsBusy) return; EditingId = tag.Id; Form = new() { Name = tag.Name, Color = tag.Color }; IsEditorOpen = true; }
    private async Task SubmitAsync() { if (IsBusy || OnSave is null) return; if (await OnSave((EditingId, Form))) Cancel(); }
    private void Cancel() { if (IsBusy) return; IsEditorOpen = false; EditingId = null; Form = new(); }
}
