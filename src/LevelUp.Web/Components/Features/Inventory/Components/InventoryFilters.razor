@using LevelUp.Application.Features.Inventory.Responses

<div class="inventory-filter-shell">
    <div class="inventory-filters">
        <label class="inventory-search inventory-filter-field inventory-filter-field--search">
            <span>Search</span>
            <input disabled="@IsDisabled" value="@Search" @oninput="HandleSearchInput" placeholder="Description or notes" />
        </label>

        <label class="inventory-filter-field">
            <span>Type</span>
            <select disabled="@IsDisabled" value="@TypeFilter" @onchange="HandleTypeChanged">
                <option value="">All types</option>
                <option value="Income">Income</option>
                <option value="Expense">Expense</option>
            </select>
        </label>

        <label class="inventory-filter-field">
            <span>Tag</span>
            <select disabled="@IsDisabled" value="@TagFilter" @onchange="HandleTagChanged">
                <option value="">All tags</option>
                @foreach (var tag in Tags)
                {
                    <option value="@tag.Id">@tag.Name</option>
                }
            </select>
        </label>

        <label class="inventory-filter-field">
            <span>From</span>
            <input type="date" disabled="@IsDisabled" value="@FormatDate(StartDate)" @onchange="HandleStartDateChanged" />
        </label>

        <label class="inventory-filter-field">
            <span>To</span>
            <input type="date" disabled="@IsDisabled" value="@FormatDate(EndDate)" @onchange="HandleEndDateChanged" />
        </label>

        <label class="inventory-filter-field">
            <span>Order</span>
            <select disabled="@IsDisabled" value="@Sort" @onchange="HandleSortChanged">
                <option value="date-desc">Newest first</option>
                <option value="date-asc">Oldest first</option>
            </select>
        </label>
    </div>

    @if (ActiveFilterCount > 0)
    {
        <div class="inventory-active-filters" role="status">
            <span>@ActiveFilterCount active filter@(ActiveFilterCount == 1 ? string.Empty : "s")</span>
            <button type="button" class="inventory-button inventory-button--ghost" disabled="@IsDisabled" @onclick="OnClearFilters">Clear filters</button>
        </div>
    }
</div>

@code {
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public string Search { get; set; } = string.Empty;
    [Parameter] public string TypeFilter { get; set; } = string.Empty;
    [Parameter] public string TagFilter { get; set; } = string.Empty;
    [Parameter] public DateOnly? StartDate { get; set; }
    [Parameter] public DateOnly? EndDate { get; set; }
    [Parameter] public string Sort { get; set; } = "date-desc";
    [Parameter] public int ActiveFilterCount { get; set; }
    [Parameter] public IReadOnlyList<InventoryTagResponse> Tags { get; set; } = [];
    [Parameter] public EventCallback<string> SearchChanged { get; set; }
    [Parameter] public EventCallback<string> TypeFilterChanged { get; set; }
    [Parameter] public EventCallback<string> TagFilterChanged { get; set; }
    [Parameter] public EventCallback<DateOnly?> StartDateChanged { get; set; }
    [Parameter] public EventCallback<DateOnly?> EndDateChanged { get; set; }
    [Parameter] public EventCallback<string> SortChanged { get; set; }
    [Parameter] public EventCallback OnClearFilters { get; set; }

    private Task HandleSearchInput(ChangeEventArgs args) => SearchChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task HandleTypeChanged(ChangeEventArgs args) => TypeFilterChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task HandleTagChanged(ChangeEventArgs args) => TagFilterChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task HandleStartDateChanged(ChangeEventArgs args) => StartDateChanged.InvokeAsync(ParseDate(args.Value));
    private Task HandleEndDateChanged(ChangeEventArgs args) => EndDateChanged.InvokeAsync(ParseDate(args.Value));
    private Task HandleSortChanged(ChangeEventArgs args) => SortChanged.InvokeAsync(args.Value?.ToString() ?? "date-desc");

    private static string FormatDate(DateOnly? value) => value?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

    private static DateOnly? ParseDate(object? value) =>
        DateOnly.TryParseExact(value?.ToString(), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date)
            ? date
            : null;
}
