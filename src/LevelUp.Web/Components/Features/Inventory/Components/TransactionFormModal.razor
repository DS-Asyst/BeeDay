@using LevelUp.Application.Features.Inventory.Responses
@using LevelUp.Web.Components.Features.Inventory.Models

@if (IsOpen)
{
    <EditorModalShell Model="Model"
                      Title="@(IsEditing ? "Edit Transaction" : "Create Transaction")"
                      TitleId="transaction-editor-title"
                      SubmitLabel="@(IsEditing ? "Save" : "Create")"
                      ShowDelete="IsEditing"
                      IsBusy="IsBusy"
                      OnSubmit="SaveAsync"
                      OnCancel="CancelAsync"
                      OnDelete="DeleteAsync">
        <HeroContent>
            <div class="editor-modal__hero">
                <LevelUpInput Id="transaction-description"
                              Label="Description"
                              Required="true"
                              @bind-Value="Model.Description"
                              Placeholder="Add a description"
                              MaxLength="120"
                              FieldCssClass="editor-modal__hero-field"
                              LabelCssClass="editor-modal__label-line"
                              autofocus />
                <LevelUpTextArea Id="transaction-notes"
                                 Label="Notes"
                                 @bind-Value="Model.Notes"
                                 Placeholder="Add notes"
                                 MaxLength="500"
                                 ShowCounter="true"
                                 FieldCssClass="editor-modal__hero-field"
                                 LabelCssClass="editor-modal__label-line"
                                 CounterCssClass="editor-modal__counter" />
            </div>
        </HeroContent>
        <BodyContent>
            <div class="editor-modal__body inventory-editor-grid">
                <div class="editor-modal__type-summary inventory-editor-grid__wide">
                    <span class="editor-modal__type-icon" aria-hidden="true">◇</span>
                    <div>
                        <strong>Transaction</strong>
                        <p>Record income or expenses in your wallet.</p>
                    </div>
                </div>

                <LevelUpSelect TValue="TransactionType"
                               Id="transaction-type"
                               Label="Type"
                               @bind-Value="Model.Type"
                               FieldCssClass="editor-modal__field">
                    <option value="@TransactionType.Income">Income</option>
                    <option value="@TransactionType.Expense">Expense</option>
                </LevelUpSelect>

                <label class="editor-modal__field">
                    <span>Amount</span>
                    <InputNumber @bind-Value="Model.Amount" step="0.01" min="0.01" />
                    <ValidationMessage For="@(() => Model.Amount)" />
                </label>

                <label class="editor-modal__field">
                    <span>Date</span>
                    <InputDate @bind-Value="Model.TransactionDate" />
                </label>

                <LevelUpSelect TValue="Guid?"
                               Id="transaction-tag"
                               Label="Tag"
                               @bind-Value="Model.InventoryTagId"
                               FieldCssClass="editor-modal__field">
                    <option value="">No tag</option>
                    @foreach (var tag in Tags)
                    {
                        <option value="@tag.Id">@tag.Name</option>
                    }
                </LevelUpSelect>
            </div>
        </BodyContent>
    </EditorModalShell>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter, EditorRequired] public TransactionFormModel Model { get; set; } = new();
    [Parameter] public IReadOnlyList<InventoryTagResponse> Tags { get; set; } = [];
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnDeleteRequested { get; set; }

    private Task SaveAsync() => IsBusy ? Task.CompletedTask : OnSave.InvokeAsync();
    private Task CancelAsync() => IsBusy ? Task.CompletedTask : OnCancel.InvokeAsync();
    private Task DeleteAsync() => IsBusy ? Task.CompletedTask : OnDeleteRequested.InvokeAsync();
}
