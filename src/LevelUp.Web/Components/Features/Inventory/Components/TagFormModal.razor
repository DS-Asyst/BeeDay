@using LevelUp.Web.Components.Features.Inventory.Models

@if (IsOpen)
{
    <EditorModalShell Model="Model"
                      Title="@(IsEditing ? "Edit Tag" : "Create Tag")"
                      TitleId="tag-editor-title"
                      SubmitLabel="@(IsEditing ? "Save" : "Create")"
                      ShowDelete="IsEditing"
                      IsBusy="IsBusy"
                      OnSubmit="SaveAsync"
                      OnCancel="CancelAsync"
                      OnDelete="DeleteAsync">
        <HeroContent>
            <div class="editor-modal__hero">
                <LevelUpInput Id="tag-name"
                              Label="Name"
                              Required="true"
                              @bind-Value="Model.Name"
                              Placeholder="Add a name"
                              MaxLength="40"
                              FieldCssClass="editor-modal__hero-field"
                              LabelCssClass="editor-modal__label-line"
                              autofocus />
            </div>
        </HeroContent>
        <BodyContent>
            <div class="editor-modal__body">
                <div class="editor-modal__type-summary">
                    <PixelIcon Name="PixelIconName.Tag" Size="PixelIconSize.Large" Class="editor-modal__type-icon" Decorative="true" />
                    <div>
                        <strong>Tag</strong>
                        <p>Organize your income and expenses.</p>
                    </div>
                </div>
                <label class="editor-modal__field inventory-color-field">
                    <span>Color</span>
                    <InputText @bind-Value="Model.Color" maxlength="7" disabled="@IsBusy" />
                    <input type="color" @bind="Model.Color" disabled="@IsBusy" aria-label="Select tag color" />
                    <ValidationMessage For="@(() => Model.Color)" />
                </label>
            </div>
        </BodyContent>
    </EditorModalShell>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter, EditorRequired] public InventoryTagFormModel Model { get; set; } = new();
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnDeleteRequested { get; set; }

    private Task SaveAsync() => IsBusy ? Task.CompletedTask : OnSave.InvokeAsync();
    private Task CancelAsync() => IsBusy ? Task.CompletedTask : OnCancel.InvokeAsync();
    private Task DeleteAsync() => IsBusy ? Task.CompletedTask : OnDeleteRequested.InvokeAsync();
}
