@using LevelUp.Application.Features.Inventory.Responses
@using LevelUp.Web.Components.Features.Inventory.Services

<section class="inventory-summary" aria-label="Wallet summary">
    <LevelUpCard Class="@($"inventory-summary__card inventory-summary__card--balance {(HighlightBalance ? "inventory-summary__card--updated" : string.Empty)}")">
        <span class="inventory-summary__label"><PixelIcon Name="PixelIconName.Wallet" Size="PixelIconSize.Small" /> Current balance</span>
        <strong>@FormatMoney(Summary?.Balance ?? 0)</strong>
        <small>@(Summary?.TransactionCount ?? 0) transactions</small>
    </LevelUpCard>
    <LevelUpCard Class="inventory-summary__card inventory-summary__card--income">
        <span class="inventory-summary__label"><PixelIcon Name="PixelIconName.Income" Size="PixelIconSize.Small" Color="PixelIconColor.Success" /> Total income</span>
        <strong>@FormatMoney(Summary?.TotalIncome ?? 0)</strong>
        <small>Money added</small>
    </LevelUpCard>
    <LevelUpCard Class="inventory-summary__card inventory-summary__card--expense">
        <span class="inventory-summary__label"><PixelIcon Name="PixelIconName.Expense" Size="PixelIconSize.Small" Color="PixelIconColor.Danger" /> Total expenses</span>
        <strong>@FormatMoney(Summary?.TotalExpenses ?? 0)</strong>
        <small>Money spent</small>
    </LevelUpCard>
</section>

@code {
    [Parameter] public WalletSummaryResponse? Summary { get; set; }
    [Parameter] public bool HighlightBalance { get; set; }
    private static string FormatMoney(decimal value) => InventoryCurrencyFormatter.Format(value);
}
