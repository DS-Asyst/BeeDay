@page "/inventory"
@attribute [Authorize]
@rendermode InteractiveServer
@using LevelUp.Application.Features.Inventory.Commands
@using LevelUp.Application.Features.Inventory.Queries
@using LevelUp.Application.Features.Inventory.Requests
@using LevelUp.Application.Features.Inventory.Responses
@using LevelUp.Web.Components.Features.Inventory.Components
@using LevelUp.Web.Components.Features.Inventory.Models
@using LevelUp.Web.Components.Features.Inventory.Services
@using LevelUp.Web.Components.Features.Inventory.State
@inject MediatR.ISender Sender
@inject AuthenticatedUserInitializer UserInitializer
@inject ToastService Toast

<PageTitle>Inventory | LevelUp</PageTitle>

@if (_isLoading)
{
    <LevelUpDashboardSkeleton />
}
else
{
    <main class="inventory-page levelup-fade-in">
        <header class="inventory-page__header">
            <div>
                <span class="inventory-eyebrow">Personal finance</span>
                <h1>Inventory</h1>
                <p>Track your wallet, organize transactions and understand where your money goes.</p>
            </div>
            <button type="button" class="inventory-button inventory-button--cta" @onclick="OpenCreateTransaction">+ New transaction</button>
        </header>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="inventory-alert" role="alert">
                <span>@_errorMessage</span>
                <button type="button" @onclick="LoadAsync">Try again</button>
            </div>
        }

        <div aria-live="polite" class="sr-only">@_balanceAnnouncement</div>
        <WalletSummary Summary="_summary" HighlightBalance="_highlightBalance" />

        <section class="inventory-workspace">
            <TransactionList Transactions="_transactions"
                             Tags="_tags"
                             IsRefreshing="_isRefreshing"
                             HasFilters="_state.HasFilters"
                             Search="_state.Search"
                             TypeFilter="_state.TypeFilter"
                             TagFilter="_state.TagFilter"
                             Sort="_state.Sort"
                             SearchChanged="HandleSearchChangedAsync"
                             TypeFilterChanged="HandleTypeChangedAsync"
                             TagFilterChanged="HandleTagChangedAsync"
                             SortChanged="HandleSortChangedAsync"
                             OnCreateTransaction="OpenCreateTransaction"
                             OnClearFilters="ClearFiltersAsync"
                             OnPreviousPage="PreviousPageAsync"
                             OnNextPage="NextPageAsync"
                             OnEdit="OpenEditTransaction"
                             OnDelete="RequestDeleteTransaction" />

            <InventoryTagManager Tags="_tags" IsBusy="_isBusy" OnSave="SaveTagAsync" OnDelete="RequestDeleteTag" />
        </section>
    </main>
}

<TransactionFormModal IsOpen="_isTransactionEditorOpen" IsEditing="@(_editingTransactionId is not null)" IsBusy="_isBusy" Model="_transactionForm" Tags="_tags" OnSave="SaveTransactionAsync" OnCancel="CloseTransactionEditor" />

<LevelUpConfirmDialog IsOpen="@(_pendingDeleteTransaction is not null)"
                      IsBusy="_isBusy"
                      Title="Delete transaction"
                      Message="Are you sure you want to delete this transaction?"
                      ItemTitle="@_pendingDeleteTransaction?.Description"
                      Warning="This action cannot be undone."
                      ConfirmLabel="Delete transaction"
                      OnConfirm="DeleteTransactionAsync"
                      OnCancel="CancelDeleteTransaction" />

<LevelUpConfirmDialog IsOpen="@(_pendingDeleteTag is not null)"
                      IsBusy="_isBusy"
                      Title="Delete tag"
                      Message="Transactions using this tag will remain and become untagged."
                      ItemTitle="@_pendingDeleteTag?.Name"
                      Warning="The tag will be permanently removed."
                      ConfirmLabel="Delete tag"
                      OnConfirm="DeleteTagAsync"
                      OnCancel="CancelDeleteTag" />

@code {
    private WalletSummaryResponse? _summary;
    private IReadOnlyList<InventoryTagResponse> _tags = [];
    private PagedTransactionsResponse _transactions = new([], 1, 20, 0, 0);
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isRefreshing;
    private bool _highlightBalance;
    private string _balanceAnnouncement = string.Empty;
    private string? _errorMessage;
    private readonly InventoryPageState _state = new();
    private bool _isTransactionEditorOpen;
    private Guid? _editingTransactionId;
    private TransactionFormModel _transactionForm = new();
    private TransactionResponse? _pendingDeleteTransaction;
    private InventoryTagResponse? _pendingDeleteTag;

    protected override async Task OnInitializedAsync()
    {
        await UserInitializer.EnsureInitializedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            await Sender.Send(new EnsureCurrentWalletCommand());
            await LoadDataAsync();
        }
        catch (Exception)
        {
            _errorMessage = "We could not load your inventory. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        var (sortField, sortDirection) = ResolveSort();
        TransactionType? type = Enum.TryParse<TransactionType>(_state.TypeFilter, out var parsedType) ? parsedType : null;
        Guid? tagId = Guid.TryParse(_state.TagFilter, out var parsedTagId) ? parsedTagId : null;

        var summaryTask = Sender.Send(new GetWalletSummaryQuery());
        var tagsTask = Sender.Send(new GetInventoryTagsQuery());
        var transactionsTask = Sender.Send(new GetTransactionsQuery(
            Search: string.IsNullOrWhiteSpace(_state.Search) ? null : _state.Search.Trim(),
            Type: type,
            InventoryTagId: tagId,
            SortBy: sortField,
            SortDirection: sortDirection,
            Page: _state.Page,
            PageSize: 20));

        await Task.WhenAll(summaryTask, tagsTask, transactionsTask);
        _summary = await summaryTask;
        _tags = await tagsTask;
        _transactions = await transactionsTask;
    }

    private (TransactionSortField, SortDirection) ResolveSort() => _state.Sort switch
    {
        "date-asc" => (TransactionSortField.Date, SortDirection.Ascending),
        "amount-desc" => (TransactionSortField.Amount, SortDirection.Descending),
        "amount-asc" => (TransactionSortField.Amount, SortDirection.Ascending),
        "description-asc" => (TransactionSortField.Description, SortDirection.Ascending),
        "description-desc" => (TransactionSortField.Description, SortDirection.Descending),
        _ => (TransactionSortField.Date, SortDirection.Descending)
    };

    private async Task RefreshAsync()
    {
        _errorMessage = null;
        _isRefreshing = true;
        try { await LoadDataAsync(); }
        catch { _errorMessage = "We could not load your transactions. Please try again."; }
        finally { _isRefreshing = false; }
    }

    private async Task HandleSearchChangedAsync(string value)
    {
        _state.Search = value;
        _state.ResetPage();
        await RefreshAsync();
    }

    private async Task HandleTypeChangedAsync(string value)
    {
        _state.TypeFilter = value;
        _state.ResetPage();
        await RefreshAsync();
    }

    private async Task HandleTagChangedAsync(string value)
    {
        _state.TagFilter = value;
        _state.ResetPage();
        await RefreshAsync();
    }

    private async Task HandleSortChangedAsync(string value)
    {
        _state.Sort = string.IsNullOrWhiteSpace(value) ? "date-desc" : value;
        _state.ResetPage();
        await RefreshAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _state.ClearFilters();
        await RefreshAsync();
    }
    private async Task PreviousPageAsync() { if (_state.Page > 1) { _state.Page--; await RefreshAsync(); } }
    private async Task NextPageAsync() { if (_state.Page < _transactions.TotalPages) { _state.Page++; await RefreshAsync(); } }

    private void OpenCreateTransaction()
    {
        _editingTransactionId = null;
        _transactionForm = new TransactionFormModel { TransactionDate = DateTime.Today, Type = TransactionType.Expense };
        _isTransactionEditorOpen = true;
    }

    private void OpenEditTransaction(TransactionResponse transaction)
    {
        _editingTransactionId = transaction.Id;
        _transactionForm = new TransactionFormModel
        {
            Description = transaction.Description,
            Amount = transaction.Amount,
            Type = transaction.Type,
            TransactionDate = transaction.TransactionDate.ToDateTime(TimeOnly.MinValue),
            InventoryTagId = transaction.InventoryTagId,
            Notes = transaction.Notes
        };
        _isTransactionEditorOpen = true;
    }

    private void CloseTransactionEditor() { if (!_isBusy) { _isTransactionEditorOpen = false; _editingTransactionId = null; } }

    private async Task SaveTransactionAsync()
    {
        _isBusy = true;
        try
        {
            var request = new SaveTransactionRequest(
                _transactionForm.Description,
                _transactionForm.Amount,
                _transactionForm.Type,
                DateOnly.FromDateTime(_transactionForm.TransactionDate),
                _transactionForm.InventoryTagId,
                _transactionForm.Notes);

            if (_editingTransactionId is Guid id)
                await Sender.Send(new UpdateTransactionCommand(id, request));
            else
                await Sender.Send(new CreateTransactionCommand(request));

            var wasEditing = _editingTransactionId is not null;
            CloseTransactionEditor();
            await RefreshAsync();
            await AnnounceBalanceUpdatedAsync();
            Toast.ShowSuccess(wasEditing ? "Transaction updated successfully." : "Transaction created successfully.");
        }
        catch (Exception ex) { _errorMessage = ex.Message; Toast.ShowError("Could not save the transaction."); }
        finally { _isBusy = false; _isTransactionEditorOpen = false; _editingTransactionId = null; }
    }

    private void RequestDeleteTransaction(TransactionResponse transaction) => _pendingDeleteTransaction = transaction;
    private void CancelDeleteTransaction() => _pendingDeleteTransaction = null;

    private async Task DeleteTransactionAsync()
    {
        if (_pendingDeleteTransaction is null) return;
        _isBusy = true;
        try
        {
            await Sender.Send(new DeleteTransactionCommand(_pendingDeleteTransaction.Id));
            _pendingDeleteTransaction = null;
            await RefreshAsync();
            if (_transactions.Items.Count == 0 && _state.Page > 1)
            {
                _state.Page--;
                await RefreshAsync();
            }
            await AnnounceBalanceUpdatedAsync();
            Toast.ShowSuccess("Transaction deleted successfully.");
        }
        catch (Exception ex) { _errorMessage = ex.Message; Toast.ShowError("Could not delete the transaction."); }
        finally { _isBusy = false; }
    }

    private async Task SaveTagAsync((Guid? Id, InventoryTagFormModel Form) value)
    {
        _isBusy = true;
        try
        {
            var request = new SaveInventoryTagRequest(value.Form.Name, value.Form.Color);
            if (value.Id is Guid id) await Sender.Send(new UpdateInventoryTagCommand(id, request));
            else await Sender.Send(new CreateInventoryTagCommand(request));
            await RefreshAsync();
            Toast.ShowSuccess(value.Id is null ? "Tag created." : "Tag updated.");
        }
        catch (Exception ex) { _errorMessage = ex.Message; Toast.ShowError("Could not save the tag."); }
        finally { _isBusy = false; }
    }

    private void RequestDeleteTag(InventoryTagResponse tag) => _pendingDeleteTag = tag;
    private void CancelDeleteTag() => _pendingDeleteTag = null;

    private async Task DeleteTagAsync()
    {
        if (_pendingDeleteTag is null) return;
        _isBusy = true;
        try
        {
            await Sender.Send(new DeleteInventoryTagCommand(_pendingDeleteTag.Id));
            _pendingDeleteTag = null;
            await RefreshAsync();
            Toast.ShowSuccess("Tag deleted.");
        }
        catch (Exception ex) { _errorMessage = ex.Message; Toast.ShowError("Could not delete the tag."); }
        finally { _isBusy = false; }
    }

    private async Task AnnounceBalanceUpdatedAsync()
    {
        _balanceAnnouncement = $"Balance updated to {InventoryCurrencyFormatter.Format(_summary?.Balance ?? 0)}.";
        _highlightBalance = true;
        StateHasChanged();
        await Task.Delay(700);
        _highlightBalance = false;
    }
}
