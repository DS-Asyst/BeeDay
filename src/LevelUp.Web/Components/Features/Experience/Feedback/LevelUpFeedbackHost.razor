@implements IDisposable
@inject LevelUpFeedbackStore Store

<LevelUpFeedbackModal Feedback="Store.Current"
                      History="Store.History"
                      OnClose="Store.Consume" />

@code {
    protected override void OnInitialized() => Store.Changed += HandleChanged;

    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= HandleChanged;
}
