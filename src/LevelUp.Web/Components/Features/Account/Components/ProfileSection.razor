@using LevelUp.Web.Components.Features.Account.Models

<LevelUpSettingsSection Eyebrow="IDENTITY"
                        Title="Profile"
                        Description="Manage the personal information shown across LevelUp.">
    <LevelUpSettingsForm TModel="ProfileFormModel" Model="Model" OnValidSubmit="OnSave"
                         FormName="account-profile" SubmitLabel="SAVE PROFILE" IsBusy="IsBusy">
        <div class="levelup-settings-form__grid">
            <LevelUpInput Id="account-name" Label="Name" Required="true" MaxLength="100"
                          @bind-Value="Model.Name" />
            <LevelUpInput Id="account-email" Label="Email" Required="true" MaxLength="254"
                          @bind-Value="Model.Email" />
            <LevelUpInput Id="account-nickname" Label="Nickname" ReadOnly="true" @bind-Value="Model.Nickname" />
            <LevelUpInput Id="account-class" Label="Class" Disabled="true" @bind-Value="Model.CharacterClass" />
        </div>

        <p class="levelup-settings-form__hint">Your nickname is permanent after character creation.</p>
    </LevelUpSettingsForm>
</LevelUpSettingsSection>

@code {
    [Parameter, EditorRequired] public ProfileFormModel Model { get; set; } = default!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
