@page "/account/forgot-password"
@attribute [AllowAnonymous]
@layout OnboardingLayout
@inject MediatR.ISender Sender

<PageTitle>Forgot password | LevelUp</PageTitle>
<section class="identity-page levelup-fade-in"><div class="identity-card"><div class="identity-card__content">
<span class="identity-brand"><span>LEVEL</span><span>UP</span></span>
<header class="identity-header"><h1>Forgot password</h1><p>Enter your email to generate password recovery instructions.</p></header>
@if (_submitted) { <div class="identity-feedback identity-feedback--success" role="status">If an account exists for this email, recovery instructions were generated.</div><div class="identity-note"><span>Development mode saves the message in <code>src/LevelUp.Web/Data/Emails</code>.</span></div> }
<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="identity-form"><DataAnnotationsValidator />
<label class="identity-field"><span>Email</span><InputText type="email" @bind-Value="_model.Email" autocomplete="email" /><ValidationMessage For="() => _model.Email" /></label>
<button class="identity-primary" type="submit" disabled="@_busy">@(_busy ? "SENDING..." : "SEND RECOVERY LINK")</button></EditForm>
<a class="identity-secondary" href="/login">BACK TO SIGN IN</a>
</div></div></section>
@code {
    private readonly EmailForm _model = new(); private bool _busy; private bool _submitted;
    private async Task SubmitAsync() { _busy=true; try { await Sender.Send(new LevelUp.Application.Features.Identity.Commands.RequestPasswordResetCommand(new(_model.Email))); _submitted=true; } finally { _busy=false; } }
    private sealed class EmailForm { [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress] public string Email { get; set; } = string.Empty; }
}
