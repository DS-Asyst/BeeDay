@page "/account/forgot-password"
@attribute [AllowAnonymous]
@layout OnboardingLayout
@inject MediatR.ISender Sender

<PageTitle>Forgot password | LevelUp</PageTitle>
<section class="identity-page levelup-fade-in"><div class="identity-card"><div class="identity-card__content">
<div class="identity-card__brand"><LevelUpBrand /></div>
<header class="identity-header"><h1>Forgot password</h1><p>Enter your email to generate password recovery instructions.</p></header>
@if (_submitted) { <div class="identity-feedback identity-feedback--success" role="status">If an account exists for this email, recovery instructions were generated.</div><div class="identity-note"><span>For security, this response is the same for every email address.</span></div> }
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="identity-feedback identity-feedback--error" role="alert">We could not process the request. Please try again.</div> }
<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="identity-form"><DataAnnotationsValidator />
<label class="identity-field"><span>Email</span><InputText type="email" @bind-Value="_model.Email" autocomplete="email" disabled="@_busy" /><ValidationMessage For="() => _model.Email" /></label>
<LevelUpButton Type="submit" FullWidth="true" IsLoading="@_busy" Disabled="@_busy">Send Recovery Link</LevelUpButton></EditForm>
<a class="identity-navigation-link" href="/login">BACK TO SIGN IN</a>
</div></div></section>
@code {
    private readonly EmailForm _model = new(); private bool _busy; private bool _submitted; private string? _error;
    private async Task SubmitAsync() { if(_busy) return; _busy=true; _error=null; try { await Sender.Send(new LevelUp.Application.Features.Identity.Commands.RequestPasswordResetCommand(new(_model.Email))); _submitted=true; } catch { _error="Request failed"; } finally { _busy=false; } }
    private sealed class EmailForm { [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress] public string Email { get; set; } = string.Empty; }
}
