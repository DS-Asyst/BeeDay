@page "/account/resend-confirmation"
@attribute [AllowAnonymous]
@layout OnboardingLayout
@implements IDisposable
@inject MediatR.ISender Sender

<PageTitle>Resend confirmation | LevelUp</PageTitle>
<section class="identity-page levelup-fade-in"><div class="identity-card"><div class="identity-card__content">
<div class="identity-card__brand"><LevelUpBrand /></div>
<header class="identity-header"><h1>Resend confirmation</h1><p>Enter the email used to create your account.</p></header>
@if (_submitted) { <div class="identity-feedback identity-feedback--success" role="status">If the account is eligible, a new confirmation message was generated.</div> }
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="identity-feedback identity-feedback--error" role="alert">@_error</div> }
<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="identity-form">
<DataAnnotationsValidator />
<label class="identity-field"><span>Email</span><InputText type="email" @bind-Value="_model.Email" autocomplete="email" disabled="@_busy" /><ValidationMessage For="() => _model.Email" /></label>
<LevelUpButton Type="submit" FullWidth="true" IsLoading="@_busy" Disabled="@(_busy || _secondsRemaining > 0)">@ButtonText</LevelUpButton>
</EditForm>
<a class="identity-navigation-link" href="/login">BACK TO SIGN IN</a>
</div></div></section>
@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    private readonly EmailForm _model = new(); private bool _busy; private bool _submitted; private string? _error; private int _secondsRemaining; private PeriodicTimer? _timer; private CancellationTokenSource? _countdownCts;
    private string ButtonText => _busy ? "SENDING..." : _secondsRemaining > 0 ? $"RESEND AVAILABLE IN {_secondsRemaining}S" : "RESEND EMAIL";
    protected override void OnParametersSet() { if (!string.IsNullOrWhiteSpace(Email) && string.IsNullOrWhiteSpace(_model.Email)) _model.Email = Email.Trim(); }
    private async Task SubmitAsync() { if (_busy || _secondsRemaining > 0) return; _busy=true; _error=null; try { await Sender.Send(new LevelUp.Application.Features.Identity.Commands.ResendEmailConfirmationCommand(new(_model.Email))); _submitted=true; StartCountdown(); } catch(Exception ex) { _error=ex.Message; } finally { _busy=false; } }
    private void StartCountdown() { _secondsRemaining=60; _countdownCts?.Cancel(); _countdownCts=new(); _timer=new(TimeSpan.FromSeconds(1)); _=RunCountdownAsync(_countdownCts.Token); }
    private async Task RunCountdownAsync(CancellationToken token) { try { while (_secondsRemaining>0 && await _timer!.WaitForNextTickAsync(token)) { _secondsRemaining--; await InvokeAsync(StateHasChanged); } } catch(OperationCanceledException) { } }
    public void Dispose() { _countdownCts?.Cancel(); _countdownCts?.Dispose(); _timer?.Dispose(); }
    private sealed class EmailForm { [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress] public string Email { get; set; } = string.Empty; }
}
