@page "/account/reset-password"
@attribute [AllowAnonymous]
@layout OnboardingLayout
@inject MediatR.ISender Sender

<PageTitle>Reset password | LevelUp</PageTitle>
<section class="identity-page levelup-fade-in"><div class="identity-card"><div class="identity-card__content">
<span class="identity-brand"><span>LEVEL</span><span>UP</span></span>
@if (_completed) { <header class="identity-header"><h1>Password updated</h1><p>Your new password is active.</p></header><div class="identity-feedback identity-feedback--success">Password reset completed successfully.</div><a class="identity-primary identity-link-button" href="/login?reset=true">SIGN IN</a> }
else { <header class="identity-header"><h1>Reset password</h1><p>Choose a new password for your account.</p></header>
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="identity-feedback identity-feedback--error" role="alert">@_error</div> }
<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="identity-form"><DataAnnotationsValidator />
<label class="identity-field"><span>New password</span><InputText type="password" @bind-Value="_model.Password" autocomplete="new-password" /><ValidationMessage For="() => _model.Password" /></label>
<label class="identity-field"><span>Confirm password</span><InputText type="password" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" /><ValidationMessage For="() => _model.ConfirmPassword" /></label>
<button class="identity-primary" type="submit" disabled="@_busy">@(_busy ? "UPDATING..." : "RESET PASSWORD")</button></EditForm>
<a class="identity-secondary" href="/login">BACK TO SIGN IN</a> }
</div></div></section>
@code {
    [SupplyParameterFromQuery(Name="token")] public string? Token { get; set; }
    private readonly PasswordForm _model = new(); private bool _busy; private bool _completed; private string? _error;
    private async Task SubmitAsync() { _error=null; if (string.IsNullOrWhiteSpace(Token)) { _error="The password reset token is missing."; return; } _busy=true; try { await Sender.Send(new LevelUp.Application.Features.Identity.Commands.ResetPasswordCommand(new(Token,_model.Password,_model.ConfirmPassword))); _completed=true; } catch(Exception ex) { _error=ex.Message; } finally { _busy=false; } }
    private sealed class PasswordForm { [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MinLength(8)] public string Password { get; set; }=string.Empty; [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage="Passwords do not match.")] public string ConfirmPassword { get; set; }=string.Empty; }
}
