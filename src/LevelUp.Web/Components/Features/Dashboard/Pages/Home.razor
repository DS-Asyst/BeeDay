@page "/daily"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticatedUserInitializer UserInitializer
@inject LevelUp.Web.Components.Features.Dashboard.State.DashboardState State
@inject NavigationManager Navigation

<PageTitle>Dashboard | LevelUp</PageTitle>

@if (State.IsLoading)
{
    <LevelUpDashboardSkeleton />
}
else if (State.Data?.CurrentCharacter is not null)
{
    <section class="dashboard-page levelup-fade-in">
        <div class="dashboard-page__content">
            <FilterBar Value="@State.Search" ValueChanged="@(value => State.Search = value)" Attribute="@State.AttributeFilter" AttributeChanged="@(value => State.AttributeFilter = value)" Sort="@State.SortOption" SortChanged="@(value => State.SortOption = value)" ResultCount="@State.FilteredItems" TotalCount="@State.TotalItems" OnCreate="State.OpenCreate" />
            <div class="dashboard-grid">
                @{ var habits = State.FilteredHabits.ToList(); }
                <DashboardColumn Title="Habits"
                                 EmptyLabel="habits"
                                 SingularLabel="Habit"
                                 ActiveCount="@habits.Count"
                                 ShowCompletedSection="false"
                                 OnCreate="@(() => State.OpenCreate(ActivityType.Habit))">
                    <ActiveContent>
                        <LevelUpSortable ItemIds="@habits.Select(item => item.Id).ToList()"
                                         CollectionKey="habits"
                                         AriaLabel="Reorder habits"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderHabitsAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = habits.First(candidate => candidate.Id == itemId); }
                                <HabitCard Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Direction="@item.Direction" PositiveCount="@item.PositiveCount" NegativeCount="@item.NegativeCount" Featured="@item.Featured" SearchTerm="@State.Search" OnPositive="@(() => State.RegisterPositiveAsync(item.Id))" OnNegative="@(() => State.RegisterNegativeAsync(item.Id))" OnEdit="@(() => State.OpenHabitEditor(item))" OnDelete="@(() => State.RequestDelete(item.Id, ActivityType.Habit, item.Title))" />
                            </ItemTemplate>
                        </LevelUpSortable>
                    </ActiveContent>
                </DashboardColumn>

                @{
                    var filteredTasks = State.FilteredTasks.ToList();
                    var activeTasks = filteredTasks.Where(item => !item.Completed).ToList();
                    var completedTasks = filteredTasks.Where(item => item.Completed).ToList();
                }
                <DashboardColumn Title="Tasks"
                                 EmptyLabel="tasks"
                                 SingularLabel="Task"
                                 ActiveCount="@activeTasks.Count"
                                 CompletedCount="@completedTasks.Count"
                                 OnCreate="@(() => State.OpenCreate(ActivityType.Task))">
                    <ActiveContent>
                        <LevelUpSortable ItemIds="@activeTasks.Select(item => item.Id).ToList()"
                                         CollectionKey="tasks"
                                         AriaLabel="Reorder active tasks"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderTasksAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = activeTasks.First(candidate => candidate.Id == itemId); }
                                <ActivityPreviewCard Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Meta="@State.FormatRepeat(item.Repeat)" Variant="task" Completed="false" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTaskAsync(item.Id))" OnEdit="@(() => State.OpenTaskEditor(item))" OnDelete="@(() => State.RequestDelete(item.Id, ActivityType.Task, item.Title))" />
                            </ItemTemplate>
                        </LevelUpSortable>
                    </ActiveContent>
                    <CompletedContent>
                        @foreach (var item in completedTasks)
                        {
                            <ActivityPreviewCard @key="item.Id" Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Meta="@State.FormatRepeat(item.Repeat)" Variant="task" Completed="true" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTaskAsync(item.Id))" OnEdit="@(() => State.OpenTaskEditor(item))" OnDelete="@(() => State.RequestDelete(item.Id, ActivityType.Task, item.Title))" />
                        }
                    </CompletedContent>
                </DashboardColumn>

                @{
                    var filteredTodos = State.FilteredTodos.ToList();
                    var activeTodos = filteredTodos.Where(item => !item.Completed).ToList();
                    var completedTodos = filteredTodos.Where(item => item.Completed).ToList();
                }
                <DashboardColumn Title="To-Dos"
                                 EmptyLabel="to-dos"
                                 SingularLabel="To-Do"
                                 ActiveCount="@activeTodos.Count"
                                 CompletedCount="@completedTodos.Count"
                                 ShowCreateButton="false">
                    <ActiveContent>
                        <LevelUpSortable ItemIds="@activeTodos.Select(item => item.Id).ToList()"
                                         CollectionKey="todos"
                                         AriaLabel="Reorder active to-dos"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderTodosAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = activeTodos.First(candidate => candidate.Id == itemId); }
                                <ActivityPreviewCard Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Meta="@State.FormatDueDate(item.DueDate)" Variant="todo" Completed="false" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTodoAsync(item.Id))" OnEdit="@(() => State.OpenTodoEditor(item))" OnDelete="@(() => State.RequestDelete(item.Id, ActivityType.Todo, item.Title))" />
                            </ItemTemplate>
                        </LevelUpSortable>
                    </ActiveContent>
                    <CompletedContent>
                        @foreach (var item in completedTodos)
                        {
                            <ActivityPreviewCard @key="item.Id" Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Meta="@State.FormatDueDate(item.DueDate)" Variant="todo" Completed="true" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTodoAsync(item.Id))" OnEdit="@(() => State.OpenTodoEditor(item))" OnDelete="@(() => State.RequestDelete(item.Id, ActivityType.Todo, item.Title))" />
                        }
                    </CompletedContent>
                </DashboardColumn>

                @{
                    var filteredProjects = State.FilteredProjects.ToList();
                    var activeProjects = filteredProjects.Where(item => !item.Completed).ToList();
                    var completedProjects = filteredProjects.Where(item => item.Completed).ToList();
                }
                <DashboardColumn Title="Projects"
                                 EmptyLabel="projects"
                                 SingularLabel="Project"
                                 ActiveCount="@activeProjects.Count"
                                 CompletedCount="@completedProjects.Count"
                                 OnCreate="@(() => State.OpenCreate(ActivityType.Project))">
                    <ActiveContent>
                        <LevelUpSortable ItemIds="@activeProjects.Select(item => item.Id).ToList()"
                                         CollectionKey="projects"
                                         AriaLabel="Reorder active projects"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderProjectsAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = activeProjects.First(candidate => candidate.Id == itemId); }
                                <ActivityPreviewCard Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Meta="@($"{State.FormatProjectStatus(item.Status)} · {item.Progress:0.##}%")" Variant="project" Completed="false" Featured="@item.Featured" SearchTerm="@State.Search" OnOpen="@(() => State.OpenProjectWorkspace(item))" OnEdit="@(() => State.OpenProjectEditor(item))" OnDelete="@(() => State.RequestDelete(item.Id, ActivityType.Project, item.Title))" />
                            </ItemTemplate>
                        </LevelUpSortable>
                    </ActiveContent>
                    <CompletedContent>
                        @foreach (var item in completedProjects)
                        {
                            <ActivityPreviewCard @key="item.Id" Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Meta="@($"{State.FormatProjectStatus(item.Status)} · {item.Progress:0.##}%")" Variant="project" Completed="true" Featured="@item.Featured" SearchTerm="@State.Search" OnOpen="@(() => State.OpenProjectWorkspace(item))" OnEdit="@(() => State.OpenProjectEditor(item))" OnDelete="@(() => State.RequestDelete(item.Id, ActivityType.Project, item.Title))" />
                        }
                    </CompletedContent>
                </DashboardColumn>
            </div>
        </div>
    </section>

    @if (State.OpenProject is not null)
    {
        <ProjectWorkspace Project="State.OpenProject"
                          OnClose="State.CloseProjectWorkspace"
                          OnAddTodo="State.OpenTodoForProject" />
    }

    @if (State.Modals.IsHabitEditorOpen) { <HabitEditorModal Model="State.Modals.HabitForm" IsEditing="State.Modals.IsEditing" OnSave="State.SaveHabitAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentHabitAsync" /> }
    @if (State.Modals.IsTaskEditorOpen) { <TaskEditorModal Model="State.Modals.TaskForm" IsEditing="State.Modals.IsEditing" OnSave="State.SaveTaskAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentTaskAsync" /> }
    @if (State.Modals.IsTodoEditorOpen) { <TodoEditorModal Model="State.Modals.TodoForm" Projects="@(State.Data?.Projects ?? [])" IsEditing="State.Modals.IsEditing" OnSave="State.SaveTodoAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentTodoAsync" /> }
    @if (State.Modals.IsProjectEditorOpen) { <ProjectEditorModal Model="State.Modals.ProjectForm" IsEditing="State.Modals.IsEditing" OnSave="State.SaveProjectAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentProjectAsync" /> }

    <LevelUpConfirmDialog IsOpen="State.Modals.IsDeleteConfirmationOpen"
                          IsBusy="State.IsBusy"
                          Title="@($"Delete {State.Modals.DeleteItemDisplayName}")"
                          Message="@($"Are you sure you want to delete this {State.Modals.DeleteItemDisplayName.ToLowerInvariant()}?")"
                          ItemTitle="@State.Modals.PendingDeleteTitle"
                          Warning="This action cannot be undone."
                          WarningDetails="All information will be permanently removed."
                          ConfirmLabel="@($"Delete {State.Modals.DeleteItemDisplayName}")"
                          OnConfirm="State.ConfirmDeleteAsync"
                          OnCancel="State.CancelDelete" />

    <LevelUpLoading IsVisible="State.IsBusy" Label="Saving..." />
    <LevelUpFeedbackHost />
}
