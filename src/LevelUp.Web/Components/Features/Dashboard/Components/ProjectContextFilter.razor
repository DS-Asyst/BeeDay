@using LevelUp.Domain.Entities

<div class="project-context-filter">
    <button type="button"
            class="project-context-filter__trigger"
            @onclick="ToggleMenu"
            aria-haspopup="listbox"
            aria-expanded="@isOpen.ToString().ToLowerInvariant()"
            aria-label="Filter Projects"
            title="Filter Projects">
        <PixelIcon Name="PixelIconName.Project" Size="PixelIconSize.Small" Decorative="true" />
    </button>

    @if (isOpen)
    {
        <div class="project-context-filter__menu" role="listbox" aria-label="Projects">
            <button type="button"
                    role="option"
                    aria-selected="@(SelectedProjectId is null)"
                    class="project-context-filter__option @(SelectedProjectId is null ? "project-context-filter__option--selected" : null)"
                    @onclick="@(() => SelectAsync(null))">
                All Projects
            </button>
            @foreach (var project in Projects)
            {
                <button type="button"
                        role="option"
                        aria-selected="@(SelectedProjectId == project.Id)"
                        class="project-context-filter__option @(SelectedProjectId == project.Id ? "project-context-filter__option--selected" : null)"
                        @onclick="@(() => SelectAsync(project.Id))">
                    @project.Title
                </button>
            }
        </div>
    }
</div>
