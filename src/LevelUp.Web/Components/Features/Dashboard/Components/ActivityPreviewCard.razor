<LevelUpCard Class="@CardCssClass">
    <div class="activity-card__rail">
        <button class="activity-card__checkbox"
                type="button"
                aria-label="@(Completed ? $"Mark {Title} as incomplete" : $"Complete {Title}")"
                @onclick="OnToggle">
            <span aria-hidden="true">✓</span>
        </button>
    </div>

    <div class="activity-card__body">
        <div class="activity-card__title-row">
            @if (Featured)
            {
                <span class="activity-card__star">★</span>
            }
            <h3><SearchHighlight Text="@Title" SearchTerm="@SearchTerm" /></h3>
        </div>

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p><SearchHighlight Text="@Description" SearchTerm="@SearchTerm" /></p>
        }

        @if (!string.IsNullOrWhiteSpace(Meta))
        {
            <span class="activity-card__meta">@Meta</span>
        }
    </div>

    <LevelUpCardMenu Class="activity-card__actions"
                     TriggerClass="activity-card__menu"
                     Title="@Title"
                     OnEdit="@OnEdit"
                     OnDelete="@OnDelete"
                     OpenChanged="HandleMenuOpenChanged" />
</LevelUpCard>
