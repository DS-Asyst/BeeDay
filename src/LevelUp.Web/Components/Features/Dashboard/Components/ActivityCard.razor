<LevelUpCard Class="@CardCssClass">
    <div class="activity-card__rail">
        @if (OnToggle.HasDelegate)
        {
            <button class="activity-card__checkbox"
                    type="button"
                    aria-label="@(Completed ? $"Mark {Title} as incomplete" : $"Complete {Title}")"
                    @onclick="OnToggle">
                <PixelIcon Name="PixelIconName.Complete" Size="PixelIconSize.Small" Decorative="true" />
            </button>
        }
        else
        {
            <PixelIcon Name="PixelIconName.Project" Size="PixelIconSize.Small" Class="activity-card__project-status" Decorative="false" Label="Project progress is calculated automatically" />
        }
    </div>

    <div class="activity-card__body @(OnOpen.HasDelegate ? "activity-card__body--openable" : string.Empty)"
         role="@(OnOpen.HasDelegate ? "button" : null)"
         tabindex="@(OnOpen.HasDelegate ? "0" : null)"
         @onclick="OnOpen">
        <div class="activity-card__header">
            <div class="activity-card__title-row">
                @if (Featured)
                {
                    <PixelIcon Name="PixelIconName.Featured" Size="PixelIconSize.ExtraSmall" Class="activity-card__star" Decorative="false" Label="Featured" />
                }
                <h3><SearchHighlight Text="@Title" SearchTerm="@SearchTerm" /></h3>
            </div>

            <div class="activity-card__attribute">
                <ActivityAttributeBadge Attribute="@Attribute" />
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p><SearchHighlight Text="@Description" SearchTerm="@SearchTerm" /></p>
        }

        @if (!string.IsNullOrWhiteSpace(Meta))
        {
            <span class="activity-card__meta">@Meta</span>
        }
    </div>

    <LevelUpCardMenu Class="activity-card__actions"
                     TriggerClass="activity-card__menu"
                     Title="@Title"
                     OnEdit="@OnEdit"
                     OnDelete="@OnDelete"
                     OpenChanged="HandleMenuOpenChanged" />
</LevelUpCard>
