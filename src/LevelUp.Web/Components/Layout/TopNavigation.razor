<header class="top-navigation">
    <div class="top-navigation__content">
        <button type="button"
                class="top-navigation__brand-button"
                aria-label="@(IsCharacterPanelOpen ? "Fechar painel do personagem" : "Abrir painel do personagem")"
                aria-expanded="@IsCharacterPanelOpen"
                @onclick="OnToggleCharacterPanel">
            <span class="top-navigation__brand-text" aria-hidden="true">
                <span class="top-navigation__brand-level">LEVEL</span>
                <span class="top-navigation__brand-up">UP</span>
            </span>

            <span class="top-navigation__panel-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="m9 18 6-6-6-6"></path>
                </svg>
            </span>
        </button>

        <nav class="top-navigation__links" aria-label="Navegação principal">
            <NavLink href="/daily" Match="NavLinkMatch.Prefix">Daily</NavLink>
            <NavLink href="/" Match="NavLinkMatch.All">Inventory</NavLink>
        </nav>

        <div class="top-navigation__slogan">Gamifying your life!</div>

        <div class="top-navigation__actions @(IsMenuPanelOpen ? "is-menu-open" : null)">
            <button type="button"
                    class="top-navigation__menu-button"
                    aria-label="@(IsMenuPanelOpen ? "Fechar menu de suporte" : "Abrir menu de suporte")"
                    aria-expanded="@IsMenuPanelOpen"
                    @onclick="OnToggleMenuPanel">
                <span class="top-navigation__menu-icon" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
            </button>
        </div>
    </div>
</header>

@code {
    [Parameter] public bool IsCharacterPanelOpen { get; set; }
    [Parameter] public bool IsMenuPanelOpen { get; set; }
    [Parameter] public EventCallback OnToggleCharacterPanel { get; set; }
    [Parameter] public EventCallback OnToggleMenuPanel { get; set; }
}
