@implements IDisposable
@inject LevelUp.Web.Components.Features.Dashboard.State.DashboardState State

<aside class="side-drawer side-drawer--left @(IsOpen ? "is-open" : null)"
       aria-label="Character panel"
       aria-hidden="@(!IsOpen)">
    <section class="character-drawer">
        @if (State.IsLoading)
        {
            <div class="character-drawer__loading">Loading character...</div>
        }
        else if (State.Data?.CurrentCharacter is not null && State.Data.CurrentUser is not null)
        {
            var character = State.Data.CurrentCharacter;
            var user = State.Data.CurrentUser;

            <div class="character-drawer__profile">
                <div class="character-drawer__avatar">
                    <img src="@GetClassImage(character.Class)" alt="@character.Class class" />
                </div>

                <div class="character-drawer__identity">
                    <span>Character</span>
                    <h2>@user.Name</h2>
                    <p>@($"@{character.Nickname} · {character.Class}")</p>
                </div>
            </div>

            <div class="character-drawer__statistics" aria-label="Activity summary">
                <div>
                    <span>Active</span>
                    <strong>@State.ActiveItems</strong>
                </div>
                <div>
                    <span>Completed</span>
                    <strong>@State.CompletedItems</strong>
                </div>
            </div>

            <NavLink href="/character/create" class="character-drawer__link" @onclick="OnClose">
                View character
            </NavLink>
        }
        else
        {
            <div class="character-drawer__empty">
                <strong>No character created</strong>
                <span>Create your character to track your progress.</span>
                <NavLink href="/character/create" class="character-drawer__link" @onclick="OnClose">
                    Create character
                </NavLink>
            </div>
        }
    </section>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += HandleStateChanged;
        if (State.Data is null)
        {
            await State.InitializeAsync();
        }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private static string GetClassImage(CharacterClass characterClass) =>
        $"/images/classes/classicon_{characterClass.ToString().ToLowerInvariant()}.jpg";

    public void Dispose() => State.Changed -= HandleStateChanged;
}
