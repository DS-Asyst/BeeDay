@implements IDisposable
@using LevelUp.Web.Components.Features.Character.Models
@inject LevelUp.Web.Components.Features.Dashboard.State.DashboardState State

<aside class="side-drawer side-drawer--left @(IsOpen ? "is-open" : null)"
       aria-label="Character panel"
       aria-hidden="@(!IsOpen)">
    <section class="character-drawer">
        @if (State.IsLoading)
        {
            <div class="character-drawer__loading">
                <span><PixelIcon Name="PixelIconName.Loading" Size="PixelIconSize.Small" /> Loading character...</span>
                <CharacterExperienceBar IsLoading="true" />
            </div>
        }
        else if (State.Data?.CurrentCharacter is not null && State.Data.CurrentUser is not null)
        {
            var character = State.Data.CurrentCharacter;
            var user = State.Data.CurrentUser;

            <div class="character-drawer__profile">
                <NavLink href="/character/create"
                         class="character-drawer__avatar"
                         aria-label="View character details"
                         @onclick="OnClose">
                    <img src="@GetClassImage(character.Class)" alt="@character.Class class" />
                </NavLink>

                <div class="character-drawer__identity">
                    <h2>@user.Name</h2>
                    <div class="character-drawer__identity-details">
                        <strong>@($"@{character.Nickname}")</strong>
                        <span>@character.Class</span>
                    </div>
                </div>
            </div>

            <div class="character-drawer__experience-card">
                <CharacterExperienceBar Model="CharacterExperienceViewModel.From(character.Experience)"
                                        ExperienceGain="State.LatestExperienceGain"
                                        FeedbackKey="State.ExperienceFeedbackVersion" />
            </div>
        }
        else
        {
            <div class="character-drawer__empty">
                <strong>No character created</strong>
                <span>Create your character to track your progress.</span>
                <NavLink href="/character/create" class="character-drawer__link" @onclick="OnClose">
                    <PixelIcon Name="PixelIconName.Add" Size="PixelIconSize.Small" /> Create character
                </NavLink>
            </div>
        }
    </section>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += HandleStateChanged;
        if (State.Data is null)
        {
            await State.InitializeAsync();
        }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private static string GetClassImage(CharacterClass characterClass) =>
        $"/images/classes/classicon_{characterClass.ToString().ToLowerInvariant()}.png";

    public void Dispose() => State.Changed -= HandleStateChanged;
}
