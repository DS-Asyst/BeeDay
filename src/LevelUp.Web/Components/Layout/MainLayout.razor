@inject AuthenticatedUserInitializer AuthenticatedUserInitializer
@inherits LayoutComponentBase

<div class="levelup-app">
    <TopNavigation IsCharacterPanelOpen="@_isCharacterPanelOpen"
                   IsMenuPanelOpen="@_isMenuPanelOpen"
                   OnToggleCharacterPanel="ToggleCharacterPanel"
                   OnToggleMenuPanel="ToggleMenuPanel" />

    <div class="levelup-workspace @GetWorkspaceClass()">
        <div class="levelup-side-slot levelup-side-slot--left">
            <CharacterSidePanel IsOpen="@_isCharacterPanelOpen" OnClose="ClosePanels" />
        </div>

        <div class="levelup-content-shell">
            <main class="levelup-main">
                @Body
            </main>

            <AppFooter />
        </div>

        <div class="levelup-side-slot levelup-side-slot--right">
            <AccountSidePanel IsOpen="@_isMenuPanelOpen" OnClose="ClosePanels" />
        </div>
    </div>

    <LevelUpToastHost />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthenticatedUserInitializer.EnsureInitializedAsync();
    }

    private bool _isCharacterPanelOpen;
    private bool _isMenuPanelOpen;

    private void ToggleCharacterPanel()
    {
        _isCharacterPanelOpen = !_isCharacterPanelOpen;
        _isMenuPanelOpen = false;
    }

    private void ToggleMenuPanel()
    {
        _isMenuPanelOpen = !_isMenuPanelOpen;
        _isCharacterPanelOpen = false;
    }

    private void ClosePanels()
    {
        _isCharacterPanelOpen = false;
        _isMenuPanelOpen = false;
    }

    private string GetWorkspaceClass() =>
        _isCharacterPanelOpen
            ? "has-left-panel"
            : _isMenuPanelOpen
                ? "has-right-panel"
                : string.Empty;
}
