{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "LevelUp.Infrastructure.Persistence.Json.JsonBackupService": "Information"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "LevelUp": {
    "Persistence": {
      "SqlServer": {
        "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=LevelUpDev;Trusted_Connection=True;TrustServerCertificate=True;"
      }
    },
    "Storage": {
      "Directory": "Data",
      "FileName": "LevelUpBD.json",
      "BackupDirectory": "Backups",
      "BackupRetention": 10,
      "CreateBackupBeforeSave": true,
      "RecoverFromBackup": true,
      "WriteIndented": true
    },
    "IdentityEmail": {
      "PublicBaseUrl": "http://localhost:5059",
      "ConfirmationPath": "/account/confirm-email",
      "PasswordResetPath": "/account/reset-password"
    },
    "Email": {
      "Resend": {
        "Enabled": false,
        "ApiKey": "",
        "FromName": "LevelUp",
        "FromAddress": ""
      },
      "Development": {
        "Enabled": true,
        "Directory": "Data/Emails"
      }
    }
  }
}
