{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "LevelUp.Infrastructure.Persistence.Json.JsonBackupService": "Information"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "LevelUp": {
    "Storage": {
      "Directory": "Data",
      "FileName": "LevelUpBD.json",
      "BackupDirectory": "Backups",
      "BackupRetention": 10,
      "CreateBackupBeforeSave": true,
      "RecoverFromBackup": true,
      "WriteIndented": true
    },
    "IdentityEmail": {
      "PublicBaseUrl": "https://localhost:5001",
      "ConfirmationPath": "/account/confirm-email",
      "PasswordResetPath": "/account/reset-password"
    },
    "Email": {
      "Resend": {
        "Enabled": false,
        "ApiKey": "",
        "FromName": "LevelUp",
        "FromAddress": ""
      }
    }
  }
}
