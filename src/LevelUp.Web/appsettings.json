{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LevelUp": {
    "Storage": {
      "Directory": "Data",
      "FileName": "LevelUpBD.json",
      "BackupDirectory": "Backups",
      "BackupRetention": 10,
      "CreateBackupBeforeSave": true,
      "RecoverFromBackup": true,
      "WriteIndented": true
    }
  }
}
