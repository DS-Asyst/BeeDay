<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BeeDay.Infrastructure</AssemblyName>
    <RootNamespace>BeeDay.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../BeeDay.Application/BeeDay.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets Infrastructure.Tests construct internal SQL Server adapters directly (e.g. Ef*Repository,
         EfDashboardReadService, EfWalletReadService) to validate the real adapter, per
         docs/testing/01-testing-strategy.md. Concrete adapter types stay internal to the rest of the
         solution — only these test assemblies are declared friends. Web.Tests/E2E.Tests need
         BeeDayDbContext specifically (internal) to apply/tear down each test's disposable LocalDB
         database from BeeDayWebApplicationFactory/E2EWebApplicationFactory. -->
    <InternalsVisibleTo Include="BeeDay.Infrastructure.Tests" />
    <InternalsVisibleTo Include="BeeDay.Web.Tests" />
    <InternalsVisibleTo Include="BeeDay.E2E.Tests" />
  </ItemGroup>
</Project>
