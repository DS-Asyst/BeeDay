<div class="beeday-empty-state @Class" role="status">
    @if (Icon is not null)
    {
        <span class="beeday-empty-state__icon" aria-hidden="true">
            <PixelIcon Name="@Icon.Value" Size="PixelIconSize.ExtraLarge" Color="PixelIconColor.Muted" Decorative="true" />
        </span>
    }

    <div class="beeday-empty-state__content">
        <h3 class="beeday-empty-state__title">@Title</h3>
        <p class="beeday-empty-state__description">@Description</p>
    </div>
</div>
