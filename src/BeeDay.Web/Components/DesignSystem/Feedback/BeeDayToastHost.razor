@implements IDisposable
@inject ToastService ToastService

<div class="levelup-toast-region"
     aria-live="polite"
     aria-label="Notifications">
    @foreach (var toast in ToastService.Messages)
    {
        <article class="levelup-toast levelup-toast--@VariantClass(toast.Variant)"
                 role="@RoleFor(toast.Variant)">
            <span class="levelup-toast__icon" aria-hidden="true"><PixelIcon Name="@IconFor(toast.Variant)" Size="PixelIconSize.Small" /></span>
            <div class="levelup-toast__content">
                <strong>@toast.Title</strong>
                <p>@toast.Message</p>
            </div>
            <button class="levelup-toast__close"
                    type="button"
                    aria-label="Dismiss notification"
                    @onclick="() => ToastService.Remove(toast.Id)">
                <PixelIcon Name="PixelIconName.Close" Size="PixelIconSize.ExtraSmall" />
            </button>
        </article>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.Changed += HandleChanged;
    }

    public void Dispose()
    {
        ToastService.Changed -= HandleChanged;
    }

    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);

    private static string VariantClass(ToastVariant variant) => variant switch
    {
        ToastVariant.Success => "success",
        ToastVariant.Error => "error",
        _ => "info"
    };

    private static PixelIconName IconFor(ToastVariant variant) => variant switch
    {
        ToastVariant.Success => PixelIconName.Success,
        ToastVariant.Error => PixelIconName.ValidationError,
        _ => PixelIconName.Information
    };

    private static string RoleFor(ToastVariant variant) =>
        variant == ToastVariant.Error ? "alert" : "status";
}
