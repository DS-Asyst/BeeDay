@typeparam TModel

<EditForm Model="Model" OnValidSubmit="HandleValidSubmitAsync" FormName="@FormName">
    <DataAnnotationsValidator />
    <fieldset class="levelup-settings-form" disabled="@IsBusy">
        @ChildContent
        <div class="levelup-settings-form__actions">
            <BeeDayButton Type="submit" IsLoading="@IsBusy" Disabled="@IsBusy" Class="@SubmitButtonClass">
                @SubmitLabel
            </BeeDayButton>
        </div>
    </fieldset>
</EditForm>
