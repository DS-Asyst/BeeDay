@inject IJSRuntime JS
@inject BeeDay.Web.Services.CardActionMenuCoordinator Coordinator

<div class="@MenuCssClass" @ref="rootElement" @onkeydown="HandleKeyDown">
    <button type="button"
            @ref="triggerElement"
            class="@TriggerCssClass"
            title="@Title"
            aria-label="@AriaLabel"
            aria-expanded="@isOpen.ToString().ToLowerInvariant()"
            disabled="@Disabled"
            @onclick="ToggleMenu"
            @onclick:stopPropagation>
        <BeeDayIcon Name="BeeDayIconName.More" Size="BeeDayIconSize.Medium" Decorative="true" />
    </button>

    @if (isOpen)
    {
        <div class="card-action-menu__panel @(flipUp ? "card-action-menu__panel--flip-up" : null) @(isMeasuring ? "card-action-menu__panel--measuring" : null)"
             style="@(horizontalShiftPx == 0 ? null : $"transform: translateX({horizontalShiftPx.ToString(System.Globalization.CultureInfo.InvariantCulture)}px)")"
             @ref="panelElement"
             role="menu">
            <button type="button"
                    class="card-action-menu__item"
                    role="menuitem"
                    @onclick="EditAsync">
                <BeeDayIcon Name="BeeDayIconName.Edit" Size="BeeDayIconSize.Small" Decorative="true" />
                <span>EDIT</span>
            </button>

            <button type="button"
                    class="card-action-menu__item card-action-menu__item--delete"
                    role="menuitem"
                    @onclick="DeleteAsync">
                <BeeDayIcon Name="BeeDayIconName.Delete" Size="BeeDayIconSize.Small" Decorative="true" />
                <span>DELETE</span>
            </button>
        </div>
    }
</div>
