@using System.Globalization
@inject IStringLocalizer<DesignSystemResources> Localizer

<div class="beeday-progress" data-state="@State" data-tone="@Tone.ToString().ToLowerInvariant()">
    <div class="beeday-progress__heading">
        <span>@Label</span>
        @if (!string.IsNullOrWhiteSpace(ValueText))
        {
            <span class="beeday-progress__value">@ValueText</span>
        }
    </div>
    <div class="beeday-progress__track"
         role="progressbar"
         aria-label="@Label"
         aria-valuemin="0"
         aria-valuemax="@AccessibleMaximum"
         aria-valuenow="@AccessibleValue"
         aria-valuetext="@AccessibleValueText">
        <div class="beeday-progress__fill" style="@FillStyle">
            <span class="beeday-progress__marker" aria-hidden="true"></span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public double Value { get; set; }
    [Parameter] public double Maximum { get; set; } = 100d;
    [Parameter] public string? ValueText { get; set; }
    [Parameter] public BeeDayProgressTone Tone { get; set; } = BeeDayProgressTone.Primary;

    private bool HasValidMaximum => double.IsFinite(Maximum) && Maximum > 0d;
    private double SafeValue => double.IsFinite(Value) ? Value : 0d;
    private double AccessibleMaximum => HasValidMaximum ? Maximum : 1d;
    private double AccessibleValue => HasValidMaximum ? Math.Clamp(SafeValue, 0d, Maximum) : 0d;
    private double Percentage => AccessibleValue * 100d / AccessibleMaximum;
    private string State => !HasValidMaximum ? "unavailable" : Percentage >= 100d ? "complete" : Percentage <= 0d ? "empty" : "partial";
    private string AccessibleValueText => HasValidMaximum
        ? ValueText ?? Localizer["ProgressValueText", AccessibleValue.ToString("0.##"), Maximum.ToString("0.##")]
        : Localizer["ProgressUnavailable"];
    private string FillStyle => $"width: {Percentage.ToString("0.##", CultureInfo.InvariantCulture)}%";
}
