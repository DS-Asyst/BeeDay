@using System.Linq.Expressions

<label class="@FieldCssClass" for="@Id">
    <InputCheckbox id="@Id"
                   class="@InputCssClass"
                   Value="Value"
                   ValueChanged="ValueChanged"
                   ValueExpression="ValueExpression"
                   disabled="@Disabled"
                   @attributes="AdditionalAttributes" />
    <span class="levelup-checkbox__visual" aria-hidden="true">
        <PixelIcon Name="PixelIconName.CheckboxUnchecked" Size="PixelIconSize.Small" Class="levelup-checkbox__unchecked" />
        <PixelIcon Name="PixelIconName.CheckboxChecked" Size="PixelIconSize.Small" Color="PixelIconColor.Primary" Class="levelup-checkbox__checked" />
    </span>
    <span class="@LabelCssClass">@Label</span>
</label>
@if (ShowValidationMessage)
{
    <LevelUpValidationMessage For="ValueExpression" />
}
