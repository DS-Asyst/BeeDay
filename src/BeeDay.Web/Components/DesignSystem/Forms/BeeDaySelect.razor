@typeparam TValue
@using System.Linq.Expressions

<label class="@FieldCssClass" for="@Id">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="@LabelCssClass">
            @Label
            @if (Required)
            {
                <span aria-hidden="true">*</span>
            }
        </span>
    }
    <span class="levelup-field__control-shell">
        <InputSelect TValue="TValue"
                     id="@Id"
                     class="@($"{InputCssClass} levelup-field__control--select")"
                     Value="Value"
                     ValueChanged="ValueChanged"
                     ValueExpression="ValueExpression"
                     disabled="@Disabled"
                     @attributes="AdditionalAttributes">
            @ChildContent
        </InputSelect>
        <PixelIcon Name="PixelIconName.Select" Size="PixelIconSize.Small" Color="PixelIconColor.Muted" Class="levelup-field__control-icon" />
    </span>
</label>
@if (ShowValidationMessage)
{
    <BeeDayValidationMessage For="ValueExpression" />
}
