<div class="editor-modal-backdrop" @onclick="Cancel" @onkeydown="HandleKeyDown" tabindex="-1">
    <section class="editor-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@TitleId"
             aria-busy="@IsBusy.ToString().ToLowerInvariant()"
             @onclick:stopPropagation>
        <EditForm Model="Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            <header class="editor-modal__header">
                <h2 id="@TitleId">@Title</h2>
                <BeeDayButton Type="submit"
                               Variant="BeeDayButtonVariant.Primary"
                               Icon="BeeDayIconName.Save"
                               Disabled="IsBusy"
                               IsLoading="IsBusy"
                               Class="editor-modal__submit-action editor-modal__header-save">@SubmitLabel</BeeDayButton>
            </header>

            <div class="editor-modal__content">
                @HeroContent
                @BodyContent
            </div>

            <footer class="editor-modal__footer">
                <div class="editor-modal__footer-danger">
                    @if (ShowDelete)
                    {
                        <BeeDayButton Variant="BeeDayButtonVariant.Danger"
                                       Disabled="IsBusy"
                                       Compact="true"
                                       Class="editor-modal__delete-action"
                                       OnClick="OnDelete">Delete</BeeDayButton>
                    }
                </div>

                <div class="editor-modal__footer-actions">
                    @SecondaryAction
                    <BeeDayButton Variant="BeeDayButtonVariant.ConfirmationCancel"
                                   Disabled="IsBusy"
                                   Class="editor-modal__cancel-action"
                                   OnClick="Cancel">Cancel</BeeDayButton>
                </div>
            </footer>
        </EditForm>
    </section>
</div>
