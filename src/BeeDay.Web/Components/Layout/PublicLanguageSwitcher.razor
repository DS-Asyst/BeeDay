@inject PublicHomeLanguageState LanguageState
@implements IDisposable

<div class="public-language-switcher" role="group" aria-label="Language">
    <button type="button"
            class="public-language-switcher__option @(IsActive(UserLanguage.Portuguese) ? "public-language-switcher__option--active" : null)"
            aria-pressed="@AriaPressed(UserLanguage.Portuguese)"
            aria-label="Português (Brasil)"
            @onclick="() => Select(UserLanguage.Portuguese)">
        <img class="public-language-switcher__flag" src="/assets/flags/brazil.png" alt="" width="612" height="408" />
    </button>
    <button type="button"
            class="public-language-switcher__option @(IsActive(UserLanguage.English) ? "public-language-switcher__option--active" : null)"
            aria-pressed="@AriaPressed(UserLanguage.English)"
            aria-label="English (United States)"
            @onclick="() => Select(UserLanguage.English)">
        <img class="public-language-switcher__flag" src="/assets/flags/united-states.png" alt="" width="612" height="408" />
    </button>
</div>

@code {
    protected override void OnInitialized() => LanguageState.Changed += HandleChanged;

    private bool IsActive(UserLanguage language) => LanguageState.Language == language;

    private string AriaPressed(UserLanguage language) => IsActive(language) ? "true" : "false";

    private void Select(UserLanguage language) => LanguageState.SetLanguage(language);

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => LanguageState.Changed -= HandleChanged;
}
