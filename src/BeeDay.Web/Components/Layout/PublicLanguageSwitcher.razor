@using System.Globalization
@using BeeDay.Web.Localization
@inject NavigationManager Navigation

<form method="post" action="/culture/set" class="public-language-switcher" role="group" aria-label="Language">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    <button type="submit"
            name="culture"
            value="@BeeDayCultures.Portuguese"
            class="public-language-switcher__option @(IsActive(BeeDayCultures.Portuguese) ? "public-language-switcher__option--active" : null)"
            aria-pressed="@AriaPressed(BeeDayCultures.Portuguese)"
            aria-label="Português (Brasil)">
        <img class="public-language-switcher__flag" src="/assets/flags/brazil.png" alt="" width="612" height="408" />
    </button>
    <button type="submit"
            name="culture"
            value="@BeeDayCultures.English"
            class="public-language-switcher__option @(IsActive(BeeDayCultures.English) ? "public-language-switcher__option--active" : null)"
            aria-pressed="@AriaPressed(BeeDayCultures.English)"
            aria-label="English (United States)">
        <img class="public-language-switcher__flag" src="/assets/flags/united-states.png" alt="" width="612" height="408" />
    </button>
</form>

@code {
    private string ReturnUrl => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    private static bool IsActive(string culture) =>
        string.Equals(CultureInfo.CurrentUICulture.Name, culture, StringComparison.OrdinalIgnoreCase);

    private static string AriaPressed(string culture) => IsActive(culture) ? "true" : "false";
}
