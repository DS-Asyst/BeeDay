<div class="mobile-nav-backdrop @(IsOpen ? "is-open" : null)" aria-hidden="true" @onclick="OnClose"></div>

<aside id="mobile-navigation"
       class="mobile-nav-drawer @(IsOpen ? "is-open" : null)"
       aria-label="Primary navigation"
       aria-hidden="@AriaHiddenValue"
       @onkeydown="HandleKeyDown">
    <div class="mobile-nav-drawer__header">
        <NavLink href="/home" Match="NavLinkMatch.Prefix" class="mobile-nav-drawer__brand" @onclick="HandleNavigate">
            <BeeDayBrand OnDarkSurface="true" />
        </NavLink>

        <button type="button" class="mobile-nav-drawer__close" aria-label="Close" @onclick="OnClose" @ref="closeButtonElement">
            <BeeDayIcon Name="BeeDayIconName.Close" Size="BeeDayIconSize.Large" />
        </button>
    </div>

    <NavigationItems IsProfilePanelOpen="IsProfilePanelOpen"
                      IsMenuPanelOpen="IsMenuPanelOpen"
                      OnToggleProfilePanel="OnToggleProfilePanel"
                      OnToggleMenuPanel="OnToggleMenuPanel"
                      OnNavigate="HandleNavigate" />
</aside>
