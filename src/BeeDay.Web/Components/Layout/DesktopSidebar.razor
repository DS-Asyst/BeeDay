<aside class="desktop-sidebar" aria-label="Primary navigation">
    <NavLink href="/home" Match="NavLinkMatch.Prefix" class="desktop-sidebar__brand-link" aria-label="BeeDay — go to Home">
        <BeeDayBrand OnDarkSurface="true" />
    </NavLink>

    <NavigationItems IsProfilePanelOpen="IsProfilePanelOpen"
                      IsMenuPanelOpen="IsMenuPanelOpen"
                      OnToggleProfilePanel="OnToggleProfilePanel"
                      OnToggleMenuPanel="OnToggleMenuPanel" />
</aside>

@code {
    [Parameter] public bool IsProfilePanelOpen { get; set; }
    [Parameter] public bool IsMenuPanelOpen { get; set; }
    [Parameter] public EventCallback OnToggleProfilePanel { get; set; }
    [Parameter] public EventCallback OnToggleMenuPanel { get; set; }
}
