<aside class="support-drawer @(IsOpen ? "is-open" : null)"
       aria-label="Support and account menu"
       aria-hidden="@(!IsOpen)">
    <nav class="support-drawer__navigation" aria-label="Menu options">
        <button type="button" class="support-drawer__item" @onclick="OnClose">
            <span class="support-drawer__icon" aria-hidden="true">
                <PixelIcon Name="PixelIconName.Support" Size="PixelIconSize.ExtraLarge" />
            </span>
            <span class="support-drawer__copy">
                <strong>SUPPORT</strong>
                <small>Get help quickly.</small>
            </span>
        </button>

        <a href="/account" class="support-drawer__item">
            <span class="support-drawer__icon" aria-hidden="true">
                <PixelIcon Name="PixelIconName.Account" Size="PixelIconSize.ExtraLarge" />
            </span>
            <span class="support-drawer__copy">
                <strong>MY ACCOUNT</strong>
                <small>Manage your account in one place.</small>
            </span>
        </a>

        <form method="post" action="/auth/logout" class="support-drawer__logout-form">
            <AntiforgeryToken />
            <button type="submit" class="support-drawer__item">
            <span class="support-drawer__icon" aria-hidden="true">
                <PixelIcon Name="PixelIconName.Logout" Size="PixelIconSize.ExtraLarge" />
            </span>
            <span class="support-drawer__copy">
                <strong>LOGOUT</strong>
                <small>End your current session securely.</small>
            </span>
            </button>
        </form>

        <button type="button" class="support-drawer__item" @onclick="OnClose">
            <span class="support-drawer__icon" aria-hidden="true">
                <PixelIcon Name="PixelIconName.Donate" Size="PixelIconSize.ExtraLarge" />
            </span>
            <span class="support-drawer__copy">
                <strong>DONATE</strong>
                <small>Support the project and keep BeeDay alive.</small>
            </span>
        </button>
</nav>

    <footer class="support-drawer__brand">
        <p class="support-drawer__brand-mark">
            <BeeDayBrand />
        </p>
        <p class="support-drawer__tagline">GAMIFYING YOUR LIFE</p>
    </footer>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
