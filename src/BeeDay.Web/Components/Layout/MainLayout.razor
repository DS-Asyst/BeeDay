@inject AuthenticatedUserInitializer AuthenticatedUserInitializer
@inherits LayoutComponentBase

<div class="beeday-app">
    <MobileHeader IsNavOpen="@_isMobileNavOpen" OnToggleNav="ToggleMobileNav" />

    <div class="beeday-shell">
        <DesktopSidebar />

        <div class="beeday-workspace">
            <main class="beeday-main beeday-main--authenticated">
                @Body
            </main>
        </div>
    </div>

    <MobileSidebar IsOpen="@_isMobileNavOpen"
                   OnClose="CloseMobileNav" />

    <BeeDayToastHost />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthenticatedUserInitializer.EnsureInitializedAsync();
    }

    private bool _isMobileNavOpen;
    private void ToggleMobileNav() => _isMobileNavOpen = !_isMobileNavOpen;

    private void CloseMobileNav() => _isMobileNavOpen = false;
}
