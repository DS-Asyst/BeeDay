@inject AuthenticatedUserInitializer AuthenticatedUserInitializer
@inherits LayoutComponentBase

<div class="beeday-app">
    <TopNavigation IsProfilePanelOpen="@_isProfilePanelOpen"
                   IsMenuPanelOpen="@_isMenuPanelOpen"
                   OnToggleProfilePanel="ToggleProfilePanel"
                   OnToggleMenuPanel="ToggleMenuPanel" />

    <div class="beeday-shell">
        <DesktopSidebar IsProfilePanelOpen="@_isProfilePanelOpen"
                         IsMenuPanelOpen="@_isMenuPanelOpen"
                         OnToggleProfilePanel="ToggleProfilePanel"
                         OnToggleMenuPanel="ToggleMenuPanel" />

        <div class="beeday-workspace @GetWorkspaceClass()">
            <div class="beeday-side-slot beeday-side-slot--left">
                <ProfileSidePanel IsOpen="@_isProfilePanelOpen" OnClose="ClosePanels" />
            </div>

            <div class="beeday-content-shell">
                <main class="beeday-main">
                    @Body
                </main>

                <AppFooter />
            </div>

            <div class="beeday-side-slot beeday-side-slot--right">
                <AccountSidePanel IsOpen="@_isMenuPanelOpen" OnClose="ClosePanels" />
            </div>
        </div>

        <RightRail />
    </div>

    <BeeDayToastHost />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthenticatedUserInitializer.EnsureInitializedAsync();
    }

    private bool _isProfilePanelOpen;
    private bool _isMenuPanelOpen;

    private void ToggleProfilePanel()
    {
        _isProfilePanelOpen = !_isProfilePanelOpen;
        _isMenuPanelOpen = false;
    }

    private void ToggleMenuPanel()
    {
        _isMenuPanelOpen = !_isMenuPanelOpen;
        _isProfilePanelOpen = false;
    }

    private void ClosePanels()
    {
        _isProfilePanelOpen = false;
        _isMenuPanelOpen = false;
    }

    private string GetWorkspaceClass() =>
        _isProfilePanelOpen
            ? "has-left-panel"
            : _isMenuPanelOpen
                ? "has-right-panel"
                : string.Empty;
}
