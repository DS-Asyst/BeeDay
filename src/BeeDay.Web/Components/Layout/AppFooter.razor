        <div class="app-footer__identity">
            <img class="app-footer__brand-mark" src="/assets/brand/beeday-top-navigation.png" alt="BeeDay" width="866" height="288" />
            <p>@Localizer["FooterTagline"]</p>
        </div>

        <nav class="app-footer__links" aria-label="BeeDay links">
            <a href="https://github.com/tiagoarrigoni/BeeDay">Project on GitHub</a>
            <a href="https://www.linkedin.com/in/tiago-a-arrigoni-335b9413b/">LinkedIn</a>
        </nav>

        <p class="app-footer__copyright">© 2026 BeeDay. All rights reserved.</p>
    </div>
</footer>
