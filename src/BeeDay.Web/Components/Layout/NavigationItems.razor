@inject IStringLocalizer<LayoutResources> Localizer

<nav class="navigation-items" aria-label="@Localizer["NavMainLabel"]">
    <NavigationItem Icon="BeeDayIconName.Profile" Label="@Localizer["NavProfileLabel"]" Href="/profile" OnNavigate="OnNavigate" />
    <NavigationItem Icon="BeeDayIconName.Daily" Label="@Localizer["NavDailyLabel"]" Href="/daily" OnNavigate="OnNavigate" />
    <NavigationItem Icon="BeeDayIconName.Wallet" Label="@Localizer["NavWalletLabel"]" Href="/wallet" OnNavigate="OnNavigate" />
</nav>

<div class="navigation-items navigation-items--actions">
    <NavigationItem Icon="BeeDayIconName.Account"
                     Label="@Localizer["NavAccountLabel"]"
                     Href="/settings"
                     OnNavigate="OnNavigate" />

    <form method="post" action="/auth/logout" class="navigation-items__logout-form">
        <AntiforgeryToken />
        <NavigationItem Icon="BeeDayIconName.Logout"
                        Label="@Localizer["NavLogoutLabel"]"
                        AriaLabel="@Localizer["NavLogoutAriaLabel"]"
                        ButtonType="submit" />
    </form>
</div>

@code {
    /// <summary>Invoked after route navigation; closes the mobile drawer and is a no-op on desktop.</summary>
    [Parameter] public EventCallback OnNavigate { get; set; }
}
