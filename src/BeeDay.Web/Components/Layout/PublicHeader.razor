@using BeeDay.Web.Services.Authentication
<header class="public-header">
    <div class="public-header__content beeday-container">
        <a class="public-header__brand" href="/" aria-label="BeeDay home">
            <BeeDayBrand />
        </a>

        <AuthorizeView>
            <Authorized>
                <BeeDayButton Compact="true" Class="beeday-button--soft" OnClick="ContinueToBeeDay">Continue to BeeDay</BeeDayButton>
            </Authorized>
            <NotAuthorized>
                <BeeDayButton Compact="true" Class="beeday-button--soft" OnClick="GoToLogin">Log in</BeeDayButton>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private AuthenticatedEntryDestinationResolver DestinationResolver { get; set; } = default!;

    private void GoToLogin() => Navigation.NavigateTo("/login");

    private async Task ContinueToBeeDay()
    {
        var destination = await DestinationResolver.ResolveAsync();
        Navigation.NavigateTo(destination, forceLoad: true, replace: true);
    }
}
