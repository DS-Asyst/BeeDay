@using BeeDay.Web.Services.Authentication
@using BeeDay.Web.Resources
<header class="public-header">
    <div class="public-header__content beeday-container">
        <a class="public-header__brand" href="/" aria-label="@SharedLocalizer["PublicHeaderHomeAriaLabel"]">
            <img class="public-header__brand-mark" src="/assets/brand/beeday-top-navigation.png" alt="" width="866" height="288" />
        </a>

        <div class="public-header__actions">
            <PublicLanguageSwitcher />
            <AuthorizeView>
                <Authorized>
                    <BeeDayButton Compact="true" OnClick="ContinueToBeeDay">@SharedLocalizer["ContinueToBeeDay"]</BeeDayButton>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private AuthenticatedEntryDestinationResolver DestinationResolver { get; set; } = default!;
    [Inject] private IStringLocalizer<SharedResources> SharedLocalizer { get; set; } = default!;

    private async Task ContinueToBeeDay()
    {
        var destination = await DestinationResolver.ResolveAsync();
        Navigation.NavigateTo(destination, forceLoad: true, replace: true);
    }
}
