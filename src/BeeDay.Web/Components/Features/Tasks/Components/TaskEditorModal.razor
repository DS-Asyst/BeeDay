@using BeeDay.Domain.Enums
<EditorModalShell Model="Model"
                  Title="@(IsEditing ? "Edit Task" : "Create Task")"
                  TitleId="task-editor-title"
                  SubmitLabel="@(IsEditing ? "Save" : "Create")"
                  ShowDelete="IsEditing"
                  OnSubmit="Save"
                  OnCancel="Cancel"
                  OnDelete="RequestDelete">
    <HeroContent>
        <div class="editor-modal__hero">
            <BeeDayInput Id="task-title"
                          Label="Title"
                          Required="true"
                          @bind-Value="Model.Title"
                          Placeholder="Add a title"
                          MaxLength="100"
                          FieldCssClass="editor-modal__hero-field"
                          LabelCssClass="editor-modal__label-line"
                          autofocus />
            <BeeDayTextArea Id="task-notes"
                             Label="Notes"
                             @bind-Value="Model.Description"
                             Placeholder="Add notes"
                             MaxLength="500"
                             ShowCounter="true"
                             FieldCssClass="editor-modal__hero-field"
                             LabelCssClass="editor-modal__label-line"
                             CounterCssClass="editor-modal__counter" />
        </div>
    </HeroContent>
    <BodyContent>
        <div class="editor-modal__body">
            <div class="editor-modal__type-summary"><PixelIcon Name="PixelIconName.RecurringTask" Size="PixelIconSize.Large" Class="editor-modal__type-icon" Decorative="true" /><div><strong>Task</strong><p>A recurring or repeatable activity.</p></div></div>
            <BeeDaySelect TValue="TaskRepeat"
                           Id="task-repeat"
                           Label="Repeat"
                           @bind-Value="Model.Repeat"
                           FieldCssClass="editor-modal__field">
                @foreach (var option in Enum.GetValues<TaskRepeat>())
                {
                    <option value="@option">@FormatEnum(option.ToString())</option>
                }
            </BeeDaySelect>
            <ActivityAttributeSelect Id="task-attribute"
                                      Label="Attribute"
                                      @bind-Value="Model.Attribute"
                                      FieldCssClass="editor-modal__field" />
        </div>
    </BodyContent>
</EditorModalShell>

<BeeDayConfirmDialog IsOpen="showDeleteConfirmation"
                      Title="Delete Task"
                      Message="Are you sure you want to delete this task?"
                      ItemTitle="@Model.Title"
                      Warning="This action cannot be undone."
                      WarningDetails="All information will be permanently removed."
                      ConfirmLabel="Delete Task"
                      OnConfirm="ConfirmDelete"
                      OnCancel="CloseDeleteConfirmation" />
