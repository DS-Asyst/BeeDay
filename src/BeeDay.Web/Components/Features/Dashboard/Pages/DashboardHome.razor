@page "/profile"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject AuthenticatedUserInitializer UserInitializer
@inject BeeDay.Web.Components.Features.Dashboard.State.DashboardState State
@inject NavigationManager Navigation

<PageTitle>Profile | BeeDay</PageTitle>

@if (State.IsLoading)
{
    <section class="product-home product-home--loading" aria-label="Loading Profile" aria-busy="true">
        <div class="product-home__skeleton product-home__skeleton--header"></div>
        <div class="product-home__skeleton product-home__skeleton--feature"></div>
        <div class="product-home__skeleton product-home__skeleton--row"></div>
    </section>
}
else if (State.IsUnavailable)
{
    <section class="product-home" aria-labelledby="home-unavailable-heading">
        <BeeDayCard Padded="true" Class="product-home__status" role="status">
            <BeeDayIcon Name="BeeDayIconName.Warning" Size="BeeDayIconSize.Large" Color="BeeDayIconColor.Warning" />
            <div><strong id="home-unavailable-heading">Profile summary unavailable</strong><p>Refresh the page to try loading your workspace again.</p></div>
        </BeeDayCard>
    </section>
}
else if (State.Data?.Profile.HasProfile == true)
{
    var dashboard = State.Data;
    var activeProject = dashboard.Projects.Where(project => !project.Completed).OrderByDescending(project => project.Featured).FirstOrDefault();

    <section class="product-home beeday-fade-in" aria-labelledby="home-heading">
        <header class="product-home__header">
            <div>
                <span class="product-home__date">@DateTime.Today.ToString("dddd, MMMM d")</span>
                <h1 id="home-heading">Welcome back, @dashboard.Profile.Nickname</h1>
                <p>Choose one next step and keep your day moving.</p>
            </div>
            <BeeDayButton Icon="BeeDayIconName.Daily" OnClick="GoToDaily">Open Daily</BeeDayButton>
        </header>

        <section class="product-home__progress" aria-label="Your progress">
            <ExperienceBar Model="ExperienceViewModel.From(dashboard.Profile)"
                           ExperienceGain="State.LatestExperienceGain"
                           FeedbackKey="State.ExperienceFeedbackVersion" />
        </section>

        <section class="product-home__section" aria-labelledby="week-heading">
            <div class="product-home__section-heading">
                <div><span>THIS WEEK</span><h2 id="week-heading">Weekly activity</h2></div>
                <a href="/daily">Open Daily</a>
            </div>
            <BeeDayCard Padded="true" Class="product-home__weekly-unavailable" role="status">
                <BeeDayIcon Name="BeeDayIconName.Calendar" Size="BeeDayIconSize.Large" Color="BeeDayIconColor.Muted" />
                <div><strong>Weekly history is not available yet</strong><p>BeeDay does not currently record completion dates, so no weekly totals are shown.</p></div>
            </BeeDayCard>
        </section>

        @if (activeProject is not null)
        {
            <section class="product-home__section" aria-labelledby="project-heading">
                <div class="product-home__section-heading">
                    <div><span>IN PROGRESS</span><h2 id="project-heading">Continue your project</h2></div>
                </div>
                <BeeDayCard Padded="true" Class="product-home__project">
                    <div class="product-home__project-header">
                        <BeeDayIcon Name="BeeDayIconName.Project" Size="BeeDayIconSize.Large" Color="BeeDayIconColor.Primary" />
                        <div><h3>@activeProject.Name</h3><p>@activeProject.Description</p></div>
                    </div>
                    <BeeDayProgressBar Label="@($"{activeProject.Name} progress")"
                                       Value="@((double)activeProject.ProgressPercentage)"
                                       Maximum="100"
                                       ValueText="@($"{activeProject.ProgressPercentage:0}% complete")" />
                    <BeeDayButton Variant="BeeDayButtonVariant.Secondary" Compact="true" OnClick="GoToDaily">Continue in Daily</BeeDayButton>
                </BeeDayCard>
            </section>
        }
    </section>

    <BeeDayLoading IsVisible="State.IsBusy" Label="Saving..." />
    <BeeDayFeedbackHost />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        State.Changed += HandleStateChanged;
        await UserInitializer.EnsureInitializedAsync();
        await State.InitializeAsync();

        if (!State.HasProfile && !State.IsUnavailable)
        {
            Navigation.NavigateTo("/profile/create", forceLoad: true, replace: true);
        }
    }

    private void GoToDaily() => Navigation.NavigateTo("/daily");
    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= HandleStateChanged;
}
