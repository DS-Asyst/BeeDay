@page "/daily"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticatedUserInitializer UserInitializer
@inject BeeDay.Web.Components.Features.Dashboard.State.DashboardState State
@inject NavigationManager Navigation
@inject IStringLocalizer<DashboardResources> Localizer

<PageTitle>@Localizer["DailyPageTitle"]</PageTitle>

@if (State.IsLoading)
{
    <BeeDayDashboardSkeleton AriaLabel="@Localizer["LoadingDashboardAriaLabel"]" />
}
else if (State.Data?.Profile.HasProfile == true)
{
    <section class="dashboard-page beeday-fade-in">
        <h1 class="beeday-visually-hidden">@Localizer["DailyHeading"]</h1>
        <div class="dashboard-page__content">
            <ActivityFilterBar Value="@State.Search"
                       ValueChanged="@(value => State.Search = value)"
                       OnCreate="State.OpenCreate" />
            <div class="dashboard-grid">
                @{ var habits = State.FilteredHabits.ToList(); }
                <DashboardColumn Title="@Localizer["HabitsColumnTitle"]"
                                 EmptyTitle="@(State.HabitsFilteredToZero ? Localizer["NoFilterResultsTitle"] : Localizer["HabitsEmptyTitle"])"
                                 EmptyDescription="@(State.HabitsFilteredToZero ? Localizer["NoFilterResultsDescription"] : Localizer["HabitsEmptyDescription"])"
                                 EmptyIcon="BeeDayIconName.Habit"
                                 SingularLabel="@Localizer["HabitSingular"]"
                                 ActiveStateLabel="@Localizer["HabitsActiveStateLabel"]"
                                 ActiveCount="@habits.Count"
                                 ShowCompletedSection="false"
                                 ShowCreateButton="false"
                                 OnCreate="@(() => State.OpenCreate(ActivityType.Habit))">
                    <ActiveContent>
                        <BeeDaySortable ItemIds="@habits.Select(item => item.Id).ToList()"
                                         CollectionKey="habits"
                                         AriaLabel="@Localizer["ReorderHabitsAriaLabel"]"
                                         ItemAriaLabel="@Localizer["ReorderItemAriaLabel"]"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderHabitsAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = habits.First(candidate => candidate.Id == itemId); }
                                <HabitCard Title="@item.Title" Description="@item.Description" Direction="@item.Direction" PositiveCount="@item.PositiveCount" NegativeCount="@item.NegativeCount" Featured="@item.Featured" SearchTerm="@State.Search" OnPositive="@(() => State.RegisterPositiveAsync(item.Id))" OnNegative="@(() => State.RegisterNegativeAsync(item.Id))" OnEdit="@(() => State.OpenHabitEditor(item))" />
                            </ItemTemplate>
                        </BeeDaySortable>
                    </ActiveContent>
                </DashboardColumn>

                @{
                    var filteredTasks = State.FilteredTasks.ToList();
                    var activeTasks = filteredTasks.Where(item => !item.Completed).ToList();
                    var completedTasks = filteredTasks.Where(item => item.Completed).ToList();
                }
                <DashboardColumn Title="@Localizer["TasksColumnTitle"]"
                                 EmptyTitle="@(State.ActiveTasksFilteredToZero ? Localizer["NoFilterResultsTitle"] : Localizer["TasksEmptyTitle"])"
                                 EmptyDescription="@(State.ActiveTasksFilteredToZero ? Localizer["NoFilterResultsDescription"] : Localizer["TasksEmptyDescription"])"
                                 EmptyIcon="BeeDayIconName.RecurringTask"
                                 SingularLabel="@Localizer["TaskSingular"]"
                                 ActiveStateLabel="@Localizer["TasksActiveStateLabel"]"
                                 CompletedStateLabel="@Localizer["TasksCompletedStateLabel"]"
                                 ShowActiveAriaLabel="@Localizer["TasksShowActiveAriaLabel"]"
                                 ShowCompletedAriaLabel="@Localizer["TasksShowCompletedAriaLabel"]"
                                 CompletedEmptyTitle="@Localizer["TasksCompletedEmptyTitle"]"
                                 CompletedEmptyDescription="@Localizer["TasksCompletedEmptyDescription"]"
                                 ActiveCount="@activeTasks.Count"
                                 CompletedCount="@completedTasks.Count"
                                 ShowCreateButton="false"
                                 OnCreate="@(() => State.OpenCreate(ActivityType.Task))">
                    <ActiveContent>
                        <BeeDaySortable ItemIds="@activeTasks.Select(item => item.Id).ToList()"
                                         CollectionKey="tasks"
                                         AriaLabel="@Localizer["ReorderActiveTasksAriaLabel"]"
                                         ItemAriaLabel="@Localizer["ReorderItemAriaLabel"]"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderTasksAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = activeTasks.First(candidate => candidate.Id == itemId); }
                                <ActivityCard Title="@item.Title" Description="@item.Description" Meta="@State.FormatRepeat(item.Repeat)" Variant="task" Completed="false" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTaskAsync(item.Id))" OnEdit="@(() => State.OpenTaskEditor(item))" />
                            </ItemTemplate>
                        </BeeDaySortable>
                    </ActiveContent>
                    <CompletedContent>
                        @foreach (var item in completedTasks)
                        {
                            <ActivityCard @key="item.Id" Title="@item.Title" Description="@item.Description" Meta="@State.FormatRepeat(item.Repeat)" Variant="task" Completed="true" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTaskAsync(item.Id))" OnEdit="@(() => State.OpenTaskEditor(item))" />
                        }
                    </CompletedContent>
                </DashboardColumn>

                @{
                    var filteredTodos = State.FilteredTodos.ToList();
                    var activeTodos = filteredTodos.Where(item => !item.Completed).ToList();
                    var completedTodos = filteredTodos.Where(item => item.Completed).ToList();
                }
                <DashboardColumn Title="@Localizer["TodosColumnTitle"]"
                                 EmptyTitle="@(State.ActiveTodosFilteredToZero ? Localizer["NoFilterResultsTitle"] : Localizer["TodosEmptyTitle"])"
                                 EmptyDescription="@(State.ActiveTodosFilteredToZero ? Localizer["NoFilterResultsDescription"] : Localizer["TodosEmptyDescription"])"
                                 EmptyIcon="BeeDayIconName.Todo"
                                 SingularLabel="@Localizer["TodoSingular"]"
                                 ActiveStateLabel="@Localizer["TodosActiveStateLabel"]"
                                 CompletedStateLabel="@Localizer["TodosCompletedStateLabel"]"
                                 ShowActiveAriaLabel="@Localizer["TodosShowActiveAriaLabel"]"
                                 ShowCompletedAriaLabel="@Localizer["TodosShowCompletedAriaLabel"]"
                                 CompletedEmptyTitle="@Localizer["TodosCompletedEmptyTitle"]"
                                 CompletedEmptyDescription="@Localizer["TodosCompletedEmptyDescription"]"
                                 ActiveCount="@activeTodos.Count"
                                 CompletedCount="@completedTodos.Count"
                                 ShowCreateButton="false">
                    <ActiveContent>
                        <BeeDaySortable ItemIds="@activeTodos.Select(item => item.Id).ToList()"
                                         CollectionKey="todos"
                                         AriaLabel="@Localizer["ReorderActiveTodosAriaLabel"]"
                                         ItemAriaLabel="@Localizer["ReorderItemAriaLabel"]"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderTodosAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = activeTodos.First(candidate => candidate.Id == itemId); }
                                <ActivityCard Title="@item.Title" Description="@item.Description" Meta="@State.FormatDueDate(item.DueDate)" Variant="todo" Completed="false" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTodoAsync(item.Id))" OnEdit="@(() => State.OpenTodoEditor(item))" />
                            </ItemTemplate>
                        </BeeDaySortable>
                    </ActiveContent>
                    <CompletedContent>
                        @foreach (var item in completedTodos)
                        {
                            <ActivityCard @key="item.Id" Title="@item.Title" Description="@item.Description" Meta="@State.FormatDueDate(item.DueDate)" Variant="todo" Completed="true" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTodoAsync(item.Id))" OnEdit="@(() => State.OpenTodoEditor(item))" />
                        }
                    </CompletedContent>
                </DashboardColumn>

                @{
                    var filteredProjects = State.FilteredProjects.ToList();
                    var activeProjects = filteredProjects.Where(item => !item.Completed).ToList();
                    var completedProjects = filteredProjects.Where(item => item.Completed).ToList();
                }
                <DashboardColumn Title="@Localizer["ProjectsColumnTitle"]"
                                 EmptyTitle="@(State.ActiveProjectsFilteredToZero ? Localizer["NoFilterResultsTitle"] : Localizer["ProjectsEmptyTitle"])"
                                 EmptyDescription="@(State.ActiveProjectsFilteredToZero ? Localizer["NoFilterResultsDescription"] : Localizer["ProjectsEmptyDescription"])"
                                 EmptyIcon="BeeDayIconName.Project"
                                 SingularLabel="@Localizer["ProjectSingular"]"
                                 ActiveStateLabel="@Localizer["ProjectsActiveStateLabel"]"
                                 CompletedStateLabel="@Localizer["ProjectsCompletedStateLabel"]"
                                 ShowActiveAriaLabel="@Localizer["ProjectsShowActiveAriaLabel"]"
                                 ShowCompletedAriaLabel="@Localizer["ProjectsShowCompletedAriaLabel"]"
                                 CompletedEmptyTitle="@Localizer["ProjectsCompletedEmptyTitle"]"
                                 CompletedEmptyDescription="@Localizer["ProjectsCompletedEmptyDescription"]"
                                 ActiveCount="@activeProjects.Count"
                                 CompletedCount="@completedProjects.Count"
                                 ShowCreateButton="false"
                                 OnCreate="@(() => State.OpenCreate(ActivityType.Project))">
                    <HeaderContent>
                        <ProjectContextFilter Projects="@State.ProjectContextOptions"
                                              SelectedProjectId="@State.SelectedProjectId"
                                              SelectedProjectIdChanged="State.SelectProjectContext" />
                    </HeaderContent>
                    <ActiveContent>
                        <BeeDaySortable ItemIds="@activeProjects.Select(item => item.Id).ToList()"
                                         CollectionKey="projects"
                                         AriaLabel="@Localizer["ReorderActiveProjectsAriaLabel"]"
                                         ItemAriaLabel="@Localizer["ReorderItemAriaLabel"]"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderProjectsAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = activeProjects.First(candidate => candidate.Id == itemId); }
                                <ActivityCard Title="@item.Name" Description="@item.Description" Meta="@($"{State.FormatProjectStatus(item.Status)} · {item.ProgressPercentage:0.##}%")" Variant="project" Completed="false" Featured="@item.Featured" SearchTerm="@State.Search" OnEdit="@(() => State.OpenProjectEditor(item))" />
                            </ItemTemplate>
                        </BeeDaySortable>
                    </ActiveContent>
                    <CompletedContent>
                        @foreach (var item in completedProjects)
                        {
                            <ActivityCard @key="item.Id" Title="@item.Name" Description="@item.Description" Meta="@($"{State.FormatProjectStatus(item.Status)} · {item.ProgressPercentage:0.##}%")" Variant="project" Completed="true" Featured="@item.Featured" SearchTerm="@State.Search" OnEdit="@(() => State.OpenProjectEditor(item))" />
                        }
                    </CompletedContent>
                </DashboardColumn>
            </div>
        </div>
    </section>

    @if (State.OpenProject is not null)
    {
        <ProjectWorkspace Project="State.OpenProject"
                          OnClose="State.CloseProjectWorkspace"
                          OnAddTodo="State.OpenTodoForProject"
                          OnToggleTodo="@(todo => State.ToggleTodoAsync(todo.Id))" />
    }

    @if (State.Modals.IsHabitEditorOpen) { <HabitEditorModal Model="State.Modals.HabitForm" IsEditing="State.Modals.IsEditing" OnSave="State.SaveHabitAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentHabitAsync" /> }
    @if (State.Modals.IsTaskEditorOpen) { <TaskEditorModal Model="State.Modals.TaskForm" IsEditing="State.Modals.IsEditing" OnSave="State.SaveTaskAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentTaskAsync" /> }
    @if (State.Modals.IsTodoEditorOpen) { <TodoEditorModal Model="State.Modals.TodoForm" Projects="@(State.Data?.Projects ?? [])" IsEditing="State.Modals.IsEditing" OnSave="State.SaveTodoAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentTodoAsync" /> }
    @if (State.Modals.IsProjectEditorOpen) { <ProjectEditorModal Model="State.Modals.ProjectForm" IsEditing="State.Modals.IsEditing" OnSave="State.SaveProjectAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentProjectAsync" OnOpenProject="State.OpenProjectFromEditor" /> }

    <BeeDayLoading IsVisible="State.IsBusy" />
    <BeeDayFeedbackHost />
}
