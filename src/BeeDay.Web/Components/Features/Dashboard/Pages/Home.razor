@page "/daily"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticatedUserInitializer UserInitializer
@inject BeeDay.Web.Components.Features.Dashboard.State.DashboardState State
@inject NavigationManager Navigation

<PageTitle>Dashboard | LevelUp</PageTitle>

@if (State.IsLoading)
{
    <LevelUpDashboardSkeleton />
}
else if (State.Data?.Profile.HasProfile == true)
{
    <section class="dashboard-page levelup-fade-in">
        <div class="dashboard-page__content">
            <ActivityFilterBar Value="@State.Search"
                       ValueChanged="@(value => State.Search = value)"
                       SelectedAttributes="@State.SelectedAttributes"
                       OnAttributeToggle="State.ToggleAttributeFilter"
                       OnClearAttributes="State.ClearAttributeFilters"
                       OnCreate="State.OpenCreate" />
            <div class="dashboard-grid">
                @{ var habits = State.FilteredHabits.ToList(); }
                <DashboardColumn Title="Habits"
                                 EmptyLabel="habits"
                                 EmptyTitle="No habits yet"
                                 EmptyDescription="Create a habit to build routines and track your daily consistency."
                                 EmptyIcon="PixelIconName.Habit"
                                 SingularLabel="Habit"
                                 ActiveCount="@habits.Count"
                                 ShowCompletedSection="false"
                                 ShowCreateButton="false"
                                 OnCreate="@(() => State.OpenCreate(ActivityType.Habit))">
                    <ActiveContent>
                        <LevelUpSortable ItemIds="@habits.Select(item => item.Id).ToList()"
                                         CollectionKey="habits"
                                         AriaLabel="Reorder habits"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderHabitsAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = habits.First(candidate => candidate.Id == itemId); }
                                <HabitCard Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Direction="@item.Direction" PositiveCount="@item.PositiveCount" NegativeCount="@item.NegativeCount" Featured="@item.Featured" SearchTerm="@State.Search" OnPositive="@(() => State.RegisterPositiveAsync(item.Id))" OnNegative="@(() => State.RegisterNegativeAsync(item.Id))" OnEdit="@(() => State.OpenHabitEditor(item))" />
                            </ItemTemplate>
                        </LevelUpSortable>
                    </ActiveContent>
                </DashboardColumn>

                @{
                    var filteredTasks = State.FilteredTasks.ToList();
                    var activeTasks = filteredTasks.Where(item => !item.Completed).ToList();
                    var completedTasks = filteredTasks.Where(item => item.Completed).ToList();
                }
                <DashboardColumn Title="Tasks"
                                 EmptyLabel="tasks"
                                 EmptyTitle="No tasks yet"
                                 EmptyDescription="Create a recurring task to organize work that repeats over time."
                                 EmptyIcon="PixelIconName.RecurringTask"
                                 SingularLabel="Task"
                                 ActiveCount="@activeTasks.Count"
                                 CompletedCount="@completedTasks.Count"
                                 ShowCreateButton="false"
                                 OnCreate="@(() => State.OpenCreate(ActivityType.Task))">
                    <ActiveContent>
                        <LevelUpSortable ItemIds="@activeTasks.Select(item => item.Id).ToList()"
                                         CollectionKey="tasks"
                                         AriaLabel="Reorder active tasks"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderTasksAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = activeTasks.First(candidate => candidate.Id == itemId); }
                                <ActivityCard Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Meta="@State.FormatRepeat(item.Repeat)" Variant="task" Completed="false" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTaskAsync(item.Id))" OnEdit="@(() => State.OpenTaskEditor(item))" />
                            </ItemTemplate>
                        </LevelUpSortable>
                    </ActiveContent>
                    <CompletedContent>
                        @foreach (var item in completedTasks)
                        {
                            <ActivityCard @key="item.Id" Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Meta="@State.FormatRepeat(item.Repeat)" Variant="task" Completed="true" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTaskAsync(item.Id))" OnEdit="@(() => State.OpenTaskEditor(item))" />
                        }
                    </CompletedContent>
                </DashboardColumn>

                @{
                    var filteredTodos = State.FilteredTodos.ToList();
                    var activeTodos = filteredTodos.Where(item => !item.Completed).ToList();
                    var completedTodos = filteredTodos.Where(item => item.Completed).ToList();
                }
                <DashboardColumn Title="To-Dos"
                                 EmptyLabel="to-dos"
                                 EmptyTitle="No to-dos yet"
                                 EmptyDescription="To-dos are created inside projects and appear here for quick access."
                                 EmptyIcon="PixelIconName.Todo"
                                 SingularLabel="To-Do"
                                 ActiveCount="@activeTodos.Count"
                                 CompletedCount="@completedTodos.Count"
                                 ShowCreateButton="false">
                    <ActiveContent>
                        <LevelUpSortable ItemIds="@activeTodos.Select(item => item.Id).ToList()"
                                         CollectionKey="todos"
                                         AriaLabel="Reorder active to-dos"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderTodosAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = activeTodos.First(candidate => candidate.Id == itemId); }
                                <ActivityCard Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Meta="@State.FormatDueDate(item.DueDate)" Variant="todo" Completed="false" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTodoAsync(item.Id))" OnEdit="@(() => State.OpenTodoEditor(item))" />
                            </ItemTemplate>
                        </LevelUpSortable>
                    </ActiveContent>
                    <CompletedContent>
                        @foreach (var item in completedTodos)
                        {
                            <ActivityCard @key="item.Id" Title="@item.Title" Description="@item.Description" Attribute="@item.Attribute" Meta="@State.FormatDueDate(item.DueDate)" Variant="todo" Completed="true" Featured="@item.Featured" SearchTerm="@State.Search" OnToggle="@(() => State.ToggleTodoAsync(item.Id))" OnEdit="@(() => State.OpenTodoEditor(item))" />
                        }
                    </CompletedContent>
                </DashboardColumn>

                @{
                    var filteredProjects = State.FilteredProjects.ToList();
                    var activeProjects = filteredProjects.Where(item => !item.Completed).ToList();
                    var completedProjects = filteredProjects.Where(item => item.Completed).ToList();
                }
                <DashboardColumn Title="Projects"
                                 EmptyLabel="projects"
                                 EmptyTitle="No projects yet"
                                 EmptyDescription="Create a project to group related to-dos and follow their progress."
                                 EmptyIcon="PixelIconName.Project"
                                 SingularLabel="Project"
                                 ActiveCount="@activeProjects.Count"
                                 CompletedCount="@completedProjects.Count"
                                 ShowCreateButton="false"
                                 OnCreate="@(() => State.OpenCreate(ActivityType.Project))">
                    <HeaderContent>
                        <ProjectContextFilter Projects="@State.ProjectContextOptions"
                                              SelectedProjectId="@State.SelectedProjectId"
                                              SelectedProjectIdChanged="State.SelectProjectContext" />
                    </HeaderContent>
                    <ActiveContent>
                        <LevelUpSortable ItemIds="@activeProjects.Select(item => item.Id).ToList()"
                                         CollectionKey="projects"
                                         AriaLabel="Reorder active projects"
                                         RemovingItemId="@State.RemovingItemId"
                                         OnReorder="State.ReorderProjectsAsync">
                            <ItemTemplate Context="itemId">
                                @{ var item = activeProjects.First(candidate => candidate.Id == itemId); }
                                <ActivityCard Title="@item.Name" Description="@item.Description" Attribute="@item.Attribute" Meta="@($"{State.FormatProjectStatus(item.Status)} · {item.ProgressPercentage:0.##}%")" Variant="project" Completed="false" Featured="@item.Featured" SearchTerm="@State.Search" OnEdit="@(() => State.OpenProjectEditor(item))" />
                            </ItemTemplate>
                        </LevelUpSortable>
                    </ActiveContent>
                    <CompletedContent>
                        @foreach (var item in completedProjects)
                        {
                            <ActivityCard @key="item.Id" Title="@item.Name" Description="@item.Description" Attribute="@item.Attribute" Meta="@($"{State.FormatProjectStatus(item.Status)} · {item.ProgressPercentage:0.##}%")" Variant="project" Completed="true" Featured="@item.Featured" SearchTerm="@State.Search" OnEdit="@(() => State.OpenProjectEditor(item))" />
                        }
                    </CompletedContent>
                </DashboardColumn>
            </div>
        </div>
    </section>

    @if (State.OpenProject is not null)
    {
        <ProjectWorkspace Project="State.OpenProject"
                          OnClose="State.CloseProjectWorkspace"
                          OnAddTodo="State.OpenTodoForProject" />
    }

    @if (State.Modals.IsHabitEditorOpen) { <HabitEditorModal Model="State.Modals.HabitForm" IsEditing="State.Modals.IsEditing" OnSave="State.SaveHabitAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentHabitAsync" /> }
    @if (State.Modals.IsTaskEditorOpen) { <TaskEditorModal Model="State.Modals.TaskForm" IsEditing="State.Modals.IsEditing" OnSave="State.SaveTaskAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentTaskAsync" /> }
    @if (State.Modals.IsTodoEditorOpen) { <TodoEditorModal Model="State.Modals.TodoForm" Projects="@(State.Data?.Projects ?? [])" IsEditing="State.Modals.IsEditing" OnSave="State.SaveTodoAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentTodoAsync" /> }
    @if (State.Modals.IsProjectEditorOpen) { <ProjectEditorModal Model="State.Modals.ProjectForm" IsEditing="State.Modals.IsEditing" OnSave="State.SaveProjectAsync" OnCancel="State.CloseEditor" OnDelete="State.DeleteCurrentProjectAsync" OnOpenProject="State.OpenProjectFromEditor" /> }

    <LevelUpLoading IsVisible="State.IsBusy" Label="Saving..." />
    <LevelUpFeedbackHost />
}
