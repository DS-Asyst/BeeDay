@using BeeDay.Domain.Enums

<div class="filter-bar" aria-label="Dashboard controls">
    <div class="filter-bar__main">
        <div class="filter-bar__search" role="search">
            <input id="dashboard-search" class="filter-bar__input" type="search"
                   aria-label="Search activities" placeholder="Search" value="@inputValue" @oninput="OnInput" />
        </div>
        <div class="filter-bar__create">
            <BeeDayButton Variant="BeeDayButtonVariant.Primary" Compact="true" Icon="BeeDayIconName.Add"
                          Class="filter-bar__create-button" OnClick="ToggleCreateMenu"
                          aria-haspopup="menu" aria-expanded="@showCreateMenu">Activity</BeeDayButton>
            @if (showCreateMenu)
            {
                <div class="filter-bar__menu" role="menu" aria-label="Choose activity type">
                    <button type="button" role="menuitem" @onclick="CreateHabitAsync"><BeeDayIcon Name="BeeDayIconName.Habit" Size="BeeDayIconSize.Small" Decorative="true" /><span>Habit</span></button>
                    <button type="button" role="menuitem" @onclick="CreateTaskAsync"><BeeDayIcon Name="BeeDayIconName.RecurringTask" Size="BeeDayIconSize.Small" Decorative="true" /><span>Task</span></button>
                    <button type="button" role="menuitem" @onclick="CreateTodoAsync"><BeeDayIcon Name="BeeDayIconName.Todo" Size="BeeDayIconSize.Small" Decorative="true" /><span>To-Do</span></button>
                    <button type="button" role="menuitem" @onclick="CreateProjectAsync"><BeeDayIcon Name="BeeDayIconName.Project" Size="BeeDayIconSize.Small" Decorative="true" /><span>Project</span></button>
                </div>
            }
        </div>
    </div>
</div>
