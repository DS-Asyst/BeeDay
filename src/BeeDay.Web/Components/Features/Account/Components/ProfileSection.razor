@using BeeDay.Web.Components.Features.Account.Models

<BeeDaySettingsSection Eyebrow="IDENTITY"
                        Title="Profile"
                        Description="Manage the personal information shown across BeeDay.">
    <BeeDaySettingsForm TModel="ProfileFormModel" Model="Model" OnValidSubmit="OnSave"
                         FormName="account-profile" SubmitLabel="Save Profile" IsBusy="IsBusy">
        <div class="beeday-settings-form__grid">
            <BeeDayInput Id="account-name" Label="Name" Required="true" MaxLength="100"
                          @bind-Value="Model.Name" />
            <BeeDayInput Id="account-email" Label="Email" Required="true" MaxLength="254"
                          @bind-Value="Model.Email" />
            <BeeDayInput Id="account-nickname" Label="Nickname" ReadOnly="true" @bind-Value="Model.Nickname" />
        </div>

        <p class="beeday-settings-form__hint">Your nickname is permanent after your profile is created.</p>
    </BeeDaySettingsForm>
</BeeDaySettingsSection>

@code {
    [Parameter, EditorRequired] public ProfileFormModel Model { get; set; } = default!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
