@using BeeDay.Web.Components.Features.Account.Models
@using BeeDay.Web.Components.Features.Account
@inject IStringLocalizer<AccountResources> Localizer

<BeeDaySettingsSection Eyebrow="@Localizer["ProfileEyebrow"]"
                        Title="@Localizer["ProfileTitle"]"
                        Description="@Localizer["ProfileDescription"]">
    <BeeDaySettingsForm TModel="ProfileFormModel" Model="Model" OnValidSubmit="OnSave"
                         FormName="account-profile" SubmitLabel="@Localizer["ProfileSubmitLabel"]" IsBusy="IsBusy">
        <div class="beeday-settings-form__grid">
            <BeeDayInput Id="account-name" Label="@Localizer["NameLabel"]" Required="true" MaxLength="100"
                          @bind-Value="Model.Name" />
            <BeeDayInput Id="account-email" Label="@Localizer["EmailLabel"]" Required="true" MaxLength="254"
                          @bind-Value="Model.Email" />
            <BeeDayInput Id="account-nickname" Label="@Localizer["NicknameLabel"]" ReadOnly="true" @bind-Value="Model.Nickname" />
        </div>

        <p class="beeday-settings-form__hint">@Localizer["ProfileHint"]</p>
    </BeeDaySettingsForm>
</BeeDaySettingsSection>

@code {
    [Parameter, EditorRequired] public ProfileFormModel Model { get; set; } = default!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
