@using BeeDay.Web.Components.Features.Account.Models
@using BeeDay.Web.Components.Features.Account
@using BeeDay.Domain.Enums
@inject IStringLocalizer<AccountResources> Localizer

<BeeDaySettingsSection Eyebrow="@Localizer["PreferencesEyebrow"]"
                        Title="@Localizer["PreferencesTitle"]"
                        Description="@Localizer["PreferencesDescription"]">
    <BeeDaySettingsForm TModel="PreferencesFormModel" Model="Model" OnValidSubmit="OnSave"
                         FormName="account-preferences" SubmitLabel="@Localizer["PreferencesSubmitLabel"]" IsBusy="IsBusy">
        <div class="beeday-settings-form__grid">
            <BeeDaySelect TValue="UserLanguage" Id="account-language" Label="@Localizer["LanguageLabel"]"
                           @bind-Value="Model.Language">
                <option value="@UserLanguage.English">@Localizer["LanguageEnglishOption"]</option>
                <option value="@UserLanguage.Portuguese">@Localizer["LanguagePortugueseOption"]</option>
            </BeeDaySelect>
            <BeeDaySelect TValue="UserTheme" Id="account-theme" Label="@Localizer["ThemeLabel"]"
                           @bind-Value="Model.Theme">
                <option value="@UserTheme.System">@Localizer["ThemeSystemOption"]</option>
                <option value="@UserTheme.Light">@Localizer["ThemeLightOption"]</option>
                <option value="@UserTheme.Dark">@Localizer["ThemeDarkOption"]</option>
            </BeeDaySelect>
        </div>
    </BeeDaySettingsForm>
</BeeDaySettingsSection>

@code {
    [Parameter, EditorRequired] public PreferencesFormModel Model { get; set; } = default!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
