@using BeeDay.Web.Components.Features.Account.Models
@using BeeDay.Domain.Enums

<BeeDaySettingsSection Eyebrow="EXPERIENCE"
                        Title="Preferences"
                        Description="Choose how BeeDay looks and communicates with you.">
    <BeeDaySettingsForm TModel="PreferencesFormModel" Model="Model" OnValidSubmit="OnSave"
                         FormName="account-preferences" SubmitLabel="Save Preferences" SubmitButtonClass="beeday-button--comic beeday-button--comic-success" IsBusy="IsBusy">
        <div class="beeday-settings-form__grid">
            <BeeDaySelect TValue="UserLanguage" Id="account-language" Label="Language"
                           @bind-Value="Model.Language">
                <option value="@UserLanguage.English">English</option>
                <option value="@UserLanguage.Portuguese">Portuguese</option>
            </BeeDaySelect>
            <BeeDaySelect TValue="UserTheme" Id="account-theme" Label="Theme"
                           @bind-Value="Model.Theme">
                <option value="@UserTheme.System">System</option>
                <option value="@UserTheme.Light">Light</option>
                <option value="@UserTheme.Dark">Dark</option>
            </BeeDaySelect>
        </div>
    </BeeDaySettingsForm>
</BeeDaySettingsSection>

@code {
    [Parameter, EditorRequired] public PreferencesFormModel Model { get; set; } = default!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
