@page "/account"
@page "/settings"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using BeeDay.Web.Components.Features.Account.Components
@using BeeDay.Web.Components.Features.Account.Models
@using BeeDay.Web.Localization
@using Microsoft.JSInterop
@inject BeeDayWebService Store
@inject ToastService Toast
@inject NavigationManager Navigation
@inject AuthenticatedUserInitializer UserInitializer
@inject IStringLocalizer<AccountResources> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer
@inject IJSRuntime JS

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<main class="account-page" aria-busy="@IsAnyBusy.ToString().ToLowerInvariant()">
    <BeeDayPageHeader Eyebrow="@Localizer["HeaderEyebrow"]"
                       Title="@Localizer["HeaderTitle"]"
                       Description="@Localizer["HeaderDescription"]" />

    @if (_isLoading)
    {
        <div class="account-page__loading">
            <BeeDaySkeleton Lines="2" />
            <BeeDaySkeleton Lines="5" />
            <BeeDaySkeleton Lines="4" />
        </div>
    }
    else
    {
        <div class="account-page__content">
            <ProfileSection Model="_profile" IsBusy="_profileBusy" OnSave="SaveProfileAsync" />
            <SecuritySection Model="_security" IsBusy="_securityBusy" OnSave="ChangePasswordAsync" />
            <PreferencesSection Model="_preferences" IsBusy="_preferencesBusy" OnSave="SavePreferencesAsync" />
        </div>
    }
</main>

<BeeDayLoading IsVisible="@IsAnyBusy" Label="@Localizer["SavingLabel"]" />

<form id="culture-sync-form" method="post" action="/culture/set" hidden>
    <AntiforgeryToken />
    <input type="hidden" name="culture" value="" />
    <input type="hidden" name="returnUrl" value="" />
</form>

@code {
    private readonly ProfileFormModel _profile = new();
    private readonly SecurityFormModel _security = new();
    private readonly PreferencesFormModel _preferences = new();
    private readonly CancellationTokenSource _cts = new();
    private UserLanguage _initialLanguage;
    private bool _isLoading = true;
    private bool _profileBusy;
    private bool _securityBusy;
    private bool _preferencesBusy;
    private bool IsAnyBusy => _profileBusy || _securityBusy || _preferencesBusy;

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await UserInitializer.EnsureInitializedAsync();
            var user = await Store.GetCurrentUserAsync(_cts.Token);
            if (user is not { HasProfile: true })
            {
                Navigation.NavigateTo("/profile/create", true);
                return;
            }

            _profile.Name = user.Name;
            _profile.Email = user.Email;
            _profile.Nickname = user.Nickname;
            _preferences.Language = user.Language;
            _preferences.Theme = user.Theme;
            _initialLanguage = user.Language;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Toast.ShowError(DomainErrorLocalizer.Translate(ex, SharedLocalizer), Localizer["ToastAccountLoadErrorTitle"]);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveProfileAsync()
    {
        if (IsAnyBusy) return;
        _profileBusy = true;
        try
        {
            await Store.UpdateUserAsync(_profile.Name.Trim(), _profile.Email.Trim(), _cts.Token);
            Toast.ShowSuccess(Localizer["ToastProfileSavedMessage"], Localizer["ToastProfileSavedTitle"]);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Toast.ShowError(DomainErrorLocalizer.Translate(ex, SharedLocalizer), Localizer["ToastProfileErrorTitle"]);
        }
        finally
        {
            _profileBusy = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (IsAnyBusy) return;
        _securityBusy = true;
        try
        {
            await Store.ChangePasswordAsync(_security.CurrentPassword, _security.NewPassword, _security.ConfirmNewPassword, _cts.Token);
            _security.Clear();
            Toast.ShowSuccess(Localizer["ToastPasswordChangedMessage"], Localizer["ToastPasswordChangedTitle"]);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Toast.ShowError(DomainErrorLocalizer.Translate(ex, SharedLocalizer), Localizer["ToastPasswordErrorTitle"]);
        }
        finally
        {
            _securityBusy = false;
        }
    }

    private async Task SavePreferencesAsync()
    {
        if (IsAnyBusy) return;
        _preferencesBusy = true;
        try
        {
            await Store.UpdatePreferencesAsync(_preferences.Language, _preferences.Theme, _cts.Token);

            if (_preferences.Language != _initialLanguage)
            {
                // The language just changed: reload through the same official /culture/set
                // mechanism the Home switcher uses, so BeeDay.Culture and the rendered UI stay in
                // sync with what was just persisted — a toast here would never be seen, since the
                // page is about to navigate away.
                await SyncCultureAndReloadAsync(_preferences.Language);
                return;
            }

            Toast.ShowSuccess(Localizer["ToastPreferencesSavedMessage"], Localizer["ToastPreferencesSavedTitle"]);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Toast.ShowError(DomainErrorLocalizer.Translate(ex, SharedLocalizer), Localizer["ToastPreferencesErrorTitle"]);
        }
        finally
        {
            _preferencesBusy = false;
        }
    }

    private async Task SyncCultureAndReloadAsync(UserLanguage language)
    {
        var culture = BeeDayCultures.FromUserLanguage(language);
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/beeday-culture-sync.js?v=20260815-1");
        await module.InvokeVoidAsync("submitCultureSync", "culture-sync-form", culture, returnUrl);
    }
}
