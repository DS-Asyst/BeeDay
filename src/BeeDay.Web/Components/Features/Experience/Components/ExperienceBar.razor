@using System.Globalization
@using BeeDay.Web.Components.Features.Experience.Models

@if (IsLoading)
{
    <BeeDayCard Padded="true" Class="experience-card experience-card--loading"
                aria-label="Loading experience"
                aria-busy="true">
        <div class="experience-card__skeleton experience-card__skeleton--label"></div>
        <div class="experience-card__skeleton experience-card__skeleton--bar"></div>
        <div class="experience-card__skeleton experience-card__skeleton--value"></div>
    </BeeDayCard>
}
else if (Model is not null)
{
    <BeeDayCard Padded="true" Class="experience-card" aria-label="Experience">
        <div class="experience-card__header">
            <span class="experience-card__label"><PixelIcon Name="PixelIconName.Level" Size="PixelIconSize.ExtraSmall" /> Level</span>
            <strong>@Model.Level</strong>
        </div>

        <BeeDayProgressBar Label="Experience progress"
                           Value="@Model.CurrentExperience"
                           Maximum="@Model.RequiredExperience"
                           ValueText="@ExperienceText" />

        <div class="experience-card__values">
            <span><PixelIcon Name="PixelIconName.Experience" Size="PixelIconSize.ExtraSmall" /> @Model.TotalExperience XP total</span>
            <span>@Model.CurrentExperience / @Model.RequiredExperience XP</span>
            <span><PixelIcon Name="PixelIconName.TrendUp" Size="PixelIconSize.ExtraSmall" /> @Model.RemainingExperience XP to next level</span>
        </div>

        @if (ExperienceGain > 0)
        {
            <output @key="FeedbackKey"
                    class="experience-card__gain"
                    aria-live="polite">
                <PixelIcon Name="PixelIconName.Experience" Size="PixelIconSize.ExtraSmall" /> +@ExperienceGain XP
            </output>
        }
    </BeeDayCard>
}

@code {
    [Parameter] public ExperienceViewModel? Model { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public long ExperienceGain { get; set; }
    [Parameter] public long FeedbackKey { get; set; }

    private string ExperienceText => Model is null
        ? string.Empty
        : $"{Model.CurrentExperience} of {Model.RequiredExperience} experience points";
}
