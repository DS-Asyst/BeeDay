@page "/profile/create"
@attribute [AllowAnonymous]
@layout BeeDay.Web.Components.Layout.OnboardingLayout
@inject BeeDay.Web.Components.Features.ProfileCreation.State.ProfileCreationState State
@inject NavigationManager Navigation

<PageTitle>Get started | BeeDay</PageTitle>

<section class="profile-page beeday-fade-in" aria-label="Create account flow">
    <PublicAuthActions DestinationHref="/login" DestinationLabel="Log in"
                       CloseLabel="Close create account and return to Home" Label="Create account actions" />

    <div class="profile-panel profile-panel--@State.CurrentStepClass">
        <div class="profile-panel__global-brand"><BeeDayBrand /></div>
        @if (State.Step == BeeDay.Web.Components.Features.ProfileCreation.State.ProfileCreationStep.Account)
        {
            <h1 id="create-profile-heading">Create your account</h1>
            <p class="profile-panel__intro">Start your journey in BeeDay.</p>

            <div class="profile-form">
                <label class="profile-field">
                    <span>Full name</span>
                    <input type="text"
                           class="beeday-field__control profile-field__input"
                           autocomplete="name"
                           @bind="State.Model.Name"
                           @bind:event="oninput" />
                </label>

                <label class="profile-field">
                    <span>Email</span>
                    <input type="email"
                           class="beeday-field__control profile-field__input"
                           autocomplete="email"
                           @bind="State.Model.Email"
                           @bind:event="oninput" />
                </label>

                <label class="profile-field">
                    <span>Password</span>
                    <input type="password"
                           class="beeday-field__control profile-field__input"
                           autocomplete="new-password"
                           aria-describedby="password-requirements"
                           @bind="State.Model.Password"
                           @bind:event="oninput" />
                </label>

                <p id="password-requirements"
                   class="profile-password-hint @(State.IsPasswordValid ? "profile-password-hint--valid" : string.Empty)">
                    @(State.IsPasswordValid
                        ? "Password valid"
                        : "Use at least 8 characters, one letter and one number.")
                </p>

                @if (State.ShouldShowConfirmPassword)
                {
                    <label class="profile-field beeday-fade-in">
                        <span>Confirm password</span>
                        <input type="password"
                               class="beeday-field__control profile-field__input"
                               autocomplete="new-password"
                               @bind="State.Model.ConfirmPassword"
                               @bind:event="oninput" />
                    </label>
                }

                @if (!string.IsNullOrWhiteSpace(State.ValidationError))
                {
                    <p class="profile-validation" role="alert">@State.ValidationError</p>
                }

                <BeeDayButton Variant="BeeDayButtonVariant.Primary"
                               FullWidth="true"
                               Disabled="@(!State.CanContinueAccount)"
                               OnClick="ContinueToProfile">
                    Continue
                </BeeDayButton>
            </div>
        }
        else
        {
            <h1 id="create-profile-heading">Choose your nickname</h1>
            <p class="profile-panel__intro">This is how you'll be identified in BeeDay.</p>

            <div class="profile-form">
                <BeeDayButton Variant="BeeDayButtonVariant.Secondary" Compact="true" Class="profile-form__back" OnClick="Back">Back</BeeDayButton>

                <label class="profile-field">
                    <span>Nickname</span>
                    <div class="profile-nickname-field">
                        <span class="profile-nickname-field__prefix">@@</span>
                        <input class="beeday-field__control profile-field__input profile-nickname-field__input"
                               autocomplete="nickname"
                               maxlength="24"
                               @bind="State.Model.Nickname"
                               @bind:event="oninput" />
                    </div>
                </label>

                @if (!string.IsNullOrWhiteSpace(State.ValidationError))
                {
                    <p class="profile-validation" role="alert">@State.ValidationError</p>
                }

                <BeeDayButton Variant="BeeDayButtonVariant.Primary"
                               FullWidth="true"
                               IsLoading="@State.IsBusy"
                               Disabled="@State.IsBusy"
                               OnClick="CompleteProfileAsync">
                    Create account
                </BeeDayButton>
            </div>
        }
    </div>
</section>
