@page "/"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout LevelUp.Web.Components.Layout.OnboardingLayout
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthenticatedUserInitializer UserInitializer
@inject LevelUp.Web.Services.LevelUpWebService Store
@inject NavigationManager Navigation

<PageTitle>LevelUp</PageTitle>

<div class="entry-loading" role="status" aria-live="polite">
    <span>LEVELUP</span>
    <p>Loading your journey...</p>
</div>

@code {
    private bool _navigationStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _navigationStarted)
        {
            return;
        }

        _navigationStarted = true;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login", forceLoad: true, replace: true);
            return;
        }

        var initializedUserId = await UserInitializer.EnsureInitializedAsync();
        if (initializedUserId is null)
        {
            Navigation.NavigateTo("/login?expired=true", forceLoad: true, replace: true);
            return;
        }

        var user = await Store.GetCurrentUserAsync();
        var destination = user?.HasProfile != true
            ? "/profile/create"
            : user.HasCompletedOnboarding ? "/daily" : "/onboarding/tutorial";
        Navigation.NavigateTo(destination, forceLoad: true, replace: true);
    }
}
