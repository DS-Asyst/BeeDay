@page "/welcome"
@attribute [AllowAnonymous]
@layout BeeDay.Web.Components.Layout.OnboardingLayout
@using BeeDay.Web.Components.Features.ProfileCreation
@inject NavigationManager Navigation
@inject IStringLocalizer<ProfileCreationResources> Localizer

<PageTitle>@Localizer["RedirectingToLoginTitle"]</PageTitle>

<div class="entry-loading" role="status" aria-live="polite">
    <span>BEEDAY</span>
    <p>@Localizer["RedirectingToLoginMessage"]</p>
</div>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Navigation.NavigateTo("/login", forceLoad: true, replace: true);
        }
    }
}
