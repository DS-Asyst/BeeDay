@page "/onboarding/tutorial"
@attribute [Authorize]
@layout BeeDay.Web.Components.Layout.OnboardingLayout
@inject BeeDayWebService Store
@inject NavigationManager Navigation

<PageTitle>Getting started | BeeDay</PageTitle>

<section class="tutorial-page beeday-fade-in">
    <article class="tutorial-card">
        <header class="tutorial-header">
            <BeeDayBrand />
            <span class="tutorial-progress">STEP @(_step + 1) OF @Slides.Length</span>
        </header>

        <div class="tutorial-content">
            <div class="tutorial-icon">
                <BeeDayIcon Name="@Slides[_step].Icon"
                           Size="BeeDayIconSize.ExtraLarge"
                           Color="BeeDayIconColor.Primary"
                           Decorative="false"
                           Label="@Slides[_step].IconLabel" />
            </div>
            <p class="tutorial-eyebrow">@Slides[_step].Eyebrow</p>
            <h1>@Slides[_step].Title</h1>
            <p class="tutorial-copy">@Slides[_step].Description</p>

            <div class="tutorial-preview">
                @foreach (var item in Slides[_step].Items)
                {
                    <div class="tutorial-preview__item">
                        <BeeDayIcon Name="BeeDayIconName.Check" Size="BeeDayIconSize.ExtraSmall" Color="BeeDayIconColor.Primary" />
                        <p>@item</p>
                    </div>
                }
            </div>
        </div>

        <footer class="tutorial-actions">
            <BeeDayButton Variant="BeeDayButtonVariant.Back"
                           Disabled="@(_step == 0 || _busy)"
                           OnClick="Previous">
                BACK
            </BeeDayButton>
            <BeeDayButton Variant="BeeDayButtonVariant.Primary"
                           IsLoading="@_busy"
                           Disabled="@_busy"
                           OnClick="NextAsync">
                @(_step == Slides.Length - 1 ? "ENTER BEEDAY" : "NEXT")
            </BeeDayButton>
        </footer>
    </article>
</section>

@code {
    private int _step;
    private bool _busy;

    private static readonly TutorialSlide[] Slides =
    [
        new("01 — DAILY", "Your command center", BeeDayIconName.Daily, "Daily", "Daily keeps the actions that move your life forward in one place.",
            ["Review today before starting", "Keep each item small and actionable", "Return throughout the day"]),
        new("02 — HABITS", "Build your rhythm", BeeDayIconName.Habit, "Habits", "Habits are recurring behaviors. Register progress consistently and watch momentum grow.",
            ["Use positive habits to reinforce progress", "Use negative actions when accountability helps", "Let streaks reveal consistency"]),
        new("03 — TASKS", "Handle recurring work", BeeDayIconName.Completed, "Tasks", "Tasks can repeat daily, weekly or monthly and are completed manually.",
            ["Choose a recurrence that matches reality", "Complete the task when the cycle is done", "Keep tasks independent from projects"]),
        new("04 — PROJECTS", "Turn goals into progress", BeeDayIconName.Project, "Projects", "Projects represent objectives. Their To-Dos define the work and calculate completion.",
            ["Create the project first", "Add focused To-Dos", "Finish every To-Do to complete the project"]),
        new("05 — READY", "You're all set", BeeDayIconName.Profile, "Profile ready", "Your account and profile are ready. The Daily is now yours.",
            ["Start with one habit", "Add one meaningful task", "Create one project you care about"])
    ];

    protected override async Task OnInitializedAsync()
    {
        var user = await Store.GetCurrentUserAsync();
        if (user?.HasProfile != true)
        {
            Navigation.NavigateTo("/profile/create", forceLoad: true, replace: true);
            return;
        }

        if (user.HasCompletedOnboarding)
        {
            Navigation.NavigateTo("/home", forceLoad: true, replace: true);
        }
    }

    private void Previous()
    {
        if (_step > 0)
        {
            _step--;
        }
    }

    private async Task NextAsync()
    {
        if (_step < Slides.Length - 1)
        {
            _step++;
            return;
        }

        _busy = true;
        try
        {
            await Store.CompleteOnboardingAsync();
            Navigation.NavigateTo("/home", forceLoad: true, replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record TutorialSlide(
        string Eyebrow,
        string Title,
        BeeDayIconName Icon,
        string IconLabel,
        string Description,
        string[] Items);
}
