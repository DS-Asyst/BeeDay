@using BeeDay.Domain.Enums
@inject IStringLocalizer<ProjectResources> Localizer

<EditorModalShell Model="Model"
                  Title="@(IsEditing ? Localizer["EditProjectTitle"] : Localizer["CreateProjectTitle"])"
                  TitleId="project-editor-title"
                  SubmitLabel="@(IsEditing ? Localizer["SaveButtonLabel"] : Localizer["CreateButtonLabel"])"
                  ShowDelete="IsEditing"
                  OnSubmit="Save"
                  OnCancel="Cancel"
                  OnDelete="RequestDelete">
    <HeroContent>
        <div class="editor-modal__hero">
            <BeeDayInput Id="project-title"
                          Label="@Localizer["TitleFieldLabel"]"
                          Required="true"
                          @bind-Value="Model.Title"
                          Placeholder="@Localizer["TitlePlaceholder"]"
                          MaxLength="100"
                          FieldCssClass="editor-modal__hero-field"
                          LabelCssClass="editor-modal__label-line"
                          autofocus />
            <BeeDayTextArea Id="project-notes"
                             Label="@Localizer["NotesLabel"]"
                             @bind-Value="Model.Description"
                             Placeholder="@Localizer["NotesPlaceholder"]"
                             MaxLength="500"
                             ShowCounter="true"
                             FieldCssClass="editor-modal__hero-field"
                             LabelCssClass="editor-modal__label-line"
                             CounterCssClass="editor-modal__counter" />
        </div>
    </HeroContent>
    <BodyContent>
        <div class="editor-modal__body">
            <div class="editor-modal__type-summary"><BeeDayIcon Name="BeeDayIconName.Project" Size="BeeDayIconSize.Large" Class="editor-modal__type-icon" Decorative="true" /><div><strong>@Localizer["ProjectLabel"]</strong><p>@Localizer["ProjectSummaryDescription"]</p></div></div>
            <BeeDayDateInput TValue="DateTime?"
                              Id="project-expected-date"
                              Label="@Localizer["ExpectedDateLabel"]"
                              @bind-Value="Model.ExpectedDate"
                              FieldCssClass="editor-modal__field" />
        </div>
    </BodyContent>
    <SecondaryAction>
        @if (IsEditing)
        {
            <BeeDayButton Variant="BeeDayButtonVariant.Secondary"
                           Compact="true"
                           OnClick="OpenProject">@Localizer["OpenProjectButton"]</BeeDayButton>
        }
    </SecondaryAction>
</EditorModalShell>

<BeeDayConfirmDialog IsOpen="showDeleteConfirmation"
                      Title="@Localizer["DeleteProjectTitle"]"
                      Message="@Localizer["DeleteProjectMessage"]"
                      ItemTitle="@Model.Title"
                      Warning="@Localizer["DeleteProjectWarning"]"
                      WarningDetails="@Localizer["DeleteProjectWarningDetails"]"
                      ConfirmLabel="@Localizer["DeleteProjectTitle"]"
                      OnConfirm="ConfirmDelete"
                      OnCancel="CloseDeleteConfirmation" />
