@page "/account/resend-confirmation"
@attribute [AllowAnonymous]
@layout OnboardingLayout
@implements IDisposable
@using BeeDay.Web.Components.Features.Identity
@using BeeDay.Web.Localization
@inject MediatR.ISender Sender
@inject IStringLocalizer<IdentityResources> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer

<PageTitle>@Localizer["ResendConfirmationPageTitle"]</PageTitle>
<section class="identity-page beeday-fade-in"><div class="identity-card"><div class="identity-card__content">
<div class="identity-card__brand"><BeeDayBrand /></div>
<header class="identity-header"><h1>@Localizer["ResendConfirmationHeading"]</h1><p>@Localizer["ResendConfirmationIntro"]</p></header>
@if (_submitted) { <div class="identity-feedback identity-feedback--success" role="status">@Localizer["ResendSubmittedMessage"]</div> }
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="identity-feedback identity-feedback--error" role="alert">@_error</div> }
<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="identity-form">
<DataAnnotationsValidator />
<BeeDayInput Id="resend-confirmation-email" Label="@Localizer["EmailLabel"]" Required="true"
             type="email" autocomplete="email" Disabled="@_busy" @bind-Value="_model.Email" />
<BeeDayButton Type="submit" FullWidth="true" IsLoading="@_busy" Disabled="@(_busy || _secondsRemaining > 0)">@ButtonText</BeeDayButton>
</EditForm>
<a class="identity-navigation-link" href="/login">@Localizer["BackToSignIn"]</a>
</div></div></section>
@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    private readonly EmailForm _model = new(); private bool _busy; private bool _submitted; private string? _error; private int _secondsRemaining; private PeriodicTimer? _timer; private CancellationTokenSource? _countdownCts;
    // Separate from _countdownCts above (cancelled/recreated every StartCountdown call) — this one
    // spans the page's whole lifetime and only cancels on Dispose, so the mutation call itself is
    // cancelled if the user navigates away mid-request.
    private readonly CancellationTokenSource _pageCts = new();
    private string ButtonText => _busy
        ? Localizer["SendingButton"]
        : _secondsRemaining > 0
            ? Localizer["ResendAvailableInSeconds", _secondsRemaining]
            : Localizer["ResendEmailButton"];
    protected override void OnParametersSet() { if (!string.IsNullOrWhiteSpace(Email) && string.IsNullOrWhiteSpace(_model.Email)) _model.Email = Email.Trim(); }
    private async Task SubmitAsync() { if (_busy || _secondsRemaining > 0) return; _busy=true; _error=null; try { await Sender.Send(new BeeDay.Application.Features.Identity.Commands.ResendEmailConfirmationCommand(new(_model.Email)), _pageCts.Token); _submitted=true; StartCountdown(); } catch(OperationCanceledException) when (_pageCts.IsCancellationRequested) { } catch(Exception ex) { _error=DomainErrorLocalizer.Translate(ex, SharedLocalizer); } finally { _busy=false; } }
    private void StartCountdown() { _secondsRemaining=60; _countdownCts?.Cancel(); _countdownCts?.Dispose(); _timer?.Dispose(); _countdownCts=new(); _timer=new(TimeSpan.FromSeconds(1)); _=RunCountdownAsync(_countdownCts.Token); }
    private async Task RunCountdownAsync(CancellationToken token) { try { while (_secondsRemaining>0 && await _timer!.WaitForNextTickAsync(token)) { _secondsRemaining--; await InvokeAsync(StateHasChanged); } } catch(OperationCanceledException) { } }
    public void Dispose() { _countdownCts?.Cancel(); _countdownCts?.Dispose(); _timer?.Dispose(); _pageCts.Cancel(); _pageCts.Dispose(); }
    private sealed class EmailForm { [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress] public string Email { get; set; } = string.Empty; }
}
