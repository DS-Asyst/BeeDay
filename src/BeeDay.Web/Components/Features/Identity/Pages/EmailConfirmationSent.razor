@page "/account/email-confirmation-sent"
@attribute [AllowAnonymous]
@layout OnboardingLayout
@implements IDisposable
@using BeeDay.Web.Components.Features.Identity
@using BeeDay.Web.Localization
@inject MediatR.ISender Sender
@inject IStringLocalizer<IdentityResources> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer

<PageTitle>@Localizer["EmailConfirmationSentPageTitle"]</PageTitle>
<section class="identity-page beeday-fade-in"><div class="identity-card"><div class="identity-card__content">
<div class="identity-card__brand"><BeeDayBrand /></div>
<header class="identity-header"><h1>@Localizer["CheckYourEmailHeading"]</h1><p>@Localizer["CheckYourEmailIntro"]</p></header>
@if (_resent) { <div class="identity-feedback identity-feedback--success" role="status">@Localizer["ResendSubmittedMessage"]</div> }
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="identity-feedback identity-feedback--error" role="alert">@_error</div> }
<div class="identity-note"><strong>@DisplayEmail</strong><span>@Localizer["ConfirmationNote"]</span></div>
<BeeDayButton FullWidth="true" IsLoading="@_busy" Disabled="@(_busy || _cooldown.SecondsRemaining > 0)" OnClick="ResendAsync">@ButtonText</BeeDayButton>
<a class="identity-navigation-link" href="/login">@Localizer["BackToSignIn"]</a>
</div></div></section>
@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    private bool _busy; private bool _resent; private string? _error;
    private readonly ResendCooldownTimer _cooldown;
    // Separate from _cooldown above (cancelled/recreated every Start call) — this one spans the
    // page's whole lifetime and only cancels on Dispose, so the mutation call itself is cancelled
    // if the user navigates away mid-request.
    private readonly CancellationTokenSource _pageCts = new();
    public EmailConfirmationSent() => _cooldown = new ResendCooldownTimer(() => InvokeAsync(StateHasChanged));
    private string DisplayEmail => string.IsNullOrWhiteSpace(Email) ? Localizer["YourEmailAddressFallback"] : Email.Trim();
    private string ButtonText => _busy
        ? Localizer["SendingButton"]
        : _cooldown.SecondsRemaining > 0
            ? Localizer["ResendAvailableInSeconds", _cooldown.SecondsRemaining]
            : Localizer["ResendConfirmationButton"];
    private async Task ResendAsync() { if (_busy || _cooldown.SecondsRemaining>0 || string.IsNullOrWhiteSpace(Email)) return; _busy=true; _error=null; try { await Sender.Send(new BeeDay.Application.Features.Identity.Commands.ResendEmailConfirmationCommand(new(Email.Trim())), _pageCts.Token); _resent=true; _cooldown.Start(); } catch(OperationCanceledException) when (_pageCts.IsCancellationRequested) { } catch(Exception ex) { _error=DomainErrorLocalizer.Translate(ex, SharedLocalizer); } finally { _busy=false; } }
    public void Dispose(){_cooldown.Dispose();_pageCts.Cancel();_pageCts.Dispose();}
}
