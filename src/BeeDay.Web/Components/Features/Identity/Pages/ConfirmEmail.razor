@page "/account/confirm-email"
@attribute [AllowAnonymous]
@layout OnboardingLayout
@implements IDisposable
@using BeeDay.Web.Components.Features.Identity
@inject MediatR.ISender Sender
@inject IStringLocalizer<IdentityResources> Localizer

<PageTitle>@Localizer["ConfirmEmailPageTitle"]</PageTitle>

<section class="identity-page beeday-fade-in">
    <div class="identity-card">
        <div class="identity-card__content">
            <div class="identity-card__brand"><BeeDayBrand /></div>

            @switch (_state)
            {
                case ConfirmationPageState.Processing:
                    <header class="identity-header">
                        <h1>@Localizer["ConfirmingEmailHeading"]</h1>
                        <p>@Localizer["ValidatingLinkIntro"]</p>
                    </header>
                    break;

                case ConfirmationPageState.Confirmed:
                    <header class="identity-header">
                        <h1>@Localizer["EmailConfirmedHeading"]</h1>
                        <p>@Localizer["AccountReadyIntro"]</p>
                    </header>
                    <div class="identity-feedback identity-feedback--success" role="status">
                        @Localizer["ConfirmationCompletedMessage"]
                    </div>
                    <a class="identity-navigation-link identity-navigation-link--primary" href="/login?confirmed=true">@Localizer["SignIn"]</a>
                    break;

                case ConfirmationPageState.AlreadyConfirmed:
                    <header class="identity-header">
                        <h1>@Localizer["AlreadyConfirmedHeading"]</h1>
                        <p>@Localizer["AlreadyConfirmedIntro"]</p>
                    </header>
                    <div class="identity-feedback identity-feedback--success" role="status">
                        @Localizer["CanSignInNormallyMessage"]
                    </div>
                    <a class="identity-navigation-link identity-navigation-link--primary" href="/login">@Localizer["SignIn"]</a>
                    break;

                case ConfirmationPageState.Expired:
                    <header class="identity-header">
                        <h1>@Localizer["LinkExpiredHeading"]</h1>
                        <p>@Localizer["LinkExpiredIntro"]</p>
                    </header>
                    <div class="identity-feedback identity-feedback--error" role="alert">@_error</div>
                    <a class="identity-navigation-link" href="/account/resend-confirmation">@Localizer["RequestNewLink"]</a>
                    break;

                case ConfirmationPageState.Replaced:
                    <header class="identity-header">
                        <h1>@Localizer["LinkReplacedHeading"]</h1>
                        <p>@Localizer["LinkReplacedIntro"]</p>
                    </header>
                    <div class="identity-feedback identity-feedback--error" role="alert">
                        @Localizer["UseMostRecentLinkMessage"]
                    </div>
                    <a class="identity-navigation-link" href="/account/resend-confirmation">@Localizer["RequestNewLink"]</a>
                    break;

                default:
                    <header class="identity-header">
                        <h1>@Localizer["InvalidLinkHeading"]</h1>
                        <p>@Localizer["InvalidLinkIntro"]</p>
                    </header>
                    <div class="identity-feedback identity-feedback--error" role="alert">@_error</div>
                    <a class="identity-navigation-link" href="/account/resend-confirmation">@Localizer["RequestNewLink"]</a>
                    break;
            }
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ConfirmationPageState _state = ConfirmationPageState.Processing;
    private string _error = string.Empty;
    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        _error = Localizer["DefaultConfirmationError"];

        if (string.IsNullOrWhiteSpace(Token))
        {
            _state = ConfirmationPageState.Invalid;
            _error = Localizer["ConfirmationTokenMissingError"];
            return;
        }

        // This page's @rendermode (InteractiveServer, set globally on <Routes> in App.razor) still
        // statically prerenders once before the interactive circuit takes over — OnInitializedAsync
        // runs on BOTH passes. The missing-token check above is pure input validation and safe to
        // run on both; sending ConfirmEmailCommand is not — doing so on the static pass would
        // consume the token there, and the token-replay guard would then correctly (but confusingly,
        // to a real user on their first legitimate click) reject the interactive pass's identical
        // resend a moment later, showing "already used" instead of "confirmed". Deferring only this
        // mutating call to the interactive pass is the pattern Microsoft's own docs recommend for a
        // prerendered component with a non-idempotent OnInitializedAsync side effect — the static
        // pass renders the default Processing state, exactly the "please wait" UI a real
        // confirmation link should show first regardless.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            await Sender.Send(new BeeDay.Application.Features.Identity.Commands.ConfirmEmailCommand(
                new BeeDay.Application.Features.Identity.Requests.ConfirmEmailRequest(Token)), _cts.Token);
            _state = ConfirmationPageState.Confirmed;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _state = Classify(exception.Message);
            _error = _state switch
            {
                ConfirmationPageState.Expired => Localizer["LinkExpiredMessage"],
                ConfirmationPageState.Invalid => Localizer["InvalidLinkMessage"],
                _ => _error
            };
        }
    }

    private static ConfirmationPageState Classify(string message)
    {
        if (message.Contains("already been used", StringComparison.OrdinalIgnoreCase))
        {
            return ConfirmationPageState.AlreadyConfirmed;
        }

        if (message.Contains("expired", StringComparison.OrdinalIgnoreCase))
        {
            return ConfirmationPageState.Expired;
        }

        if (message.Contains("revoked", StringComparison.OrdinalIgnoreCase))
        {
            return ConfirmationPageState.Replaced;
        }

        return ConfirmationPageState.Invalid;
    }

    private enum ConfirmationPageState
    {
        Processing,
        Confirmed,
        AlreadyConfirmed,
        Expired,
        Replaced,
        Invalid
    }
}
