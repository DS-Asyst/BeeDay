@page "/login"
@attribute [AllowAnonymous]
@layout BeeDay.Web.Components.Layout.OnboardingLayout
@inject NavigationManager Navigation

<PageTitle>Login | BeeDay</PageTitle>

<section class="auth-page beeday-fade-in" aria-labelledby="login-heading">
    <nav class="auth-page__actions" aria-label="Login actions">
        <a class="auth-page__close" href="/" aria-label="Close login and return to Home">
            <BeeDayIcon Name="BeeDayIconName.Close" Size="BeeDayIconSize.Medium" Decorative="true" />
        </a>
        <a class="beeday-button beeday-button--secondary auth-page__create" href="/profile/create">Create account</a>
    </nav>

    <div class="auth-login">
            <div class="auth-card__brand"><BeeDayBrand /></div>

            <header class="auth-card__header">
                <h1 id="login-heading">Welcome back</h1>
                <p>Sign in to continue your journey.</p>
            </header>

            @if (HasInvalidCredentials)
            {
                <div class="auth-feedback auth-feedback--error" role="alert">
                    Invalid email or password.
                </div>
            }

            @if (WasConfirmed)
            {
                <div class="auth-feedback auth-feedback--success" role="status">Email confirmed. Sign in to continue.</div>
            }

            @if (WasReset)
            {
                <div class="auth-feedback auth-feedback--success" role="status">Password updated. Sign in with your new password.</div>
            }

            @if (SessionExpired)
            {
                <div class="auth-feedback auth-feedback--error" role="alert">
                    Your session expired. Sign in again to continue.
                </div>
            }

            <form method="post" action="/auth/login" class="auth-form" onsubmit="const button=this.querySelector('button[type=submit]');if(button){button.disabled=true;button.textContent='Signing in...';}">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <label class="auth-field">
                    <span>Email</span>
                    <input type="email"
                           class="beeday-field__control"
                           name="email"
                           value="@Email"
                           autocomplete="email"
                           required
                           autofocus />
                </label>

                <label class="auth-field">
                    <span>Password</span>
                    <input type="password"
                           class="beeday-field__control"
                           name="password"
                           autocomplete="current-password"
                           required />
                </label>

                <div class="auth-form__options">
                    <label class="auth-remember"><input type="checkbox" name="rememberMe" value="true" /> <span>Remember me</span></label>
                    <a class="auth-action-link" href="/account/forgot-password">Forgot password?</a>
                </div>

                <BeeDayButton Type="submit" FullWidth="true" Class="auth-submit">
                    Sign In
                </BeeDayButton>
            </form>

    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "confirmed")]
    public bool Confirmed { get; set; }

    [SupplyParameterFromQuery(Name = "reset")]
    public bool Reset { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "expired")]
    public bool Expired { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? RequestedReturnUrl { get; set; }

    private bool HasInvalidCredentials => string.Equals(Error, "invalid", StringComparison.OrdinalIgnoreCase);
    private bool WasConfirmed => Confirmed;
    private bool WasReset => Reset;
    private bool SessionExpired => Expired;
    private string ReturnUrl => IsLocalPath(RequestedReturnUrl) ? RequestedReturnUrl! : string.Empty;

    private static bool IsLocalPath(string? value) =>
        !string.IsNullOrWhiteSpace(value) && value.StartsWith('/') && !value.StartsWith("//");
}
