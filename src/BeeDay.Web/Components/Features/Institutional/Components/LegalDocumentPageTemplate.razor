@using BeeDay.Web.Components.DesignSystem
@using BeeDay.Web.Components.Features.Institutional

@* Legal/document family: Community guidelines, Terms, Privacy (04_PAGES_AND_ROUTES.md) — "Privacy
   and terms" in AppFooter.razor. Reading width is prioritized over decoration; no fabricated legal
   content — see each page's own remarks. Defaults to Cor8 (dark navy), not Cor0, per the page-header
   eligibility contract in docs/brand/03-color-palette.md — legal/document pages don't share
   Editorial/Help/Product's brand-primary default. *@
<InstitutionalPageShell PageContext="@PageContext" Title="@Title" Description="@Description" Surface="Surface" Section="EditorialSection.Legal">
    @ChildContent
</InstitutionalPageShell>

@code {
    [Parameter, EditorRequired] public string PageContext { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public BeeDayPaletteToken Surface { get; set; } = BeeDayPaletteToken.Cor8;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
