@using BeeDay.Web.Components.DesignSystem
@using BeeDay.Web.Components.DesignSystem.Layout
@using BeeDay.Web.Components.DesignSystem.Text

@* Sprint 29.2: the hero is a sibling of the body article — both direct children of PublicLayout's
   <main> — instead of nested inside a single wrapping <article>. polish.css's shared reading-width
   rule (`.beeday-main > :where(section, article, .beeday-page, .page-content)`) matches direct
   children only; nesting the hero inside that article previously capped its own full-bleed
   background to the 72rem reading width, rendering it as a small centered card instead of a
   full-width colored band (docs/web/03-layouts.md). Mirrors the sibling structure ExperienceSystemPage
   already uses for its own BeeDayHero. *@
<BeeDayHero Surface="Surface" Title="@Title" Subtitle="@Description" Illustration="@Illustration" PrimaryAction="@PrimaryAction">
    <BrandContext>
        @* The lockup TEXT color is forced to inherit the hero's own paired foreground in
           BeeDayHero.razor.css — correct for every COR0-COR9 surface by construction, unlike
           BeeDayBrand's own fixed default/inverse colors. OnDarkSurface is still set here because
           every institutional hero surface is non-white (Sprint 29.2 restricts Surface to Cor0/Cor8,
           see docs/brand/03-color-palette.md), and OnDarkSurface is what selects the official
           non-white-background bee icon (bee-color-neutral.png) instead of the white-surface-only
           brand-purple one. *@
        <BeeDayBrand OnDarkSurface="true" />
        <span class="institutional-hero__context-label">@PageContext</span>
    </BrandContext>
</BeeDayHero>
<article class="institutional-page__body">
    @ChildContent
</article>

@code {
    /// <summary>The page's name as shown next to the brand lockup in the hero, e.g. "Mission".</summary>
    [Parameter, EditorRequired] public string PageContext { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }

    /// <summary>
    /// Solid page-header background. Restricted in practice to Cor0/Cor8 by the four templates —
    /// the only two COR0-COR9 tokens whose contrast with white text passes WCAG AA (4.5:1), per the
    /// page-header contract in docs/brand/03-color-palette.md. Kept as the full BeeDayPaletteToken
    /// type (not a narrower enum) because the restriction is this page family's policy, not a
    /// constraint on BeeDayHero itself, which other consumers (e.g. Wallet) use with Cor0 too.
    /// </summary>
    [Parameter] public BeeDayPaletteToken Surface { get; set; } = BeeDayPaletteToken.Cor0;
    [Parameter] public RenderFragment? Illustration { get; set; }
    [Parameter] public RenderFragment? PrimaryAction { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
