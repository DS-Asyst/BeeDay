@page "/faqs"
@attribute [AllowAnonymous]
@layout BeeDay.Web.Components.Layout.EditorialLayout
@using BeeDay.Web.Components.Features.Institutional.Components
@inject IStringLocalizer<InstitutionalResources> Localizer

<PageTitle>@Localizer["FaqsPageTitle"]</PageTitle>

<HelpPageTemplate PageContext="@Localizer["FaqsPageContext"]" Title="@Localizer["FaqsTitle"]" Description="@Localizer["FaqsIntro"]">
    <div class="institutional-faq">
        <details class="institutional-faq__item">
            <summary>@Localizer["FaqsQ1Question"]</summary>
            <p>@Localizer["FaqsQ1Answer"]</p>
        </details>
        <details class="institutional-faq__item">
            <summary>@Localizer["FaqsQ2Question"]</summary>
            <p>@Localizer["FaqsQ2Answer"]</p>
        </details>
        <details class="institutional-faq__item">
            <summary>@Localizer["FaqsQ3Question"]</summary>
            <p>@Localizer["FaqsQ3Answer"]</p>
        </details>
        <details class="institutional-faq__item">
            <summary>@Localizer["FaqsQ4Question"]</summary>
            <p>@Localizer["FaqsQ4AnswerLeadIn"] <a class="beeday-link" href="/contact">@Localizer["FaqsQ4ContactLinkLabel"]</a> @Localizer["FaqsQ4AnswerTrailer"]</p>
        </details>
    </div>
</HelpPageTemplate>
