@page "/efficacy"
@attribute [AllowAnonymous]
@layout BeeDay.Web.Components.Layout.EditorialLayout
@using BeeDay.Web.Components.Features.Institutional.Components
@inject IStringLocalizer<InstitutionalResources> Localizer

<PageTitle>@Localizer["EfficacyPageTitle"]</PageTitle>

@* Sprint 29.4: the pending-evidence disclosure keeps its own heading and highlighted callout instead
   of becoming a story block — it is a distinct honesty notice, not narrative prose, and must not be
   visually flattened to the same weight as the rest (§14). No claim, metric, or study is added. *@
<EditorialPageTemplate PageContext="@Localizer["EfficacyPageContext"]" Title="@Localizer["EfficacyTitle"]" Description="@Localizer["EfficacyIntro"]">
    <div class="editorial-story-blocks">
        <EditorialStoryBlock Headline="@Localizer["EfficacyBodyTitle"]" Support="@Localizer["EfficacyBody"]" />
    </div>
    <section aria-labelledby="efficacy-pending-heading">
        <h2 id="efficacy-pending-heading">@Localizer["EfficacyPendingEvidenceTitle"]</h2>
        <p class="institutional-pending-notice">@Localizer["EfficacyPendingEvidenceBody"]</p>
    </section>
</EditorialPageTemplate>
