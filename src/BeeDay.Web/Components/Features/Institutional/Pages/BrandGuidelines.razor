@page "/brand-guidelines"
@attribute [AllowAnonymous]
@layout BeeDay.Web.Components.Layout.PublicLayout
@using BeeDay.Web.Components.DesignSystem
@using BeeDay.Web.Components.Features.Institutional.Components
@inject IStringLocalizer<InstitutionalResources> Localizer

<PageTitle>@Localizer["BrandGuidelinesPageTitle"]</PageTitle>

@* Sprint 27.3 scaffold: the documentation-shell template (sidebar navigation over the beeday
   Experience System content) is Sprint 27.8's explicit scope. Until then this route resolves with
   the standard institutional shell and links straight to the existing Experience System. *@
<EditorialPageTemplate PageContext="@Localizer["BrandGuidelinesPageContext"]" Title="@Localizer["BrandGuidelinesTitle"]" Description="@Localizer["BrandGuidelinesIntro"]" Surface="BeeDayPaletteToken.Cor8">
    <section aria-labelledby="brand-guidelines-body-heading">
        <h2 id="brand-guidelines-body-heading">@Localizer["BrandGuidelinesBodyTitle"]</h2>
        <p>@Localizer["BrandGuidelinesBody"]</p>
        <p><a class="beeday-link" href="/experience-system">@Localizer["BrandGuidelinesLinkLabel"]</a></p>
    </section>
</EditorialPageTemplate>
