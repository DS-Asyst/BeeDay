@page "/"
@attribute [AllowAnonymous]
@layout BeeDay.Web.Components.Layout.PublicLayout
@using BeeDay.Web.Components.Features.Home
@using BeeDay.Web.Services.Authentication
@inject NavigationManager Navigation
@inject AuthenticatedEntryDestinationResolver DestinationResolver
@inject PublicHomeLanguageState LanguageState
@implements IDisposable

<PageTitle>@Copy.PageTitle</PageTitle>

<article class="home-page">
    <section class="home-hero" aria-labelledby="home-heading">
        <div class="home-hero__inner">
            <div class="home-hero__visual" aria-hidden="true">
                <img class="home-hero__image" src="/assets/hero/home-team.png" alt="" width="1536" height="1024" />
            </div>
            <div class="home-hero__content">
                <h1 id="home-heading">@Copy.HeroHeading</h1>
                <p>@Copy.HeroDescription</p>
                <div class="home-hero__actions">
                    <AuthorizeView>
                        <Authorized><BeeDayButton OnClick="ContinueToBeeDay">@Copy.ContinueToBeeDay</BeeDayButton></Authorized>
                        <NotAuthorized>
                            <a class="beeday-button beeday-button--primary home-hero__start" href="/profile/create">@Copy.GetStarted</a>
                            <a class="beeday-button beeday-button--secondary home-hero__login" href="/login">@Copy.AlreadyHaveAccount</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </section>

    <section class="home-section" aria-labelledby="how-heading">
        <div class="home-section__heading">
            <span class="home-page__eyebrow">@Copy.StepsEyebrow</span>
            <h2 id="how-heading">@Copy.StepsHeading</h2>
            <p>@Copy.StepsDescription</p>
        </div>
        <ol class="home-steps">
            <li><span>1</span><div><h3>@Copy.Step1Title</h3><p>@Copy.Step1Description</p></div></li>
            <li><span>2</span><div><h3>@Copy.Step2Title</h3><p>@Copy.Step2Description</p></div></li>
            <li><span>3</span><div><h3>@Copy.Step3Title</h3><p>@Copy.Step3Description</p></div></li>
        </ol>
    </section>
</article>

@code {
    private PublicHomeCopy Copy => PublicHomeCopy.For(LanguageState.Language);

    protected override void OnInitialized() => LanguageState.Changed += HandleLanguageChanged;

    private async Task ContinueToBeeDay()
    {
        var destination = await DestinationResolver.ResolveAsync();
        Navigation.NavigateTo(destination, forceLoad: true, replace: true);
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => LanguageState.Changed -= HandleLanguageChanged;
}
