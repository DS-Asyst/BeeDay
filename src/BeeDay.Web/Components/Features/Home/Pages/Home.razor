@page "/"
@attribute [AllowAnonymous]
@layout BeeDay.Web.Components.Layout.PublicLayout
@using BeeDay.Web.Services.Authentication
@inject NavigationManager Navigation
@inject AuthenticatedEntryDestinationResolver DestinationResolver

<PageTitle>BeeDay — Be better every day</PageTitle>

<article class="home-page">
    <section class="home-hero">
        <div class="home-hero__inner">
            <span class="home-hero__eyebrow">BEEDAY</span>
            <h1 class="home-hero__headline">Be better every day</h1>
            <p class="home-hero__subtitle">
                A simple daily loop for habits, tasks, projects, and money — with light gamification
                that keeps your progress visible.
            </p>
            <div class="home-hero__actions">
                <AuthorizeView>
                    <Authorized>
                        <BeeDayButton OnClick="ContinueToBeeDay">Continue to BeeDay</BeeDayButton>
                    </Authorized>
                    <NotAuthorized>
                        <BeeDayButton OnClick="GoToLogin">Get started</BeeDayButton>
                    </NotAuthorized>
                </AuthorizeView>
                <a class="home-hero__secondary-action" href="#capabilities">See what's inside</a>
            </div>
        </div>
    </section>

    <div class="home-page__content">
        <section class="home-page__split" id="capabilities" aria-labelledby="capabilities-heading">
            <div class="home-page__split-text">
                <span class="home-page__eyebrow">CONSISTENCY OVER INTENSITY</span>
                <h2 id="capabilities-heading">Small actions, every day</h2>
                <p>
                    BeeDay keeps your habits, tasks, projects, and money in one daily loop, so progress
                    stays visible instead of scattered across notes and reminders.
                </p>
            </div>

            <BeeDayCard Padded="true" Class="home-page__showcase" aria-label="BeeDay capabilities">
                <div class="home-page__showcase-row">
                    <PixelIcon Name="PixelIconName.Daily" Size="PixelIconSize.Medium" Color="PixelIconColor.Primary" />
                    <div>
                        <h3>Daily</h3>
                        <p>Daily keeps the actions that move your life forward in one place.</p>
                    </div>
                </div>
                <div class="home-page__showcase-row">
                    <PixelIcon Name="PixelIconName.Streak" Size="PixelIconSize.Medium" Color="PixelIconColor.Primary" />
                    <div>
                        <h3>Habits</h3>
                        <p>Habits are recurring behaviors. Register progress consistently and watch momentum grow.</p>
                    </div>
                </div>
                <div class="home-page__showcase-row">
                    <PixelIcon Name="PixelIconName.RecurringTask" Size="PixelIconSize.Medium" Color="PixelIconColor.Primary" />
                    <div>
                        <h3>Tasks</h3>
                        <p>Tasks can repeat daily, weekly or monthly and are completed manually.</p>
                    </div>
                </div>
                <div class="home-page__showcase-row">
                    <PixelIcon Name="PixelIconName.Project" Size="PixelIconSize.Medium" Color="PixelIconColor.Primary" />
                    <div>
                        <h3>Projects</h3>
                        <p>Projects represent objectives. Their To-Dos define the work and calculate completion.</p>
                    </div>
                </div>
                <div class="home-page__showcase-row">
                    <PixelIcon Name="PixelIconName.Wallet" Size="PixelIconSize.Medium" Color="PixelIconColor.Primary" />
                    <div>
                        <h3>Wallet</h3>
                        <p>Track transactions, organize tags, and understand where your money goes.</p>
                    </div>
                </div>
            </BeeDayCard>
        </section>

        <section class="home-page__split home-page__split--reverse" id="progress" aria-labelledby="progress-heading">
            <div class="home-page__split-text">
                <span class="home-page__eyebrow">GROWTH, NOT PRESSURE</span>
                <h2 id="progress-heading">Progress you can see</h2>
                <p>
                    Every habit, task, and project you complete earns experience and grows your level —
                    a light, visible way to feel your consistency add up, without turning your day into
                    a game.
                </p>
            </div>

            <BeeDayCard Padded="true" Class="home-page__progress-visual" aria-hidden="true">
                <div class="home-page__progress-icons">
                    <PixelIcon Name="PixelIconName.Experience" Size="PixelIconSize.ExtraLarge" Color="PixelIconColor.Primary" />
                    <PixelIcon Name="PixelIconName.Level" Size="PixelIconSize.ExtraLarge" Color="PixelIconColor.Primary" />
                </div>
                <span>Level up as you go</span>
            </BeeDayCard>
        </section>
    </div>

    <section class="home-cta" aria-labelledby="home-cta-heading">
        <div class="home-cta__inner">
            <h2 id="home-cta-heading">Make today count.</h2>
            <p>Start small. Come back tomorrow. Be better every day.</p>
            <AuthorizeView>
                <Authorized>
                    <BeeDayButton OnClick="ContinueToBeeDay">Continue to BeeDay</BeeDayButton>
                </Authorized>
                <NotAuthorized>
                    <BeeDayButton OnClick="GoToLogin">Get started</BeeDayButton>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>
</article>

@code {
    private void GoToLogin() => Navigation.NavigateTo("/login");

    private async Task ContinueToBeeDay()
    {
        var destination = await DestinationResolver.ResolveAsync();
        Navigation.NavigateTo(destination, forceLoad: true, replace: true);
    }
}
