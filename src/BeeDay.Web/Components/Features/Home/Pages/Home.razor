@page "/"
@attribute [AllowAnonymous]
@layout BeeDay.Web.Components.Layout.PublicLayout
@using BeeDay.Web.Components.Features.Home
@using BeeDay.Web.Services.Authentication
@using BeeDay.Web.Resources
@inject NavigationManager Navigation
@inject AuthenticatedEntryDestinationResolver DestinationResolver
@inject IStringLocalizer<HomeResources> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<article class="home-page">
    <section class="home-hero" aria-labelledby="home-heading">
        <div class="home-hero__inner">
            <div class="home-hero__visual" aria-hidden="true">
                <img class="home-hero__image" src="/assets/hero/home-team.png" alt="" width="1536" height="1024" />
            </div>
            <div class="home-hero__content">
                <h1 id="home-heading">@Localizer["HeroHeading"]</h1>
                <p>@Localizer["HeroDescription"]</p>
                <div class="home-hero__actions">
                    <AuthorizeView>
                        <Authorized><BeeDayButton OnClick="ContinueToBeeDay">@SharedLocalizer["ContinueToBeeDay"]</BeeDayButton></Authorized>
                        <NotAuthorized>
                            <a class="beeday-button beeday-button--primary home-hero__start" href="/profile/create">@Localizer["GetStarted"]</a>
                            <a class="beeday-button beeday-button--secondary home-hero__login" href="/login">@Localizer["AlreadyHaveAccount"]</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </section>

    <section class="home-how" aria-labelledby="how-heading">
        <div class="home-how__inner">
            <div class="home-section__heading">
                <span class="home-page__eyebrow">@Localizer["StepsEyebrow"]</span>
                <h2 id="how-heading">@Localizer["StepsHeading"]</h2>
                <p>@Localizer["StepsDescription"]</p>
            </div>
            <div class="home-how__composition">
                <div class="home-how__visual" aria-hidden="true">
                    <img src="/assets/home/how-beeday-works-bee.png" alt="" width="1254" height="1254" loading="lazy" />
                </div>
                <ol class="home-steps">
                    <li><span>1</span><div><h3>@Localizer["Step1Title"]</h3><p>@Localizer["Step1Description"]</p></div></li>
                    <li><span>2</span><div><h3>@Localizer["Step2Title"]</h3><p>@Localizer["Step2Description"]</p></div></li>
                    <li><span>3</span><div><h3>@Localizer["Step3Title"]</h3><p>@Localizer["Step3Description"]</p></div></li>
                </ol>
            </div>
        </div>
    </section>
</article>

@code {
    private async Task ContinueToBeeDay()
    {
        var destination = await DestinationResolver.ResolveAsync();
        Navigation.NavigateTo(destination, forceLoad: true, replace: true);
    }
}
