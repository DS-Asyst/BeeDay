@page "/"
@attribute [AllowAnonymous]
@layout BeeDay.Web.Components.Layout.PublicLayout
@using BeeDay.Web.Services.Authentication
@inject NavigationManager Navigation
@inject AuthenticatedEntryDestinationResolver DestinationResolver

<PageTitle>BeeDay — Be better every day</PageTitle>

<article class="home-page">
    <section class="home-hero" aria-labelledby="home-heading">
        <div class="home-hero__inner">
            <div class="home-hero__symbol" aria-hidden="true"><BeeDayIcon Name="BeeDayIconName.Daily" Size="BeeDayIconSize.ExtraLarge" Decorative="true" /></div>
            <div class="home-hero__brand"><BeeDayBrand /></div>
            <h1 id="home-heading">Build a better day, one step at a time.</h1>
            <p>Keep your habits, tasks, and personal progress together.</p>
            <div class="home-hero__actions">
                <AuthorizeView>
                    <Authorized><BeeDayButton OnClick="ContinueToBeeDay">Continue to BeeDay</BeeDayButton></Authorized>
                    <NotAuthorized>
                        <a class="beeday-button beeday-button--primary" href="/profile/create">Get started</a>
                        <a class="home-hero__login" href="/login">I already have an account</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </section>

    <section class="home-section" aria-labelledby="how-heading">
        <div class="home-section__heading">
            <span class="home-page__eyebrow">A SIMPLE DAILY LOOP</span>
            <h2 id="how-heading">How BeeDay works</h2>
            <p>Start with what matters, turn it into action, and let consistency build the result.</p>
        </div>
        <ol class="home-steps">
            <li><span>1</span><div><h3>Define</h3><p>Choose what you want to improve.</p></div></li>
            <li><span>2</span><div><h3>Practice</h3><p>Keep realistic daily actions in view.</p></div></li>
            <li><span>3</span><div><h3>Evolve</h3><p>See completed work become progress.</p></div></li>
        </ol>
    </section>
</article>

@code {
    private async Task ContinueToBeeDay()
    {
        var destination = await DestinationResolver.ResolveAsync();
        Navigation.NavigateTo(destination, forceLoad: true, replace: true);
    }
}
