@using BeeDay.Application.Features.Wallets.Responses
@using BeeDay.Web.Components.Features.Wallets.Services

<section class="wallet-summary" aria-label="Wallet summary">
    <LevelUpCard Class="@($"wallet-summary__card wallet-summary__card--balance {(HighlightBalance ? "wallet-summary__card--updated" : string.Empty)}")">
        <span class="wallet-summary__label"><PixelIcon Name="PixelIconName.Wallet" Size="PixelIconSize.Small" /> Current balance</span>
        <strong>@FormatMoney(Summary?.Balance ?? 0)</strong>
        <small>@(Summary?.TransactionCount ?? 0) transactions</small>
    </LevelUpCard>
    <LevelUpCard Class="wallet-summary__card wallet-summary__card--income">
        <span class="wallet-summary__label"><PixelIcon Name="PixelIconName.Income" Size="PixelIconSize.Small" Color="PixelIconColor.Success" /> Total income</span>
        <strong>@FormatMoney(Summary?.TotalIncome ?? 0)</strong>
        <small>Money added</small>
    </LevelUpCard>
    <LevelUpCard Class="wallet-summary__card wallet-summary__card--expense">
        <span class="wallet-summary__label"><PixelIcon Name="PixelIconName.Expense" Size="PixelIconSize.Small" Color="PixelIconColor.Danger" /> Total expenses</span>
        <strong>@FormatMoney(Summary?.TotalExpenses ?? 0)</strong>
        <small>Money spent</small>
    </LevelUpCard>
</section>

@code {
    [Parameter] public WalletSummaryResponse? Summary { get; set; }
    [Parameter] public bool HighlightBalance { get; set; }
    private static string FormatMoney(decimal value) => WalletCurrencyFormatter.Format(value);
}
