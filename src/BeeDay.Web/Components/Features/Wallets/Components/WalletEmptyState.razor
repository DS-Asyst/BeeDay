<div class="wallet-empty-state">
    <BeeDayEmptyState Title="No transactions found"
                       Description="@(HasFilters ? "Change or clear your filters to see more results." : "Create your first transaction to start tracking your wallet.")"
                       Icon="PixelIconName.Wallet" />
    @if (HasFilters)
    {
        <BeeDayButton Variant="BeeDayButtonVariant.ConfirmationCancel" Disabled="IsDisabled" OnClick="OnClearFilters">Clear filters</BeeDayButton>
    }
    else
    {
        <BeeDayButton Variant="BeeDayButtonVariant.Primary" Disabled="IsDisabled" OnClick="OnCreateTransaction">Create transaction</BeeDayButton>
    }
</div>

@code {
    [Parameter] public bool HasFilters { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public EventCallback OnCreateTransaction { get; set; }
    [Parameter] public EventCallback OnClearFilters { get; set; }
}
