@using BeeDay.Application.Features.Wallets.Responses

<div class="wallet-filter-shell">
    <div class="wallet-filters">
        <label class="wallet-search wallet-filter-field wallet-filter-field--search">
            <span>Search</span>
            <input class="beeday-field__control" disabled="@IsDisabled" value="@Search" @oninput="HandleSearchInput" placeholder="Description or notes" />
        </label>

        <label class="wallet-filter-field">
            <span>Tag</span>
            <select class="beeday-field__control" disabled="@IsDisabled" value="@TagFilter" @onchange="HandleTagChanged">
                <option value="">All tags</option>
                @foreach (var tag in Tags)
                {
                    <option value="@tag.Id">@tag.Name</option>
                }
            </select>
        </label>

        <div class="wallet-filter-field wallet-filter-toggle-field">
            <span aria-hidden="true">&nbsp;</span>
            <BeeDayButton Variant="BeeDayButtonVariant.Secondary"
                           Class="wallet-filter-toggle"
                           Disabled="IsDisabled"
                           OnClick="ToggleSecondaryFilters"
                           aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                           aria-controls="@SecondaryFiltersId">
                More Filters
            </BeeDayButton>
        </div>
    </div>

    <div id="@SecondaryFiltersId" class="wallet-secondary-filters" hidden="@(!isExpanded)">
        @if (isExpanded)
        {
            <label class="wallet-filter-field">
                <span>Type</span>
                <select class="beeday-field__control" disabled="@IsDisabled" value="@TypeFilter" @onchange="HandleTypeChanged">
                    <option value="">All types</option>
                    <option value="Income">Income</option>
                    <option value="Expense">Expense</option>
                </select>
            </label>

            <label class="wallet-filter-field">
                <span>From</span>
                <input class="beeday-field__control" type="date" disabled="@IsDisabled" value="@FormatDate(StartDate)" @onchange="HandleStartDateChanged" />
            </label>

            <label class="wallet-filter-field">
                <span>To</span>
                <input class="beeday-field__control" type="date" disabled="@IsDisabled" value="@FormatDate(EndDate)" @onchange="HandleEndDateChanged" />
            </label>

            <label class="wallet-filter-field">
                <span>Order</span>
                <select class="beeday-field__control" disabled="@IsDisabled" value="@Sort" @onchange="HandleSortChanged">
                    <option value="date-desc">Newest first</option>
                    <option value="date-asc">Oldest first</option>
                </select>
            </label>

            @if (ActiveFilterCount > 0)
            {
                <div class="wallet-active-filters" role="status">
                    <span>@ActiveFilterCount active filter@(ActiveFilterCount == 1 ? string.Empty : "s")</span>
                    <BeeDayButton Variant="BeeDayButtonVariant.ConfirmationCancel"
                                   Class="beeday-button--plain beeday-button--plain-danger"
                                   Disabled="IsDisabled"
                                   OnClick="OnClearFilters">
                        Clear filters
                    </BeeDayButton>
                </div>
            }
        }
    </div>
</div>

@code {
    private const string SecondaryFiltersId = "wallet-secondary-filters";
    private bool isExpanded;

    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public string Search { get; set; } = string.Empty;
    [Parameter] public string TypeFilter { get; set; } = string.Empty;
    [Parameter] public string TagFilter { get; set; } = string.Empty;
    [Parameter] public DateOnly? StartDate { get; set; }
    [Parameter] public DateOnly? EndDate { get; set; }
    [Parameter] public string Sort { get; set; } = "date-desc";
    [Parameter] public int ActiveFilterCount { get; set; }
    [Parameter] public IReadOnlyList<WalletTagResponse> Tags { get; set; } = [];
    [Parameter] public EventCallback<string> SearchChanged { get; set; }
    [Parameter] public EventCallback<string> TypeFilterChanged { get; set; }
    [Parameter] public EventCallback<string> TagFilterChanged { get; set; }
    [Parameter] public EventCallback<DateOnly?> StartDateChanged { get; set; }
    [Parameter] public EventCallback<DateOnly?> EndDateChanged { get; set; }
    [Parameter] public EventCallback<string> SortChanged { get; set; }
    [Parameter] public EventCallback OnClearFilters { get; set; }

    private int SecondaryFilterCount =>
        (string.IsNullOrWhiteSpace(TypeFilter) ? 0 : 1) +
        (StartDate is null ? 0 : 1) +
        (EndDate is null ? 0 : 1) +
        (string.Equals(Sort, "date-desc", StringComparison.Ordinal) ? 0 : 1);

    protected override void OnInitialized() => isExpanded = SecondaryFilterCount > 0;

    private void ToggleSecondaryFilters()
    {
        if (IsDisabled)
        {
            return;
        }

        isExpanded = !isExpanded;
    }

    private Task HandleSearchInput(ChangeEventArgs args) => SearchChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task HandleTypeChanged(ChangeEventArgs args) => TypeFilterChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task HandleTagChanged(ChangeEventArgs args) => TagFilterChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task HandleStartDateChanged(ChangeEventArgs args) => StartDateChanged.InvokeAsync(ParseDate(args.Value));
    private Task HandleEndDateChanged(ChangeEventArgs args) => EndDateChanged.InvokeAsync(ParseDate(args.Value));
    private Task HandleSortChanged(ChangeEventArgs args) => SortChanged.InvokeAsync(args.Value?.ToString() ?? "date-desc");

    private static string FormatDate(DateOnly? value) => value?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

    private static DateOnly? ParseDate(object? value) =>
        DateOnly.TryParseExact(value?.ToString(), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date)
            ? date
            : null;
}
