@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["ErrorTitle"]</PageTitle>

<h1 class="text-danger">@Localizer["ErrorTitle"]</h1>
<h2 class="text-danger">@Localizer["ErrorMessage"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Localizer["ErrorRequestIdLabel"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Localizer["ErrorDevelopmentModeTitle"]</h3>
<p>@Localizer["ErrorDevelopmentModeDescription"]</p>
<p><strong>@Localizer["ErrorDevelopmentModeWarning"]</strong></p>
<p>@Localizer["ErrorDevelopmentModeInstructions", "ASPNETCORE_ENVIRONMENT", "Development"]</p>

@code
{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = System.Diagnostics.Activity.Current?.Id
        ?? HttpContext?.TraceIdentifier;
    }
}
