{
  "AllowedHosts": "",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Components.Server.Circuits": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "BeeDay": {
    "Persistence": {
      "SqlServer": {
        "ConnectionString": ""
      }
    },
    "Hosting": {
      "DataProtectionKeysDirectory": "C:\\Apps\\BeeDay-Data\\DataProtection-Keys",
      "ForwardedHeaders": {
        "Enabled": true,
        "ForwardLimit": 1,
        "KnownProxies": [
          "127.0.0.1",
          "::1"
        ],
        "KnownNetworks": []
      }
    },
    "Auditing": {
      "EventJournal": {
        "Directory": "C:\\Apps\\BeeDay-Data\\Data",
        "FileName": "BeeDayEvents.ndjson"
      }
    },
    "IdentityEmail": {
      "PublicBaseUrl": "",
      "ConfirmationPath": "/account/confirm-email",
      "PasswordResetPath": "/account/reset-password"
    },
    "Email": {
      "Resend": {
        "Enabled": true,
        "ApiKey": "",
        "FromName": "beeday",
        "FromAddress": ""
      },
      "Development": {
        "Enabled": false,
        "Directory": "C:\\Apps\\BeeDay-Data\\Emails"
      },
      "HmgRecipientGuard": {
        "Enabled": false
      }
    }
  }
}
