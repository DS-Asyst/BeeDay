{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "BeeDay": {
    "Persistence": {
      "SqlServer": {
        "ConnectionString": ""
      }
    },
    "Auditing": {
      "EventJournal": {
        "Directory": "Data",
        "FileName": "BeeDayEvents.ndjson"
      }
    },
    "IdentityEmail": {
      "PublicBaseUrl": "",
      "ConfirmationPath": "/account/confirm-email",
      "PasswordResetPath": "/account/reset-password"
    },
    "Email": {
      "Resend": {
        "Enabled": false,
        "ApiKey": "",
        "FromName": "beeday",
        "FromAddress": ""
      },
      "Development": {
        "Enabled": true,
        "Directory": "Data/Emails"
      }
    }
  }
}
